{"parentUuid":"d65e928d-d5bd-4397-a04c-5f983e4cb364","isSidechain":false,"promptId":"685f154d-2c06-412a-b821-c55327f3d5ff","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BXySscqzr88TdxcpskGv3L","type":"tool_result","content":"OPEN MERGEABLE\nMERGED\ne46babe Merge pull request #10 from Sairanyx/viktor/demo-fixes\nhas-demo-fixes\n        self.sample_assets = (\n            sample_assets\n            if sample_assets is not None\n            else load_sample_assets(\"fixtures/copilot_assets.json\")\n        )\n        self.mapping = mapping if mapping is not None else load_mapping(\"fixtures/mapping.json\")\n        self.focused_asset_tag: str | None = None\n        self.focused_object_id: str | None = None\n\n    def set_focus(self, tag_or_object_id: str) -> None:\n        \"\"\"Set the active equipment focus (e.g. when user taps a 3D box).\"\"\"\n        clean = tag_or_object_id.strip()\n        # Check if it's an object_id\n        if clean in self.mapping:\n            self.focused_object_id = clean\n            self.focused_asset_tag = self.mapping[clean].get(\"tag\")\n            return\n\n        # Check by tag or asset_id\n        asset = self.store.get_asset(clean)\ndef verify_citations(\n    claimed_citations: list[str], valid_evidence_ids: set[str]\n) -> CitationValidationResult:\n    \"\"\"Verify claimed citations against the set of IDs actually fetched by tools.\n\n    Enforces DOC-RAG-GUIDE: rejects or flags IDs that were not returned by tools.\n    \"\"\"\n    verified: list[str] = []\n    unverified: list[str] = []\n\n    for cit in claimed_citations:\n        clean_cit = cit.strip()\n        if clean_cit in valid_evidence_ids:\n            verified.append(clean_cit)\n        else:\n            unverified.append(clean_cit)\n\n    return CitationValidationResult(\n        verified_citations=verified,\n        unverified_citations=unverified,\n        all_grounded=len(unverified) == 0,\n    )\n\n\ndef compute_composite_confidence(\n    model_confidence: float = 1.0,\n    mapping_confidence: float = 1.0,\n    data_quality_issues: list[dict[str, Any]] | None = None,\n) -> float:\n    \"\"\"Calculate composite confidence taking into account model, mapping, and data quality.\n\n    Enforces DOC-3D-MAPPING and DOC-RAG-GUIDE.\n    \"\"\"\n    conf = model_confidence * mapping_confidence\n    if data_quality_issues:\n        for issue in data_quality_issues:\n            sev = issue.get(\"severity\", \"low\").lower()\n            if sev == \"high\":\n                conf *= 0.85\n            elif sev == \"medium\":\n                conf *= 0.93\n            elif sev == \"low\":\n                conf *= 0.98\n\n1:\"\"\"Backend API for the viewer and copilot.\n3:The copilot needs the Excel pack in data/, and returns a marked placeholder without it.\n18:from app.api.copilot_link import ask, condition, details, load_engine\n59:    engine=None,\n62:    engine = engine or load_engine()\n68:    app = FastAPI(title=\"Field-service copilot API\")\n81:        return {**asset, \"condition\": condition(asset, engine.store) if engine else None}\n92:            \"copilot\": engine is not None,\n109:        if engine:\n110:            found = {**asset, **details(asset, engine.store)}\n159:    @app.post(\"/api/copilot/query\")\n160:    def copilot(request: CopilotRequest) -> dict:\n12:import argparse\n13:import json\n14:import re\n15:import time\n16:from dataclasses import dataclass\n17:from pathlib import Path\n19:import numpy as np\n20:from PIL import Image\n171:class VisionLabeler:\n172-    \"\"\"Runs a local Hugging Face image-text-to-text model, loaded with no network access.\"\"\"\n173-\n174-    def __init__(self, model_path: str) -> None:\n175-        import torch\n176-        from transformers import AutoModelForImageTextToText, AutoProcessor\n177-\n178-        self.torch = torch\n179-        self.processor = AutoProcessor.from_pretrained(model_path, local_files_only=True)\n180-        self.model = AutoModelForImageTextToText.from_pretrained(\n181-            model_path, dtype=\"auto\", device_map=\"cuda\", local_files_only=True\n182-        ).eval()\n183-\n184-    def label(\n185-        self, crop: Image.Image | list[Image.Image], prompt: str = PROMPT\n186-    ) -> tuple[dict, str]:\n187-        \"\"\"Return the parsed answer and the model's raw reply, for one or more views.\"\"\"\n188-        crops = crop if isinstance(crop, list) else [crop]\n189-        images = [{\"type\": \"image\", \"image\": item} for item in crops]\n190-        messages = [{\"role\": \"user\", \"content\": [*images, {\"type\": \"text\", \"text\": prompt}]}]\n191-        inputs = self.processor.apply_chat_template(\n192-            messages,\n193-            tokenize=True,\n194-            add_generation_prompt=True,\n195-            return_dict=True,\n196-            return_tensors=\"pt\",\n197-            enable_thinking=False,\n198-        ).to(self.model.device)\n199-        with self.torch.inference_mode():\n200-            output = self.model.generate(**inputs, max_new_tokens=120, do_sample=False)\n201-        reply = self.processor.batch_decode(\n202-            output[:, inputs[\"input_ids\"].shape[1] :], skip_special_tokens=True\n203-        )[0]","is_error":false}]},"uuid":"63f42478-1fd4-478e-b867-91666621da5c","timestamp":"2026-11-07T04:50:16.537Z","toolUseResult":{"stdout":"OPEN MERGEABLE\nMERGED\ne46babe Merge pull request #10 from Sairanyx/viktor/demo-fixes\nhas-demo-fixes\n        self.sample_assets = (\n            sample_assets\n            if sample_assets is not None\n            else load_sample_assets(\"fixtures/copilot_assets.json\")\n        )\n        self.mapping = mapping if mapping is not None else load_mapping(\"fixtures/mapping.json\")\n        self.focused_asset_tag: str | None = None\n        self.focused_object_id: str | None = None\n\n    def set_focus(self, tag_or_object_id: str) -> None:\n        \"\"\"Set the active equipment focus (e.g. when user taps a 3D box).\"\"\"\n        clean = tag_or_object_id.strip()\n        # Check if it's an object_id\n        if clean in self.mapping:\n            self.focused_object_id = clean\n            self.focused_asset_tag = self.mapping[clean].get(\"tag\")\n            return\n\n        # Check by tag or asset_id\n        asset = self.store.get_asset(clean)\ndef verify_citations(\n    claimed_citations: list[str], valid_evidence_ids: set[str]\n) -> CitationValidationResult:\n    \"\"\"Verify claimed citations against the set of IDs actually fetched by tools.\n\n    Enforces DOC-RAG-GUIDE: rejects or flags IDs that were not returned by tools.\n    \"\"\"\n    verified: list[str] = []\n    unverified: list[str] = []\n\n    for cit in claimed_citations:\n        clean_cit = cit.strip()\n        if clean_cit in valid_evidence_ids:\n            verified.append(clean_cit)\n        else:\n            unverified.append(clean_cit)\n\n    return CitationValidationResult(\n        verified_citations=verified,\n        unverified_citations=unverified,\n        all_grounded=len(unverified) == 0,\n    )\n\n\ndef compute_composite_confidence(\n    model_confidence: float = 1.0,\n    mapping_confidence: float = 1.0,\n    data_quality_issues: list[dict[str, Any]] | None = None,\n) -> float:\n    \"\"\"Calculate composite confidence taking into account model, mapping, and data quality.\n\n    Enforces DOC-3D-MAPPING and DOC-RAG-GUIDE.\n    \"\"\"\n    conf = model_confidence * mapping_confidence\n    if data_quality_issues:\n        for issue in data_quality_issues:\n            sev = issue.get(\"severity\", \"low\").lower()\n            if sev == \"high\":\n                conf *= 0.85\n            elif sev == \"medium\":\n                conf *= 0.93\n            elif sev == \"low\":\n                conf *= 0.98\n\n1:\"\"\"Backend API for the viewer and copilot.\n3:The copilot needs the Excel pack in data/, and returns a marked placeholder without it.\n18:from app.api.copilot_link import ask