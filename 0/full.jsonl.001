abel>\n''','''    <label>Can it move? <select id=\"add-mobility\"></select></label>\n    <div id=\"add-rest\" hidden>\n      <h3>The rest</h3>\n      <label>Type <select id=\"add-rest-label\"></select></label>\n      <label>Can it move? <select id=\"add-rest-mobility\"></select></label>\n    </div>\n''')\nt=t.replace('''    <button id=\"route-here\" hidden>Route here</button>\n''','''    <button id=\"route-here\" hidden>Route here</button>\n    <button id=\"split-object\" hidden>Split into two</button>\n''')\nopen(p,'w').write(t)\np='web/style.css'; t=open(p).read().rstrip('\\n')+'''\n\n#add-rest[hidden] {\n  display: none;\n}\n#add-rest h3 {\n  margin: 10px 0 0;\n  color: #38bdf8;\n  font-size: 13px;\n}\n'''\nopen(p,'w').write(t)\n\np='web/main.js'; t=open(p).read()\n# Solid faces that hide what's behind each frame.\nt=t.replace('''  const box = new THREE.LineSegments(\n    new THREE.EdgesGeometry(geom),\n    new THREE.LineBasicMaterial({ color: COLORS[kind(asset)] }),\n  );\n  box.position.copy(mid);\n  root.add(box);\n''','''  // Frames are drawn after the scan, so splats can't dim them. The invisible faces come first, and\n  // hide lines behind them: a frame's own back edges, and any frame further away.\n  const box = new THREE.LineSegments(\n    new THREE.EdgesGeometry(geom),\n    new THREE.LineBasicMaterial({ color: COLORS[kind(asset)], transparent: true }),\n  );\n  box.renderOrder = FRAME_ORDER + 1;\n  box.position.copy(mid);\n  const faces = new THREE.Mesh(geom, FRAME_FACES);\n  faces.renderOrder = FRAME_ORDER;\n  box.add(faces);\n  root.add(box);\n''')\nt=t.replace('''function resize() {''','''const FRAME_ORDER = 5;\nconst FRAME_FACES = new THREE.MeshBasicMaterial({\n  colorWrite: false,\n  transparent: true, // Drawn with the scan's pass, after it, so it can't punch holes in the scan.\n  polygonOffset: true, // Slightly behind a frame's own lines, so that they still show.\n  polygonOffsetFactor: 1,\n  polygonOffsetUnits: 1,\n});\n\nfunction resize() {'''