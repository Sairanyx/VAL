'))}\")\n    pg.click(\"#go-fault\"); pg.wait_for_function(\"window.plantViewer.route.state.route!==null\", timeout=30000); pg.wait_for_timeout(1500); print(\"after route:\", pg.inner_text(\"#status\")[:110]); print(\"BIM props:\", pg.inner_text(\"#bim-props\")[:260].replace(\"\\n\", \" | \"))\n    pg.screenshot(path=O + \"bim_top_route.png\", timeout=120000)\n    pg.evaluate(\"()=>{const c=window.plantViewer.camera;c.position.set(1.2,1.6,1.8);c.rotation.set(0,0.3,0,'YXZ')}\"); pg.wait_for_timeout(1500); pg.screenshot(path=O + \"bim_eye.png\", timeout=120000)\n    with pg.expect_download(timeout=30000) as d: pg.click(\"#bim-download\")\n    d.value.save_as(O + \"dl.ifc\"); print(\"download:\", d.value.suggested_filename, open(O + \"dl.ifc\").read(13))\n    print(\"errors:\", errs); b.close()\nEOF\ncd \"$S/sasha_bim\"; SCENE_PLY=\"$R/Equipment Room.ply\" SCENE_ASSETS=\"$T/assets_mapped.json\" SCENE_GRID=\"$T/nav_grid.npz\" nohup uv run --no-project --with numpy --with scipy --with fastapi --with uvicorn --with pydantic --with openpyxl --with pandas --with pillow --with 'psycopg[binary]' uvicorn app.api.main:app --port 8001 > \"$S/bim_check/api.log\" 2>&1 &\ncd \"$S/sasha_bim\"; nohup python3 web/serve.py --scene \"$T/light_400k.ply\" --assets \"$T/assets_mapped.json\" --shapes \"$T/shapes.json\" --bim \"$S/sasha_out\" --port 8124 --host 127.0.0.1 > \"$S/bim_check/web.log\" 2>&1 &\nfor i in $(seq 60); do curl -sf -o /dev/null http://127.0.0.1:8001/docs && curl -sf -o /dev/null http://127.0.0.1:8124/ && { echo \"servers up after ${i}s\"; break; }; sleep 1; done\ncd \"$S\"; timeout 300 uv run --no-project --with playwright python \"$S/bim_check/view_bim.py\" \"$S\" 2>&1 | grep -v \"^Installed\\|^Resolved\\|^Prepared\\|^Downloading\\|^  \" | tail -9 | cut -c1-330\nfuser -k 8124/tcp 8001/tcp >/dev/null 2>&1; true","description":"Run Sasha's BIM mode in a headless browser and take screenshots","timeout":420000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"t