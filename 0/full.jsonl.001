for that grade.\"\"\"\n    sam = SAM_TO_QWEN.get(sam_label, sam_label)\n    if qwen_label in (\"\", \"unknown\"):\n        return \"unknown\", \"unknown\", \"the vision model couldn't tell\"\n    problem = geometry_problem(qwen_label, measures, room_top)\n    if problem:\n        return qwen_label, \"unsure\", problem\n    if qwen_label == sam:\n        return qwen_label, \"likely\", \"SAM and the vision model agree\"\n    return qwen_label, \"unsure\", f\"SAM said {sam_label or 'nothing'}\"\n\n\ndef decide_mobility(\n    label: str,\n    grade: str,\n    measures: dict,\n    floor: float,\n    room_top: float,\n    touches_wall: bool,\n18:FIXED_LABELS = {\n19-    \"pipe\",\n20-    \"pipe fitting\",\n21-    \"tank\",\n22-    \"pump\",\n23-    \"valve\",\n24-    \"motor\",\n--\n35:MOVABLE_LABELS = {\"cart\", \"ladder\", \"box\", \"bucket\", \"barrel\", \"chair\", \"tool\", \"bag\"}\n36-SAM_TO_QWEN = {\"cabinet\": \"electrical cabinet\"}\n37-TRUSTED_GRADES = {\"verified\", \"ai_reviewed\", \"likely\"}\n38-\n39-\n40-def box_measures(asset: dict, up: np.ndarray) -> dict:\n41-    \"\"\"Return height along `up`, and the longest and shortest box sides, in metres.\"\"\"\n--\n86:def decide_mobility(\n87-    label: str,\n88-    grade: str,\n89-    measures: dict,\n90-    floor: float,\n91-    room_top: float,\n92-    touches_wall: bool,\n--\n97:    if label in FIXED_LABELS:\n98-        return \"fixed\", f\"{label} is fixed equipment\"\n99:    if label not in MOVABLE_LABELS:\n100-        return \"unsure\", f\"no rule for {label}\"\n22:LABELS = (\n23-    \"pump\",\n24-    \"valve\",\n25-    \"motor\",\n26-    \"pipe\",\n27-    \"pipe fitting\",\n28-    \"tank\",\n29-    \"gauge\",\n30-    \"sensor\",\n31-    \"electrical cabinet\",\n32-    \"control panel\",\n\ndef create_app(\n    assets_path: Path | str | None = None,\n    grid: NavGrid | Path | str | None = None,\n    engine=None,\n    database=None,\n) -> FastAPI:\n    engine = engine or load_engine()\n    writer = load_writer() if engine else None\n    database = database or open_database()\n    store = SceneStore(Path(assets_path or os.getenv(\"SCENE_ASSETS\", DEFAULT_ASSETS)), dat\n    grid = grid or os.getenv(\"SCENE_GRID\")\n    if isinstance(grid, str | Path):\n        grid = load_grid(Path(grid))\n    app = FastAPI(title=\"Field-service copilot API\")","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"f468fd5b-19ba-4b01-a652-e8d3b47a6583","context":{"git_state":{"cwd":"/home/viktor-trilar/Projects/Newbies","root":"/home/viktor-trilar/Projects/Newbies","branch":"viktor/moving-splats","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"},"push_remote":null,"remotes":[{"name":"origin","host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"}]}},"live_cwd":"/home/viktor-trilar/Projects/Newbies","platform":"linux"}},"sandboxed":false,"sourceToolAssistantUUID":"7c33b039-81fc-4c81-bd0c-8cc04c1195a5","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-vscode","cwd":"/home/viktor-trilar/Projects/Newbies","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","version":"2.1.319","gitBranch":"viktor/moving-splats","slug":"vast-jumping-lobster"}
