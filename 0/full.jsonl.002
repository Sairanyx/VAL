\n    for (const mesh of [item.scan, item.box].filter(Boolean)) {\n      shift.copy(mesh.userData.home).sub(offset).applyQuaternion(spin);\n      mesh.position.copy(owner.center).add(shift);\n''')])\nresolve(\"web/main.js\", [lambda m: \"\"])\npatch(\"web/main.js\", [\n('''let hoverAt = null;\ncanvas.addEventListener(\"pointermove\", (e) => {\n  const free = e.pointerType === \"mouse\" && e.buttons === 0;\n  hoverAt = free ? { x: e.clientX, y: e.clientY } : null;\n});\ncanvas.addEventListener(\"pointerleave\", () => (hoverAt = null));\nlet hovering = false;\n''', '''let hoverAt = null;\nlet hoverChanged = false;\ncanvas.addEventListener(\"pointermove\", (e) => {\n  const free = e.pointerType === \"mouse\" && e.buttons === 0;\n  hoverAt = free ? { x: e.clientX, y: e.clientY } : null;\n  hoverChanged = true;\n});\ncanvas.addEventListener(\"pointerleave\", () => {\n  hoverAt = null;\n  hoverChanged = true;\n});\nlet hovering = false;\nlet lastHovered = null;\nlet lastHoverCheck = 0;\nconst HOVER_EVERY = 100; // milliseconds, when the view moves under a still mouse\n'''),\n('''  hovering = Boolean(found);\n  canvas.style.cursor = found ? \"pointer\" : \"\";\n''', '''  hovering = Boolean(found);\n  canvas.style.cursor = found ? \"pointer\" : \"\";\n  // The outline needs drawing, even while nothing else is being redrawn.\n  if (found !== lastHovered) pacing.wake();\n  lastHovered = found;\n'''),\n('''  if (walk && !tracked) camera.position.y = eyeY;\n  if (!pacing.shouldDraw(now)) return;\n''', '''  if (walk && !tracked) camera.position.y = eyeY;\n  if (hoverChanged || (hoverAt && now - lastHoverCheck > HOVER_EVERY && pacing.isMoving())) {\n    hoverChanged = false;\n    lastHoverCheck = now;\n    if (!plan?.state.open) updateHover();\n  }\n  if (!pacing.shouldDraw(now)) return;\n'''),\n])\npatch(\"web/pacing.js\", [('''  return { stats, wake, shouldDraw, drew };''', '''  return { stats, wake, shouldDraw, drew, isMoving: () => moving };''')])\nEOF\ngit add docs/USAGE.md 