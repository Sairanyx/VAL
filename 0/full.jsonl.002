arch {\n  flex: 1;\n  min-width: 160px;\n  min-height: 44px;\n  padding: 0 10px;\n  border: 1px solid #3a4652;\n  border-radius: 6px;\n  background: #0f1419;\n  color: #e5e7eb;\n  font-size: 16px;\n}\n#plan-dxf {\n  display: inline-flex;\n  align-items: center;\n  min-height: 44px;\n  padding: 0 14px;\n  border: 1px solid #3a4652;\n  border-radius: 6px;\n  color: #e5e7eb;\n  text-decoration: none;\n}\n#plan-canvas {\n  flex: 1;\n  width: 100%;\n  min-height: 0;\n  touch-action: manipulation;\n}\n#plan-foot {\n  padding: 6px 12px 10px;\n  font-size: 12px;\n  color: #9ca3af;\n}\n#plan-legend {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px 12px;\n  margin-bottom: 4px;\n}\n#plan-legend i {\n  display: inline-block;\n  width: 10px;\n  height: 10px;\n  margin-right: 4px;\n  border-radius: 2px;\n}\n'''\nopen(p,'w').write(t)\np='web/main.js'; t=open(p).read()\nt=t.replace('''import { setupPhone } from \"./phone.js\";\n''','''import { setupPhone } from \"./phone.js\";\nimport { setupPlan } from \"./plan.js\";\n''')\nt=t.replace('''  renderer.render(scene, camera);\n  updateLabels();\n''','''  if (plan?.state.open) {\n    plan.draw(); // The room is covered, so there's no need to draw it as well.\n  } else {\n    renderer.render(scene, camera);\n    updateLabels();\n  }\n''')\nt=t.replace('''let route = null;\n''','''let route = null;\nlet plan = null;\n''',1)\nt=t.replace('''  $(\"go-fault\").hidden = !objects.some((o) => kind(o.asset) === \"fault\");\n''','''  $(\"go-fault\").hidden = !objects.some((o) => kind(o.asset) === \"fault\");\n  plan = setupPlan({\n    ui: {\n      panel: $(\"plan\"),\n      canvas: $(\"plan-canvas\"),\n      search: $(\"plan-search\"),\n      pipes: $(\"plan-pipes\"),\n      legend: $(\"plan-legend\"),\n      note: $(\"plan-note\"),\n    },\n    objects,\n    root,\n    camera,\n    route,\n    getFaultTag: () => faultTag,\n    getSelected: () => selected,\n    onSelect: showInfo,\n  });\n  $(\"open-plan\").onclick = () => plan.open();\n  $(\"plan-close\").onclick = () => plan.close();\n''')\nt=t.replace(\"window.plantViewer = { objects, objectLayer, camera, route, copilot, showInfo, adder };\",\"window.plantViewer = { objects, objectLayer, camera, route, copilot, showInfo, adder, plan };\")\nopen(p,'w').write(t)\np='docs/USAGE.md'; t=open(p).read()\nt=t.replace('''## Ask the copilot\n''','''## See the floor layout\nPress **Plan** for the room from above: walls, objects by type, the route, and an arrow showing where you are.\n- **Find:** type a tag or type, such as `P-005` or `tank`.\n- **Tap an object** to open its panel, then use **Route here**.\n- **Show pipes** adds pipes, which are hidden to keep it readable.\n- **Download DXF** saves the layout for CAD tools, with objects where they stand now.\n\n`make bim` writes an IFC model of the walls and objects for BIM tools, with each object's label and link in its\nproperties. Both are generated from the scan, not surveyed. Objects are boxes, and the scale hasn't been checked\non site. Without good evidence for a label, an object stays generic in the IFC. Needs `make api` and\n`Equipment Room.ply`.\n\n## Ask the copilot\n''',1)\nt=t.replace('''| **Range** | How far away''','''| **Plan** | Shows the floor layout from above |\n| **Range** | How far away''')\nopen(p,'w').write(t)\np='README.md'; t=open(p).read()\nt=t.replace(\"| `make pipeline` |\",\"| `make bim` | Write a review IFC model of the objects and walls |\\n| `make pipeline` |\",1)\nopen(p,'w').write(t)\nEOF\ngrep -n \"route = setupRoute\" web/main.js | cut -c1-50; grep -n \"plan = setupPlan\" web/main.js | cut -c1-40; T=\"$S/make_test\"; mkdir -p \"$S/bim\"; PYTHONPATH=. uv run --no-project --with numpy --with scipy --with pillow --with ifcopenshell python -m app.plan.export_ifc \"Equipment Room.ply\" \"$T/assets_mapped.json\" \"$S/bim/equipment_room.ifc\" 2>&1 | tail -1 | cut -c1-110; ls -la \"$S/bim/\" | tail -1 | cut -c25-90; cat > \"$S/bim_check.py\" <<EOF\nimport ifcopenshell\nfrom collections import Counter\nm=ifcopenshell.open(\"$S/bim/equipment_room.ifc\"); print(m.schema,Counter(e.is_a() for e in m.by_type('IfcElement')).most_common(14))\nprint('storey',[s.Name for s in m.by_type('IfcBuildingStorey')],'project',m.by_type('IfcProject')[0].Description[:60])\nf=[e for e in m.by_type('IfcElement') if e.Tag=='P-005']; print('P-005',f and (f[0].is_a(),f[0].Name))\nimport ifcopenshell.geom as g\ns=g.settings(); ok=bad=0\nfor e in m.by_type('IfcElement'):\n    try: g.create_shape(s,e); ok+=1\n    except Exception: bad+=1\nprint('geometry ok',ok,'failed',bad)\nEOF\nuv run --no-project --with ifcopenshell python \"$S/bim_check.py\" 2>&1 | tail -4 | cut -c1-300; cat > \"$S/plan_test.py\" <<'EOF'\nimport sys\nfrom playwright.sync_api import sync_playwright\nS=sys.argv[1]\nwith sync_playwright() as p:\n    b=p.chromium.launch(executable_path='/snap/bin/chromium',headless=True,args=['--no-sandbox','--use-angle=swiftshader','--enable-unsafe-swiftshader','--ignore-gpu-blocklist'])\n    pg=b.new_context(viewport={'width':1024,'height':700},accept_downloads=True).new_page(); errs=[]\n    pg.on('pageerror',lambda e: errs.append(str(e)[:220]))\n    pg.goto('http://127.0.0.1:8123/?lod=0&res=0.15'); pg.wait_for_function(\"window.plantViewer!==undefined\",timeout=240000); pg.wait_for_timeout(1500)\n    pg.click('#go-fault'); pg.wait_for_function(\"window.plantViewer.route.state.route!==null\",timeout=30000); pg.click('#open-plan'); pg.wait_for_function(\"window.plantViewer.plan.state.ready || /Couldn/.test(document.getElementById('plan-note').textContent)\",timeout=60000); pg.wait_for_timeout(1500); print('note',pg.inner_text('#plan-foot')[-90:].replace('\\n',' '))\n    pg.screenshot(path=S+'/plan_view.png',timeout=120000)\n    pg.fill('#plan-search','P-005'); pg.wait_for_timeout(600); print('search',pg.inner_text('#plan-note'),pg.evaluate(\"window.plantViewer.plan.state.found&&window.plantViewer.plan.state.found.asset.object_id\"))\n    pg.fill('#plan-search','tank'); pg.wait_for_timeout(400); print('search',pg.inner_text('#plan-note')); pg.fill('#plan-search','banana'); pg.wait_for_timeout(300); print('search',pg.inner_text('#plan-note')); pg.fill('#plan-search','')\n    pg.click('#plan-pipes'); pg.wait_for_timeout(800); pg.screenshot(path=S+'/plan_pipes.png',timeout=120000); pg.click('#plan-pipes')\n    with pg.expect_download(timeout=30000) as d: pg.click('#plan-dxf')\n    d.value.save_as(S+'/bim/floor_layout.dxf'); print('dxf',d.value.suggested_filename)\n    # Tap a footprint on the plan: the panel should open for it.\n    t=pg.evaluate(\"\"\"()=>{const v=window.plantViewer;const f=v.objects.find(x=>x.asset.mapping&&x.asset.mapping.tag==='P-005');const c=document.getElementById('plan-canvas').getBoundingClientRect();const d=v.plan.state.description;const scale=Math.min((c.width-32)/(d.x_max-d.x_min),(c.height-32)/(d.z_max-d.z_min));const left=(c.width-scale*(d.x_max-d.x_min))/2,top=(c.height-scale*(d.z_max-d.z_min))/2;return [c.left+left+(f.center.x-d.x_min)*scale,c.top+top+(d.z_max-f.center.z)*scale]}\"\"\")\n    pg.mouse.click(*t); pg.wait_for_timeout(600); print('tap panel',pg.evaluate(\"document.getElementById('info').hidden\"),pg.inner_text('#info-body')[:60].replace('\\n',' ')); print('z',pg.evaluate(\"getComputedStyle(document.getElementById('info')).zIndex\"))\n    pg.screenshot(path=S+'/plan_tap.png',timeout=120000); print('errors',errs); b.close()\nEOF\nSCENE_PLY=\"$PWD/Equipment Room.ply\" SCENE_ASSETS=\"$T/assets_mapped.json\" SCENE_GRID=\"$T/nav_grid.npz\" nohup uv run --no-project --with numpy --with scipy --with fastapi --with uvicorn --with pydantic --with openpyxl --with pandas --with pillow --with 'psycopg[binary]' uvicorn app.api.main:app --port 8001 > \"$S/api.log\" 2>&1 &\ncd /home/viktor-trilar/Projects/Newbies; S=/tmp/claude-1000/-home-viktor-trilar-Projects-Newbies/6293938d-e68f-4310-92b7-6bf722e3d028/scratchpad; T=\"$S/make_test\"; nohup python3 web/serve.py --scene \"$T/light_400k.ply\" --assets \"$T/