{"parentUuid":"dc9deef1-4f00-45f4-a44a-6234ebdc96d4","isSidechain":false,"promptId":"3b1f62eb-9e27-45a6-96d8-bf7f61c7cb20","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012XBrE9nADeJBz4nQWbX6SW","type":"tool_result","content":"viktor/viewer-and-val\n   475 web/addobject.js\n   479 web/bim.js\n    43 web/commands.js\n    91 web/copilot.js\n    75 web/highlight.js\n   953 web/main.js\n   591 web/objects.js\n   172 web/phone.js\n   341 web/plan.js\n   429 web/route.js\n   107 web/xr.js\n   143 web/index.html\n   564 web/style.css\n   162 web/serve.py\n   602 app/copilot/copilot.py\n   133 app/copilot/guardrails.py\n     1 app/copilot/__init__.py\n   311 app/copilot/llm.py\n   183 app/copilot/mapping.py\n   660 app/copilot/store.py\n   318 app/copilot/tools.py\n    95 app/api/copilot_link.py\n  6928 total\n=== index.html\n<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\n  <title>Plant Room Viewer</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <!-- Everything is served locally: the demo must run with no internet. -->\n  <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"three\": \"./vendor/three/three.module.js\",\n        \"three/addons/\": \"./vendor/three/addons/\",\n        \"@sparkjsdev/spark\": \"./vendor/spark/spark.module.js\"\n      }\n    }\n  </script>\n</head>\n<body>\n  <canvas id=\"view\"></canvas>\n  <div id=\"labels\"></div>\n  <div id=\"crosshair\"></div>\n\n  <div id=\"hud\">\n    <div id=\"status\">Loading scene...</div>\n    <div id=\"stats\"></div>\n    <div id=\"in-view\"></div>\n  </div>\n\n  <div id=\"joystick\" aria-label=\"Move\"><div></div></div>\n\n  <div id=\"buttons\">\n    <button id=\"go-fault\" hidden>Go to P-005</button>\n    <button id=\"open-copilot\">Copilot</button>\n    <button id=\"open-plan\">Plan</button>\n    <button id=\"add-object\">Add object</button>\n    <button id=\"follow\" hidden>Walk route</button>\n    <button id=\"clear-route\" hidden>Clear route</button>\n    <button id=\"profile\" hidden>Person</button>\n    <button id=\"track\" hidden>Track</button>\n    <button id=\"phone\">Phone</button>\n    <button id=\"mode\">Walk</button>\n    <button id=\"boxes\">Boxes on</button>\n    <button id=\"range\">Range 3 m</button>\n    <button id=\"reset\">Start</button>\n    <button id=\"view-mode\">Scan</button>\n    <button id=\"bim\" hidden>BIM</button>\n    <button id=\"apart\">Apart</button>\n    <button id=\"reset-moves\">Undo changes</button>\n  </div>\n\n  <div id=\"info\" hidden>\n    <button id=\"info-close\" aria-label=\"Close\">&times;</button>\n    <div id=\"info-body\"></div>\n    <p id=\"info-condition\"></p>\n    <button id=\"ask\" hidden>Ask copilot</button>\n    <button id=\"route-here\" hidden>Route here</button>\n    <button id=\"split-object\" hidden>Split into two</button>\n    <button id=\"combine-object\" hidden>Combine with...</button>\n    <div id=\"move-actions\" class=\"action-row\" hidden>\n      <button id=\"move\">Move on floor</button>\n      <button id=\"rotate\">Rotate on floor</button>\n    </div>\n    <p id=\"cant-move\" hidden></p>\n  </div>\n\n  <div id=\"manip-bar\" hidden>\n    <span id=\"manip-title\">Manipulate</span>\n    <button id=\"manip-mode-move\" class=\"active\">Move</button>\n    <button id=\"manip-mode-rotate\">Rotate</button>\n    <button id=\"manip-turn-left\" title=\"Turn 45° counter-clockwise\">↶ 45°</button>\n    <button id=\"manip-turn-right\" title=\"Turn 45° clockwise\">↷ 45°</button>\n    <button id=\"manip-done\">Done</button>\n  </div>\n\n  <div id=\"bim-panel\" hidden>\n    <h2>BIM model <small>simulated from the scan</small></h2>\n    <p class=\"bim-note\">Look: Real is each object's own scan, Mesh is a shape built from it, Box is a simple box or cyli\n    <div id=\"bim-classes\"></div>\n    <label class=\"bim-section\">Section <input id=\"bim-section\" type=\"range\" min=\"0.3\" max=\"2.6\" step=\"0.1\" value=\"2.6\"> \n    <div class=\"bim-actions\">\n      <button id=\"bim-look\" hidden>Look: Real</button>\n      <button id=\"bim-isolate\">Isolate</button>\n      <a id=\"bim-download\" href=\"model.ifc\" download=\"model.ifc\">Download IFC</a>\n    </div>\n    <div id=\"bim-props\"></div>\n  </div>\n\n  <div id=\"plan\" hidden>\n    <div id=\"plan-bar\">\n      <input id=\"plan-search\" placeholder=\"Find a tag or type, such as P-005\" autocomplete=\"off\">\n      <button id=\"plan-pipes\">Show pipes</button>\n      <a id=\"plan-dxf\" href=\"/api/plan/layout.dxf\" download=\"floor_layout.dxf\" hidden>Download DXF</a>\n      <button id=\"plan-close\">Close</button>\n    </div>\n    <canvas id=\"plan-canvas\"></canvas>\n    <div id=\"plan-foot\">\n      <div id=\"plan-legend\"></div>\n      <div><span id=\"plan-note\"></span> Generated from the scan, not surveyed.</div>\n    </div>\n  </div>\n\n  <div id=\"select-frame\" hidden></div>\n\n  <div id=\"add-panel\" hidden>\n    <h2 id=\"add-title\">Add object</h2>\n    <p id=\"add-warning\"></p>\n    <p id=\"add-notes\"></p>\n    <label>Type <select id=\"add-label\"></select></label>\n    <label>Can it move? <select id=\"add-mobility\"></select></label>\n    <div id=\"add-rest\" hidden>\n      <h3>The rest</h3>\n      <label>Type <select id=\"add-rest-label\"></select></label>\n      <label>Can it move? <select id=\"add-rest-mobility\"></select></label>\n    </div>\n    <div class=\"add-row\">\n      <button id=\"add-smaller\">Smaller</button>\n      <button id=\"add-bigger\">Bigger</button>\n    </div>\n    <details>\n      <summary>Config</summary>\n      <pre id=\"add-config\"></pre>\n    </details>\n    <div class=\"add-row\">\n      <button id=\"add-cancel\">Cancel</button>\n      <button id=\"add-save\">Save</button>\n    </div>\n  </div>\n\n  <div id=\"copilot\" hidden>\n    <button id=\"copilot-close\" aria-label=\"Close\">&times;</button>\n    <h2>Copilot</h2>\n    <form id=\"copilot-form\">\n      <input id=\"copilot-input\" placeholder=\"Ask about the selected object\" autocomplete=\"off\">\n      <button type=\"submit\">Ask</button>\n      <button type=\"button\" id=\"copilot-speak\">Voice on</button>\n    </form>\n    <div id=\"copilot-answer\"></div>\n  </div>\n\n  <script type=\"module\" src=\"main.js\"></script>\n</body>\n</html>\n=== main.js head\nconst MAX_BOXES = 15;\nconst BACKGROUND_LABELS = new Set([\"pipe\", \"pipe fitting\", \"cable\", \"hose\", \"object\"]);\n\n// Lighter defaults for tablets, until they're measured on the real Lenovo.\nconst TABLET_RES = 0.75;\nconst TABLET_SPLATS = 500000;\n\n// Speed settings, changeable in the URL without editing code, e.g. ?res=0.5&splats=300000\n//   res     render resolution relative to the screen (default 1; 0.5 is about 4x fewer pixels)\n//   lod     1 = level of detail on: far-away areas use fewer, bigger splats (default 1)\n//   splats  how many splats LOD aims to draw per frame (default: Spark's choice for the device)\nconst params = new URLSearchParams(location.search);\n//   tablet  1 or 0 forces the touch layout and lighter defaults. Default: on for touch screens\nconst TABLET = params.has(\"tablet\")\n  ? params.get(\"tablet\") === \"1\"\n  : window.matchMedia(\"(pointer: coarse)\").matches;\ndocument.body.classList.toggle(\"tablet\", TABLET);\nconst MAX_LABELS = TABLET ? 5 : 8;\nconst RES = Number(params.get(\"res\") ?? (TABLET ? TABLET_RES : 1));\nconst LOD = params.get(\"lod\") !== \"0\";\nconst LOD_SPLATS = params.has(\"splats\")\n  ? Number(params.get(\"splats\"))\n  : TABLET\n    ? TABLET_SPLATS\n    : undefined;\n// Tablet mode also loads the light scene (every splat, base colour only, about 4x smaller) when\n// the server offers one. ?scene=full or ?scene=light overrides the choice on any device.\nasync function pickScene() {\n  const wanted = params.get(\"scene\") ?? (TABLET ? \"light\" : \"full\");\n  if (wanted === \"light\") {\n    const head = await fetch(\"scene-light.ply\", { method: \"HEAD\" }).catch(() => null);\n    if (head?.ok) return { url: \"scene-light.ply\", label: \"light\" };\n  }\n  return { url: \"scene.ply\", label: \"full\" };\n}\n\nconst PANEL_CONTROLS = \"button, a, input, select, textarea, label, summary, form\";\nconst $ = (id) => document.getElementById(id);\nconst canvas = $(\"view\");\n\nconst renderer = new THREE.WebGLRenderer({ canvas, antialias: false });\n// Rendering every splat at full high-DPI resolution is the main cost; 1 pixel per CSS pixel is enough.\nrenderer.setPixelRatio(RES);\nconst scene = new THREE.Scene();\nconst camera = new THREE.PerspectiveCamera(70, 1, 0.05, 200);\nscene.add(new SparkRenderer({ renderer, lodSplatCount: LOD_SPLATS }));\n\n// Turn the scene upright once here, and put everything in scene coordinates inside `root`, so\n// file coordinates can be used as they are. Scenes name their up direction in the assets file.\nconst root = new THREE.Group();\nroot.rotation.x = Math.PI; // Equipment Room's +y points down, the default until the file loads.\n// Tracking (xr.js) moves the whole map through this group, so the device's real position lands\n// in the right place. Without tracking it stays at identity.\nconst xrOffset = new THREE.Group();\nscene.add(xrOffset);\nxrOffset.add(root);\n\nconst controls = new SparkControls({ canvas });\nconst phone = setupPhone({\n  camera,\n  button: $(\"phone\"),\n  joystick: $(\"joystick\"),\n  onMessage: (msg) => ($(\"status\").textContent = msg),\n});\nconst raycaster = new THREE.Raycaster();\nconst objects = []; // { asset, box, pick, label, center, yaw, baseSize }\n=== updateLabels + animate\nfunction updateLabels() {\n  const w = window.innerWidth;\n  const h = window.innerHeight;\n  const apart = objectLayer?.state.apart;\n  for (const o of objects) {\n    o.box.visible = false;\n    o.label.style.display = \"none\";\n  }\n\n  const nearby = [];\n  for (const o of objects) {\n    if (o.gone) continue;\n    pos.copy(o.center);\n    root.localToWorld(pos);\n    const dist = camera.position.distanceTo(pos);\n    if (dist > range) continue;\n    pos.project(camera);\n    const onScreen = pos.z > 0 && pos.z < 1 && Math.abs(pos.x) <= 1 && Math.abs(pos.y) <= 1;\n    // Fault and mapped objects show first, background labels last.\n    const rank =\n      kind(o.asset) === \"fault\" ? 0 : kind(o.asset) === \"mapped\" ? 1 : BACKGROUND_LABELS.has(o.asset.label) ? \n    nearby.push({\n      o,\n      dist,\n      rank,\n      onScreen,\n      x: ((pos.x + 1) / 2) * w,\n      y: ((-pos.y + 1) / 2) * h,\n      pinned: kind(o.asset) === \"fault\",\n    });\n  }\n\n  nearby.sort((a, b) => a.rank - b.rank || a.dist - b.dist);\n  const inView = nearby.filter((item) => item.onScreen);\n  if (boxesOn && !apart && !bim?.state.active) {\n    for (const { o } of inView.slice(0, MAX_BOXES)) {\n      if (!highlight.hasSurface(o)) o.box.visible = true;\n    }\n    for (const { o, pinned } of nearby) {\n      if (pinned && !highlight.hasSurface(o)) o.box.visible = true;\n    }\n  }\n  // A warning always shows, even past the limits or with boxes off.\n  for (const o of objects) if (o.warning && !o.gone) o.box.visible = true;\n  for (const item of inView) {\n    // Unconfirmed objects keep their frame, but don't crowd the view with a generic tag.\n    if (item.o.asset.status === \"new, unconfirmed\") continue;\n    if (inView.indexOf(item) >= MAX_LABELS && !item.pinned) continue;\n    const label = item.o.label;\n    label.textContent = name(item.o.asset);\n    label.style.left = `${item.x}px`;\n    label.style.top = `${item.y}px`;\n    label.style.display = \"block\";\n  }\n}\n\nlet lastTime = 0;\nlet frames = 0;\nlet lastFps = performance.now();\nfunction animate(now) {\n  const dt = lastTime ? (now - lastTime) / 1000 : 0;\n  lastTime = now;\n  const following = Boolean(route?.state.walking);\n  const busy = objectLayer?.state.moving || adder.state.active || following;\n  // Typing in the Plan screen's search box shouldn't walk the viewer around. While tracking, the\n  // device's own movement moves the camera, so the other controls stay out.\n  const tracked = tracking.state.active;\n  if (!phone.enabled && !busy && !tracked && !plan?.state.open) controls.update(camera);\n  objectLayer?.update(dt);\n  highlight.update();\n  bim?.update();\n  if (following && !tracked) route.update(dt);\n  else if (!tracked) phone.update(dt);\n  route?.animate(dt);\n  if (!following && !adder.state.active) {\n    const moving = objectLayer?.state.moving;\n    route?.updateLive(\n      moving?.dragging\n        ? {\n            object_id: moving.object.asset.object_id,\n            position: moving.object.center.toArray(),\n            yaw: moving.object.yaw || 0,\n          }\n        : null,\n      walk,\n    );\n  }\n  $(\"follow\").textContent = following ? \"Stop\" : \"Walk route\";\n  if (walk && !tracked) camera.position.y = eyeY;\n  if (plan?.state.open) {\n    plan.draw(); // The room is covered, so there's no need to draw it as well.\n  } else {\n    renderer.render(scene, camera);\n    tracking.update();\n    updateLabels();\n  }\n  frames++;\n  if (now - lastFps > 1000) {\n    const fps = Math.round((frames * 1000) / (now - lastFps));\n    $(\"stats\").textContent = `${fps} fps` + (phone.enabled ? ` · ${phone.steps} steps` : \"\");\n    frames = 0;\n    lastFps = now;\n  }\n}\n\n// The scene files only hold the original scan, and the backend holds what's changed since. Without\n// this, a reloaded page shows objects at their old spots while routes avoid their new ones.\nasync function syncWithBackend() {\n  let current;\n  try {\n    const response = await fetch(\"/api/assets\");\n    if (!response.ok) throw new Error(`error ${response.status}`);\n    current = (await response.json()).assets;\n  } catch {\n    $(\"status\").textContent = \"Backend not connected: start make api. Moves won't save, no routes.\";\n    return;","is_error":false}]},"uuid":"0d94d041-c1a8-4a33-9eca-99d8e060d9f3","timestamp":"2026-11-07T14:09:40.073Z","toolUseResult":{"stdout":"viktor/viewer-and-val\n   475 web/addobject.js\n   479 web/bim.js\n    43 web/commands.js\n    91 web/copilot.js\n    75 web/highlight.js\n   953 web/main.js\n   591 web/objects.js\n   172 web/phone.js\n   341 web/plan.js\n   429 web/route.js\n   107 web/xr.js\n   143 web/index.html\n   564 web/style.css\n   162 web/serve.py\n   602 app/copilot/copilot.py\n   133 app/copilot/guardrails.py\n     1 app/copilot/__init__.py\n   311 app/copilot/llm.py\n   183 app/copilot/mapping.py\n   660 app/copilot/store.py\n   318 app/copilot/tools.py\n    95 app/api/copilot_link.py\n  6928 total\n=== index.html\n<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\n  <title>Plant Room Viewer</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <!-- Everything is served locally: the demo must run with no internet. -->\n  <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"three\": \"./vendor/three/three.module.js\",\n        \"three/addons/\": \"./vendor/three/addons/\",\n        \"@sparkjsdev/spark\": \"./vendor/spark/spark.module.js\"\n      }\n    }\n  </script>\n</head>\n<body>\n  <canvas id=\"view\"></canvas>\n  <div id=\"labels\"></div>\n  <div id=\"crosshair\"></div>\n\n  <div id=\"hud\">\n    <div id=\"status\">Loading scene...</div>\n    <div id=\"stats\"></div>\n    <div id=\"in-view\"></div>\n  </div>\n\n  <div id=\"joystick\" aria-label=\"Move\"><div></div></div>\n\n  <div id=\"buttons\">\n    <button id=\"go-fault\" hidden>Go to P-005</button>\n    <button id=\"open-copilot\">Copilot</button>\n    <button id=\"open-plan\">Plan</button>\n    <button id=\"add-object\">Add object</button>\n    <button id=\"follow\" hidden>Walk route</button>\n    <button id=\"clear-route\" hidden>Clear route</button>\n    <button id=\"profile\" hidden>Person</button>\n    <button id=\"track\" hidden>Track</button>\n    <button id=\"phone\">Phone</button>\n    <button id=\"mode\">Walk</button>\n    <button id=\"boxes\">Boxes on</button>\n    <button id=\"range\">Range 3 m</button>\n    <button id=\"reset\">Start</button>\n    <button id=\"view-mode\">Scan</button>\n    <button id=\"bim\" hidden>BIM</button>\n    <button id=\"apart\">Apart</button>\n    <button id=\"reset-moves\">Undo changes</button>\n  </div>\n\n  <div id=\"info\" hidden>\n    <button id=\"info-close\" aria-label=\"Close\">&times;</button>\n    <div id=\"info-body\"></div>\n    <p id=\"info-condition\"></p>\n    <button id=\"ask\" hidden>Ask copilot</button>\n    <button id=\"route-here\" hidden>Route here</button>\n    <button id=\"split-object\" hidden>Split into two</button>\n    <button id=\"combine-object\" hidden>Combine with...</button>\n    <div id=\"move-actions\" class=\"action-row\" hidden>\n      <button id=\"move\">Move on floor</button>\n      <button id=\"rotate\">Rotate on floor</button>\n    </div>\n    <p id=\"cant-move\" hidden></p>\n  </div>\n\n  <div id=\"manip-bar\" hidden>\n    <span id=\"manip-title\">Manipulate</span>\n    <button id=\"manip-mode-move\" class=\"active\">Move</button>\n    <button id=\"manip-mode-rotate\">Rotate</button>\n    <button id=\"manip-turn-left\" title=\"Turn 45° counter-clockwise\">↶ 45°</button>\n    <button id=\"manip-turn-right\" title=\"Turn 45° clockwise\">↷ 45°</button>\n    <button id=\"manip-done\">Done</button>\n  </div>\n\n  <div id=\"bim-panel\" hidden>\n    <h2>BIM model <small>simulated from the scan</small></h2>\n    <p class=\"bim-note\">Look: Real is each object's own scan, Mesh is a shape built from it, Box is a simple box or cyli\n    <div id=\"bim-classes\"></div>\n    <label class=\"bim-section\">Section <input id=\"bim-section\" type=\"range\" min=\"0.3\" max=\"2.6\" step=\"0.1\" value=\"2.6\"> \n    <div class=\"bim-actions\">\n      <button id=\"bim-look\" hidden>Look: Real</button>\n      <button id=\"bim-isolate\">Isolate</button>\n      <a id=\"bim-download\" href=\"model.ifc\" download=\"model.ifc\">Download IFC</a>\n    </div>\n    <div id=\"bim-props\"></div>\n  </div>\n\n  <div id=\"plan\" hidden>\n    <div id=\"plan-bar\">\n      <input id=\"plan-search\" placeholder=\"Find a tag or type, such as P-005\" autocomplete=\"off\">\n      <button id=\"plan-pipes\">Show pipes</button>\n      <a id=\"plan-dxf\" href=\"/api/plan/layout.dxf\" download=\"floor_layout.dxf\" hidden>Download DXF</a>\n      <button id=\"plan-close\">Close</button>\n    </div>\n    <canvas id=\"plan-canvas\"></canvas>\n    <div id=\"plan-foot\">\n      <div id=\"plan-legend\"></div>\n      <div><span id=\"plan-note\"></span> Generated from the scan, not surveyed.</div>\n    </div>\n  </div>\n\n  <div id=\"select-frame\" hidden></div>\n\n  <div id=\"add-panel\" hidden>\n    <h2 id=\"add-title\">Add object</h2>\n    <p id=\"add-warning\"></p>\n    <p id=\"add-notes\"></p>\n    <label>Type <select id=\"add-label\"></select></label>\n    <label>Can it move? <select id=\"add-mobility\"></select></label>\n    <div id=\"add-rest\" hidden>\n      <h3>The rest</h3>\n      <label>Type <select id=\"add-rest-label\"></select></label>\n      <label>Can it move? <select id=\"add-rest-mobility\"></select></label>\n    </div>\n    <div class=\"add-row\">\n      <button id=\"add-smaller\">Smaller</button>\n      <button id=\"add-bigger\">Bigger</button>\n    </div>\n    <details>\n      <summary>Config</summary>\n      <pre id=\"add-config\"></pre>\n    </details>\n    <div class=\"add-row\">\n      <button id=\"add-cancel\">Cancel</button>\n      <button id=\"add-save\">Save</button>\n    </div>\n  </div>\n\n  <div id=\"copilot\" hidden>\n    <button id=\"copilot-close\" aria-label=\"Close\">&times;</button>\n    <h2>Copilot</h2>\n    <form id=\"copilot-form\">\n      <input id=\"copilot-input\" placeholder=\"Ask about the selected object\" autocomplete=\"off\">\n      <button type=\"submit\">Ask</button>\n      <button type=\"button\" id=\"copilot-speak\">Voice on</button>\n    </form>\n    <div id=\"copilot-answer\"></div>\n  </div>\n\n  <script type=\"module\" src=\"main.js\"></script>\n</body>\n</html>\n=== main.js head\nconst MAX_BOXES = 15;\nconst BACKGROUND_LABELS = new Set([\"pipe\", \"pipe fitting\", \"cable\", \"hose\", \"object\"]);\n\n// Lighter defaults for tablets, until they're measured on the real Lenovo.\nconst TABLET_RES = 0.75;\nconst TABLET_SPLATS = 500000;\n\n// Speed settings, changeable in the URL without editing code, e.g. ?res=0.5&splats=300000\n//   res     render resolution relative to the screen (default 1; 0.5 is about 4x fewer pixels)\n//   lod     1 = level of detail on: far-away areas use fewer, bigger splats (default 1)\n//   splats  how many splats LOD aims to draw per frame (default: Spark's choice for the device)\nconst params = new URLSearchParams(location.search);\n//   tablet  1 or 0 forces the touch layout and lighter defaults. Default: on for touch screens\nconst TABLET = params.has(\"tablet\")\n  ? params.get(\"tablet\") === \"1\"\n  : window.matchMedia(\"(pointer: coarse)\").matches;\ndocument.body.classList.toggle(\"tablet\", TABLET);\nconst MAX_LABELS = TABLET ? 5 : 8;\nconst RES = Number(params.get(\"res\") ?? (TABLET ? TABLET_RES : 1));\nconst LOD = params.get(\"lod\") !== \"0\";\nconst LOD_SPLATS = params.has(\"splats\")\n  ? Number(params.get(\"splats\"))\n  : TABLET\n    ? TABLET_SPLATS\n    : undefined;\n// Tablet mode also loads the light scene (every splat, base colour only, about 4x smaller) when\n// the server offers one. ?scene=full or ?scene=light overrides the choice on any device.\nasync function pickScene() {\n  const wanted = params.get(\"scene\") ?? (TABLET ? \"light\" : \"full\");\n  if (wanted === \"light\") {\n    const head = await fetch(\"scene-light.ply\", { method: \"HEAD\" }).catch(() => null);\n    if (head?.ok) return { url: \"scene-light.ply\", label: \"light\" };\n  }\n  return { ur