from make highlights\")\n+    p.add_argument(\"--bim\", type=Path, help=\"folder from app.bim: bim.json and model.ifc\")\n     p.add_argument(\"--host\", default=\"0.0.0.0\")\n     p.add_argument(\"--port\", type=int, default=8000)\n     p.add_argument(\"--https\", action=\"store_true\", help=\"serve HTTPS, needed for phone sensors\")\n@@ -126,6 +127,11 @@ def main() -> None:\n             p.error(f\"not found: {args.highlights / 'highlights.json'}; run make highlights\")\n         routes[\"/highlights.json\"] = (args.highlights / \"highlights.json\").resolve()\n         routes[\"/highlights/\"] = args.highlights.resolve()\n+    if args.bim:\n+        for name in (\"bim.json\", \"model.ifc\"):\n+            if not (args.bim / name).is_file():\n+                p.error(f\"not found: {args.bim / name}; run make bim\")\n+            routes[f\"/{name}\"] = (args.bim / name).resolve()\n     handler = functools.partial(Handler, routes=routes)\n     with http.server.ThreadingHTTPServer((args.host, args.port), handler) as srv:\n         scheme = \"https\" if args.https else \"http\"\ndiff --git a/web/style.css b/web/style.css\nindex 8cb0a46..74aec28 100644\n--- a/web/style.css\n+++ b/web/style.css\n@@ -295,3 +295,32 @@ button {\n   color: #38bdf8;\n   font-size: 13px;\n }\n+\n+/* Anchored above the buttons, so the status box at the top stays readable when it grows. */\n+#bim-panel {\n+  position: fixed;\n+  bottom: 68px;\n+  left: 12px;\n+  width: min(380px, calc(100vw - 24px));\n+  max-height: calc(100vh - 210px);\n+  overflow-y: auto;\n+  padding: 10px 12px;\n+  border-radius: 6px;\n+  background: var(--panel);\n+}\n+#bim-panel h2 { margin: 0 0 4px; font-size: 16px; }\n+#bim-panel h2 small, .bim-note { color: var(--muted); font-size: 12px; font-weight: normal; }\n+.bim-note { margin: 0 0 8px; }\n+#bim-classes { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 8px; font-size: 12px; }\n+#bim-classes label { overflow-wrap: anywhere; }\n+#bim-classes label { display: flex; align-items: center; gap: 4px; }\n+.swatch { display: inline-block; width: 10px; height: 10px; border-radius: 2px; }\n+.bim-section { display: flex; align-items: center; gap: 6px; margin: 8px 0; font-size: 13px; }\n+.bim-section input { flex: 1; }\n+.bim-actions { display: flex; align-items: center; gap: 10px; }\n+#bim-download { color: inherit; }\n+#bim-props h3 { margin: 10px 0 4px; font-size: 14px; }\n+#bim-props h4 { margin: 8px 0 2px; font-size: 12px; color: var(--muted); }\n+#bim-props dl { display: grid; grid-template-columns: auto 1fr; gap: 1px 8px; margin: 0; font-size: 12px; }\n+#bim-props dt { color: var(--muted); }\n+#bim-props dd { margin: 0; overflow-wrap: anywhere; }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"71450e51-4d50-40f6-bba1-f6ffcd949b59","context":{"git_state":{"cwd":"/home/viktor-trilar/Projects/Newbies","root":"/home/viktor-trilar/Projects/Newbies","branch":"viktor/bim","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":7,"untracked":null,"untracked_normal":3},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"}]}},"live_cwd":"/home/viktor-trilar/Projects/Newbies","platform":"linux"}},"sandboxed":false,"sourceToolAssistantUUID":"25f4bb88-51cc-4090-a4c5-a4f9aa3d66d9","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-vscode","cwd":"/home/viktor-trilar/Projects/Newbies","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","version":"2.1.319","gitBranch":"viktor/bim","slug":"vast-jumping-lobster"}
