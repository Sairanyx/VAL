_remember_home(asset)\n        self.assets[object_id] = asset\n        return asset\n''')\nt=t.replace('''    def _split(self, parent''','''    @staticmethod\n    def _remember_home(asset: dict) -> None:\n        asset[\"home\"] = {key: list(asset[key]) for key in (\"bbox_min\", \"bbox_max\", \"center\")}\n\n    def _split(self, parent''')\nopen(p,'w').write(t)\n\np='app/api/main.py'; t=open(p).read()\nt=t.replace('''    @app.post(\"/api/objects/propose\")''','''    piece_files = Path(tempfile.mkdtemp(prefix=\"object-pieces-\"))\n\n    @app.get(\"/api/objects/{object_id}/home\")\n    def object_home(object_id: str) -> dict:\n        \"\"\"Say where an object's splats are in the scan, to hide them there when it's moved.\"\"\"\n        require(object_id)\n        return {**store.home_box(object_id), \"floor_margin\": FLOOR_MARGIN}\n\n    @app.get(\"/api/objects/{object_id}/splats.ply\")\n    def object_splats(object_id: str) -> FileResponse:\n        \"\"\"Cut an object's splats out of the scan, for moving the real thing.\"\"\"\n        require(object_id)\n        path = piece_files / f\"{hashlib.sha256(object_id.encode()).hexdigest()}.ply\"\n        if not path.exists():\n            splats = splats_for_selection()\n            home = store.home_box(object_id)\n            up = np.asarray(store.scene.get(\"up\") or (0.0, -1.0, 0.0), dtype=np.float64)\n            axis = int(np.argmax(np.abs(up)))\n            floor_height = store.scene.get(\"floor_y\", 0.0) * float(up[axis])\n            _, pieces = split_movable(splats, [{**home, \"object_id\": object_id}], floor_height, up)\n            write_splats(pieces[object_id], path)\n        return FileResponse(path, media_type=\"application/octet-stream\")\n\n    @app.post(\"/api/objects/propose\")''')\nt=t.replace('''from app.scene.load import Splats, read_splats\n''','''from app.scene.load import Splats, read_splats, write_splats\nfrom app.scene.split_movable import FLOOR_MARGIN, split_movable\n''')\nt=t.replace('''from fastapi.middleware.cors import CORSMiddleware\n''','''from fastapi.middleware.cors import CORSMiddleware\nfrom fastapi.responses import FileResponse\n''')\nt=t.replace('''import os\n''','''import hashlib\nimport os\nimport tempfile\n''',1)\nif 'import numpy as np' not in t: t=t.replace('''from fastapi import FastAPI''','''import numpy as np\nfrom fastapi import FastAPI''',1)\nopen(p,'w').write(t)\n\np='web/objects.js'; t=open(p).read()\nt=t.replace('''import { SplatMesh } from \"@sparkjsdev/spark\";\n''','''import { SplatEdit, SplatEditSdf, SplatEditSdfType, SplatMesh } from \"@sparkjsdev/spark\";\n''')\nt=t.replace('''    object.piece = new SplatMesh({ url: `pieces/${id}.ply` });\n    root.add(object.piece);\n''','''    object.piece = new SplatMesh({ url: `pieces/${id}.ply` });\n    object.piece.edits = [];\n    root.add(object.piece);\n''')\nt=t.replace('''  const roomCenter = new THREE.Vector3();\n''','''  // Any other movable object is cut out when first moved: the backend sends its splats, and the same\n  // space is hidden in the scan, so that it isn't left behind as a ghost.\n  const hidden = new SplatEdit({ sdfs: [] });\n  splat.edits = [hidden];\n\n  async function loadPiece(object) {\n    const id = encodeURIComponent(object.asset.object_id);\n    const response = await fetch(`/api/objects/${id}/home`);\n    if (!response.ok) throw new Error(`Backend error ${response.status}`);\n    const home = await response.json();\n    const piece = new SplatMesh({ url: `/api/objects/${id}/splats.ply`, lod: false });\n    piece.edits = [];\n    await piece.initialized;\n    if (object.gone) {\n      piece.dispose();\n      return;\n    }\n    const low = new THREE.Vector3(...home.bbox_min);\n    const high = new THREE.Vector3(...home.bbox_max);\n    // Stop just above the floor, which stays. A box's bottom often sits above an object's base.\n    high.y = floorY - home.floor_margin;\n    const space = new SplatEditSdf({ type: SplatEditSdfType.BOX, opacity: 0 });\n    space.position.copy(low).add(high).multiplyScalar(0.5);\n    space.scale.copy(high).sub(low);\n    root.add(space);\n    hidden.addSdf(space);\n    piece.position.copy(object.center).sub(new THREE.Vector3(...home.center));\n    piece.visible = splat.visible;\n    root.add(piece);\n    pieces.push(piece);\n    object.piece = piece;\n    object.hiddenSpace = space;\n  }\n\n  // Waits for an object's real splats. If they can't be loaded, it moves as an outline instead.\n  function ensurePiece(object) {\n    if (object.piece) return Promise.resolve();\n    object.pieceLoading ??= loadPiece(object).catch((error) => {\n      console.warn(\"Moving as an outline:\", error.message);\n      onMessage?.(\"Moving the outline only: the backend couldn't cut this object out of the scan\");\n    });\n    return object.pieceLoading;\n  }\n\n  // For an object that's gone, split, or combined: show the scan as it was there again.\n  function dropPiece(object) {\n    if (!object.piece) return;\n    if (!object.hiddenSpace) {\n      object.piece.visible = false; // Cut in advance: the scan has no splats to bring back.\n      return;\n    }\n    hidden.removeSdf(object.hiddenSpace);\n    root.remove(object.hiddenSpace);\n    root.remove(object.piece);\n    pieces.splice(pieces.indexOf(object.piece), 1);\n    object.piece.dispose();\n    object.piece = null;\n    object.hiddenSpace = null;\n    object.pieceLoading = null;\n  }\n\n  function restorePiece(object) {\n    if (object.piece && !object.hiddenSpace) object.piece.visible = splat.visible;\n  }\n\n  const roomCenter = new THREE.Vector3();\n''',1)\nt=t.replace('''    const start = object.center.clone();\n    state.moving =''','''    ensurePiece(object);\n    const start = object.center.clone();\n    state.moving =''')\nt=t.replace('''    placeAt,\n    shapeCount''','''    placeAt,\n    ensurePiece,\n    dropPiece,\n    restorePiece,\n    shapeCount''')\nopen(p,'w').write(t)\n\np='web/main.js'; t=open(p).read()\nt=t.replace('''function hideObject(object) {\n  object.gone = true;\n''','''function hideObject(object) {\n  objectLayer?.dropPiece(object);\n  object.gone = true;\n''')\nt=t.replace('''      object.splitAway = false;\n      object.gone = false;\n      object.pick.layers.enable(0);\n''','''      object.splitAway = false;\n      object.gone = false;\n      object.pick.layers.enable(0);\n      objectLayer?.restorePiece(object);\n''')\nt=t.replace('''      objectLayer.placeAt(object, asset.center);\n      changed += 1;\n''','''      await objectLayer.ensurePiece(object);\n      objectLayer.placeAt(object, asset.center);\n      changed += 1;\n''')\nopen(p,'w').write(t)\n\np='docs/USAGE.md'; t=open(p).read()\nt=t.replace('''Three objects move as the real scan: `obj-0067`, `obj-0021`, and `obj-0112`. Other movable objects\nonly move as an outline, so they stay put in Scan view. Press **Scan** to switch to **Both** or **Objects** to\nsee fitted shapes move.\n''','''Every movable object moves as the real scan, including split and combined ones. `obj-0067`, `obj-0021`, and\n`obj-0112` are cut in advance by `make pieces`, with the floor behind them patched, so they look cleanest.\nOthers are cut by their box when you press **Move on floor**, which takes a moment. Anything else in the box\nmoves too, and the floor they leave may look dark. If it can't be cut, the outline moves instead, and the\npanel says so. This needs `Equipment Room.ply` in `data/scene/equipment_room/`.\n''')\nt=t.replace('''The parts move as outlines, not as the real scan. **Undo changes** brings the original back.\n''','''Set a part to movable to move it, and its real splats go with it. **Undo changes** brings the original back.\n''')\nt=t.replace(\"| Only an outline moves | Not one of the three objects, or no `PIECES=` | Use the full `make web` line above |\",\"| Only an outline moves | The backend couldn't cut it | Check `make api` is running and `Equipment Room.ply` is in place |\")\nopen(p,'w').write(t)\np='docs/PLAN.md'; t=open(p).read()\nt=t.replace(\"**Say this accurately:** three objects move as real splats, and the others as outlines.\",\"**Say this accurately:** three objects are cut cleanly in advance, and other movable objects are cut by their box on demand, which can take neighbours along and leave dark floor.\")\nopen(p,'w').write(t)\nEOF\ncat >> tests/test_select_object.py <<'EOF'\n\n\ndef test_any_object_can_be_cut_from_its_home_even_after_moving(tmp_path, monkeypatch):\n    from app.scene.load import read_splats, write_splats\n\n    near = cloud([0, 0.5, 0], 0.2, 500)\n    far = cloud([3, 0.5, 0], 0.2, 700, seed=1)\n    scene_file = tmp_path / \"scene.ply\"\n    write_splats(scene(near, far), scene_file)\n    monkeypatch.setenv(\"SCENE_PLY\", str(scene_file))\n    asset = {\n        **box_asset(\"cart\"),\n        \"center\": [0, 0.5, 0],\n        \"bbox_min\": [-0.25, 0.25, -0.25],\n        \"bbox_max\": [0.25, 0.75, 0.25],\n    }\n    path = tmp_path / \"assets.json\"\n    path.write_text(json.dumps({\"scene_id\": \"t\", \"floor_y\": FLOOR_Y, \"assets\": [asset]}))\n    client = TestClient(create_app(path, engine=False, database=False))\n    move = {\"op\": \"move\", \"object_id\": \"cart\", \"position\": [2, 0.5, 0]}\n    assert client.post(\"/api/changes\", json=move).status_code == 200\n    assert client.get(\"/api/objects/cart/home\").json()[\"center\"] == [0, 0.5, 0]\n    reply = client.get(\"/api/objects/cart/splats.ply\")\n    assert reply.status_code == 200\n    saved = tmp_path / \"piece.ply\"\n    saved.write_bytes(reply.content)\n    assert len(read_splats(saved)) == 500  # Where it was scanned, not where it stands now.\nEOF\nuv run --no-sync ruff format app tests/test_select_object.py 2>&1 | tail -1; uv run --no-sync ruff check --fix app tests/test_select_object.py 2>&1 | tail -1 | cut -c1-60; make lint 2>&1 | tail -1 | cut -c1-50; uv run --no-project --with numpy --with scipy --with pandas --with openpyxl --with pytest --with fastapi --with httpx --with pill