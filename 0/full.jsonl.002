ies/.claude/worktrees/agent-aef4b903dc16194fa","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","version":"2.1.319","gitBranch":"viktor/fix-copilot-button","slug":"vast-jumping-lobster"}
