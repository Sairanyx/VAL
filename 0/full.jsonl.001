{"type":"bridge-session","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","bridgeSessionId":"cse_01W2z6u48mE7ruGEe22DNPVT","lastSequenceNum":0,"ownerAccountUuid":"eb1ff47f-cfbf-49b1-a15e-4ca693f2c22a","ownerOrganizationUuid":"af454b37-7570-4ffb-9890-36a908611f8b"}
{"parentUuid":"7bc123c3-f953-4cf4-91ff-25ed946e63a2","isSidechain":false,"promptId":"dcbd8ba1-3522-4096-ad5e-41a09d6240dc","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UUWESmuuXmvaYC5F5eUC4u","type":"tool_result","content":"    stop_distance: float  # Metres from the route's end to the target object's box.\n    view_from: Point  # On the route, far enough back to see the whole object.\n\n\nclass NoRoute(ValueError):\n    \"\"\"No route exists, with a reason suitable for showing to the user.\"\"\"\n\n\ndef to_cell(grid: NavGrid, point: Point) -> tuple[int, int]:\n    coordinates = np.asarray(point, dtype=np.float64)[list(grid.axes)]\n    return tuple(np.floor((coordinates - grid.origin) / grid.cell).astype(int).tolist())\n\n\ndef cell_to_point(grid: NavGrid, cell: tuple[int, int]) -> Point:\n    position = [0.0, 0.0, 0.0]\n    for axis, index, origin in zip(grid.axes, cell, grid.origin, strict=True):\n        position[axis] = float(origin + (index + 0.5) * grid.cell)\n    up_axis = 3 - sum(grid.axes)\n    position[up_axis] = float(grid.floor_height / grid.up[up_axis])\n    return tuple(position)\n\n\ndef box_cells(grid: NavGrid, low: Point, high: Point) -> tuple[slice, slice]:\n    \"\"\"Return array slices for the floor cells under a box, clipped to the map.\"\"\"\n    first, second = to_cell(grid, low), to_cell(grid, high)\n    size = grid.free.shape\n    return tuple(\n        slice(max(min(a, b), 0), min(max(a, b) + 1, limit))\n        for a, b, limit in zip(first, second, size, strict=True)\n    )\n\n\ndef clearance_with_footprints(grid: NavGrid, footprints: list[tuple[Point, Point]]) -> np.ndarray:\n    \"\"\"Return clearance in metres, with these (low, high) boxes blocked on top of the map.\"\"\"\n    free = grid.free.copy()\n    for low, high in footprints:\n        free[box_cells(grid, low, high)] = False\n    return ndimage.distance_transform_edt(free) * grid.cell\n\n\ndef nearest_open_cell(\n    fits: np.ndarray, cell: tuple[int, int], limit: float\n) -> tuple[int, int] | None:\n    \"\"\"Return the closest cell where the body fits, within `limit` cells of `cell`.\"\"\"\n    open_cells = np.argwhere(fits)\n    if not len(open_cells):\n        return None\n    distances = np.linalg.norm(open_cells - np.asarray(cell), axis=1)\n    best = int(np.argmin(distances))\n    return tuple(open_cells[best].tolist()) if distances[best] <= limit else None\n\n\ndef search(clearance: np.ndarray, fits: np.ndarray, start: tuple[int, int]) -> tuple[dict, dict]:\n    \"\"\"Dijkstra from `start` over cells where the body fits, preferring open space.\n\n    Returns each reached cell's cost and predecessor. Costs rise near obstacles, so routes keep to\n    the middle of aisles, as a person would, unless a tight spot is the only way through.\n    \"\"\"\n    costs = {start: 0.0}\n    previous: dict[tuple[int, int], tuple[int, int]] = {}\n    queue = [(0.0, start)]\n    steps = [(i, j) for i in (-1, 0, 1) for j in (-1, 0, 1) if i or j]\n    while queue:\n        cost, (x, y) = heapq.heappop(queue)\n        if cost > costs[(x, y)]:\n            continue\n        for dx, dy in steps:\n            cell = (x + dx, y + dy)\n            if (\n                not (0 <= cell[0] < fits.shape[0] and 0 <= cell[1] < fits.shape[1])\n                or not fits[cell]\n            ):\n                continue\n            # Diagonal moves mustn't cut across a blocked corner.\n            if dx and dy and not (fits[x + dx, y] and fits[x, y + dy]):\n                continue\n            step = math.hypot(dx, dy) * (1 + 0.5 / max(clearance[cell], 0.1))\n            if cost + step < costs.get(cell, math.inf):\n                costs[cell] = cost + step\n                previous[cell] = (x, y)\n                heapq.heappush(queue, (cost + step, cell))\n    return costs, previous\n\n\ndef line_is_clear(fits: np.ndarray, a: tuple[int, int], b: tuple[int, int]) -> bool:\n    count = max(abs(b[0] - a[0]), abs(b[1] - a[1])) * 2 + 1\n    rows = np.linspace(a[0], b[0], count).round().astype(int)\n    cols = np.linspace(a[1], b[1], count).round().astype(int)\n    return bool(fits[rows, cols].all())\n\n\ndef shorten(cells: list[tuple[int, int]], fits: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Replace the staircase of grid steps with straight lines wherever the body still fits.\"\"\"\n    result = [cells[0]]\n    index = 0\n    while index < len(cells) - 1:\n        reach = len(cells) - 1\n        while reach > index + 1 and not line_is_clear(fits, cells[index], cells[reach]):\n            reach -= 1\n        result.append(cells[reach])\n        index = reach\n    return result\n\nimport math\n\nimport pytest\n\nnp = pytest.importorskip(\"numpy\")\npytest.importorskip(\"scipy\")\n\nfrom app.nav.grid import build_nav_grid  # noqa: E402\nfrom app.nav.route import NoRoute, line_is_clear, plan_route, viewing_point  # noqa: E402\n\n\ndef room():\n    \"\"\"A 6 x 6 m floor. A wall at x = 3 has a 1.2 m gap at the far end, z from 4.8 to 6.\"\"\"\n    rng = np.random.default_rng(0)\n    floor = rng.uniform([0, 0, 0], [6, 0, 6], (120000, 3))\n    wall = rng.uniform([2.95, -1.8, 0], [3.05, -0.2, 4.8], (40000, 3))\n    points = np.concatenate([floor, wall])\n    return build_nav_grid(points, np.ones(len(points)), (0, -1, 0), floor_height=0.0)\n\n\nGRID = room()\nSTART = (1.0, 0.0, 1.0)\nTARGET = ((5.0, 0.0, 1.0), (5.4, -1.0, 1.4))\n\n\ndef cells_of(route):\n    return [(p[0], p[2]) for p in route.path]\n\n\ndef crosses_wall(route, grid=GRID):\n    for a, b in zip(route.path, route.path[1:], strict=False):\n        for t in np.linspace(0, 1, 200):\n            x = a[0] + (b[0] - a[0]) * t\n            z = a[2] + (b[2] - a[2]) * t\n            if 2.95 <= x <= 3.05 and z < 4.8:\n                return True\n    return False\n\n\ndef test_route_goes_through_the_gap_and_not_the_wall():\n    route = plan_route(GRID, START, *TARGET, width=0.6)\n    assert not crosses_wall(route)\n    assert max(p[2] for p in route.path) > 4.8\n    assert route.length > math.dist(START, TARGET[0])\n\n\ndef test_route_stays_on_the_floor_and_stops_close_to_the_target():\n    route = plan_route(GRID, START, *TARGET, width=0.6)\n    assert all(p[1] == pytest.approx(0.0) for p in route.path)\n    assert route.stop_distance < 0.8\n\n\ndef test_too_wide_a_body_gets_a_reason_instead_of_a_route():\n    with pytest.raises(NoRoute, match=\"closest reachable floor\"):\n        plan_route(GRID, START, *TARGET, width=2.0, max_stop_distance=0.5)\n\n\ndef test_footprint_in_the_gap_blocks_then_moving_it_reopens_the_route():\n    in_gap = ((2.5, 0.0, 4.6), (3.5, -1.0, 6.0))\n    with pytest.raises(NoRoute):\n        plan_route(GRID, START, *TARGET, width=0.6, footprints=[in_gap])\n    moved = ((0.2, 0.0, 5.0), (0.8, -1.0, 5.6))\n    assert plan_route(GRID, START, *TARGET, width=0.6, footprints=[moved])\n\n\ndef test_start_inside_an_obstacle_snaps_to_nearby_floor():\n    route = plan_route(GRID, (3.0, 0.0, 2.0), *TARGET, width=0.6)\n    assert route.path\n\n\ndef test_start_far_from_any_floor_is_refused():\n    with pytest.raises(NoRoute, match=\"start point\"):\n        plan_route(GRID, (40.0, 0.0, 40.0), *TARGET, width=0.6)\n\n\ndef test_line_check_sees_blocked_cells():\n    fits = np.ones((10, 10), dtype=bool)\n    fits[5, :] = False\n    assert not line_is_clear(fits, (0, 0), (9, 9))\n    assert line_is_clear(fits, (0, 0), (4, 9))\n\n\ndef test_viewing_point_stands_back_from_the_target_along_the_route():\n    points = [(0.0, 0.0, 0.0), (4.0, 0.0, 0.0), (6.0, 0.0, 0.0)]\n    point = viewing_point(GRID, points, (6.5, 1.0, 0.0), distance=2.0)\n    assert point[0] == pytest.approx(4.5, abs=GRID.cell)\n    assert viewing_point(GRID, points[:2], (4.5, 1.0, 0.0), distance=9.0) == points[0]\n\n\ndef test_real_route_reroutes_when_a_movable_object_is_moved(tmp_path):\n    import json\n\n    np = pytest.importorskip(\"numpy\")\n    pytest.importorskip(\"scipy\")\n    from app.nav.grid import build_nav_grid\n\n    rng = np.random.default_rng(0)\n    floor = rng.uniform([0, 0, 0], [6, 0, 6], (120000, 3))\n    wall = rng.uniform([2.95, -1.8, 0], [3.05, -0.2, 4.8], (40000, 3))\n    points = np.concatenate([floor, wall])\n    grid = build_nav_grid(points, np.ones(len(points)), (0, -1, 0), floor_height=0.0)\n    box = {\"label_confidence\": 0.5, \"mapping\": None}\n    assets = [\n        {\n            **box,\n            \"object_id\": \"pump\",\n            \"label\": \"pump\",\n            \"center\": [5.2, -0.5, 1.2],\n            \"bbox_min\": [5.0, 0.0, 1.0],\n            \"bbox_max\": [5.4, -1.0, 1.4],\n            \"mobility\": \"fixed\",\n        },\n        {\n            **box,\n            \"object_id\": \"cart\",\n            \"label\": \"cart\",\n            \"center\": [3.0, -0.5, 5.3],\n            \"bbox_min\": [2.5, 0.0, 4.6],\n            \"bbox_max\": [3.5, -1.0, 6.0],\n            \"mobility\": \"movable\",\n        },\n    ]\n    path = tmp_path / \"assets.json\"\n    path.write_text(json.dumps({\"scene_id\": \"t\", \"floor_y\": 0.0, \"assets\": assets}))\n    client = TestClient(create_app(path, grid=grid))\n    request = {\"start\": [1.0, 0.0, 1.0], \"object_id\": \"pump\"}\n    blocked = client.post(\"/api/route\", json=request)\n    assert blocked.status_code == 409\n    assert \"closest reachable floor\" in blocked.json()[\"detail\"]\n    moved = client.post(\n        \"/api/changes\", json={\"op\": \"move\", \"object_id\": \"cart\", \"position\": [0.5, -0.5, 5.3]}\n    )\n    assert moved.status_code == 200\n    route = client.post(\"/api/route\", json=request)\n    assert route.status_code == 200\n    assert route.json()[\"placeholder\"] is False\n    assert route.json()[\"stop_distance\"] < 0.8\nfrom app.nav.route import FloorMap, NoRoute, astar, plan_route  # noqa: E402\n\n\ndef floor_with_wall(gap_cells):\n    \"\"\"4 x 4 m at 5 cm, y up is negative. A wall at x = 2 m with a gap at the low z end.\"\"\"\n    free = np.ones((80, 80), bool)\n    free[[0, -1], :] = free[:, [0, -1]] = False\n    free[39:41, gap_cells:] = False\n    clearance = ndimage.distance_transform_edt(free) * 0.05\n    return FloorMap(\n        origin=np.zeros(2),\n        cell=0.05,\n        floor_height=0.0,\n        up=np.array([0.0, -1.0, 0.0]),\n        axes=(0, 2),\n        clearance=clearance,\n        clearance_low=clearance,\n    )\n\n\nTARGET = ([3.2, -1.0, 3.2], [3.4, 0.0, 3.4])\nSTART = [1.0, 0.0, 3.0]\n\n\ndef test_route_goes_through_gap_and_stays_clear():\n    floor = floor_with_wall(30)\n    fits = floor.fits(\"person\")\n    goals = floor.goal_cells(*TARGET)\n    path = astar(fits, floor.to_cell(START), goals)\n    assert path and goals[path[-1]]\n    assert all(fits[cell] for cell in path)\n    assert all(\n        abs(a[0] - b[0]) <= 1 and abs(a[1] - b[1]) <= 1\n        for a, b in zip(path, path[1:], strict=False)\n    )\n    route = plan_route(floor, START, *TARGET)\n    assert route[\"placeholder\"] is False\n    assert min(p[2] for p in route[\"path\"]) < 1.5\n\n\ndef test_route_ends_within_reach_of_object():\n    floor = floor_with_wall(30)\n    end = plan_route(floor, START, *TARGET)[\"path\"][-1]\n    assert np.hypot(max(3.2 - end[0], 0), max(3.2 - end[2], 0)) <= 0.8 + 0.05\n\n\ndef test_body_size_decides_who_fits():\n    floor = floor_with_wall(16)\n    assert plan_route(floor, START, *TARGET, profile=\"robot\")[\"length\"] > 0\n    with pytest.raises(NoRoute, match=\"No connected route\"):\n        plan_route(floor, START, *TARGET, profile=\"carrying\")\n\n\ndef test_blocked_cells_close_the_route():\n    floor = floor_with_wall(30)\n    blocked = np.zeros(floor.clearance.shape, bool)\n    blocked[39:41, :] = True\n    with pytest.raises(NoRoute):\n        plan_route(floor, START, *TARGET, blocked=blocked)\napp/nav/grid.py:62:def load_grid(path: Path) -> NavGrid:\napp/api/main.py:17:from app.nav.grid import NavGrid, load_grid\napp/api/main.py:63:        grid = load_grid(Path(grid))\ntests/test_nav_grid.py:80:    from app.nav.grid import load_grid\ntests/test_nav_grid.py:85:    loaded = load_grid(tmp_path / \"grid.npz\")\n        grid = load_grid(Path(grid))\n    app = FastAPI(title=\"Field-service copilot API\")\n    # The viewer is served from another port on the local network.\n    app.add_middleware(\n        CORSMiddleware, allow_origins=[\"*\"], allow_methods=[\"*\"], allow_headers=[\"*\"]\n    )\n\n    def require(object_id: str) -> dict:\n        asset = store.get(object_id)\n        if asset is None or asset[\"status\"] == \"removed\":\n            raise HTTPException(404, f\"No object {object_id}\")\n        return asset\n\n    @app.get(\"/api/assets\")\n    def list_assets() -> dict:","is_error":false}]},"uuid":"518994d3-15a7-4f96-8569-415a89dd2bf2","timestamp":"2026-11-07T01:48:39.019Z","toolUseResult":{"stdout":"    stop_distance: float  # Metres from the route's end to the target object's box.\n    view_from: Point  # On the route, far enough back to see the whole object.\n\n\nclass NoRoute(ValueError):\n    \"\"\"No route exists, with a reason suitable for showing to the user.\"\"\"\n\n\ndef to_cell(grid: NavGrid, point: Point) -> tuple[int, int]:\n    coordinates = np.asarray(point, dtype=np.float64)[list(grid.axes)]\n    return tuple(np.floor((coordinates - grid.origin) / grid.cell).astype(int).tolist())\n\n\ndef cell_to_point(grid: NavGrid, cell: tuple[int, int]) -> Point:\n    position = [0.0, 0.0, 0.0]\n    for axis, index, origin in zip(grid.axes, cell, grid.origin, strict=True):\n        position[axis] = float(origin + (index + 0.5) * grid.cell)\n    up_axis = 3 - sum(grid.axes)\n    position[up_axis] = float(grid.floor_height / grid.up[up_axis])\n    return tuple(position)\n\n\ndef box_cells(grid: NavGrid, low: Point, high: Point) -> tuple[slice, slice]:\n    \"\"\"Return array slices for the floor cells under a box, clipped to the map.\"\"\"\n    first, second = to_cell(grid, low), to_cell(grid, high)\n    size = grid.free.shape\n    return tuple(\n        slice(max(min(a, b), 0), min(max(a, b) + 1, limit))\n        for a, b, limit in zip(first, second, size, strict=True)\n    )\n\n\ndef clearance_with_footprints(grid: NavGrid, footprints: list[tuple[Point, Point]]) -> np.ndarray:\n    \"\"\"Return clearance in metres, with these (low, high) boxes blocked on top of the map.\"\"\"\n    free = grid.free.copy()\n    for low, high in footprints:\n        free[box_cells(grid, low, high)] = False\n    return ndimage.distance_transform_edt(free) * grid.cell\n\n\ndef nearest_open_cell(\n    fits: np.ndarray, cell: tuple[int, int], limit: float\n) -> tuple[int, int] | None:\n    \"\"\"Return the closest cell where the body fits, within `limit` cells of `cell`.\"\"\"\n    open_cells = np.argwhere(fits)\n    if not len(open_cells):\n        return None\n    distances = np.linalg.norm(open_cells - np.asarray(cell), axis=1)\n    best = int(np.argmin(distances))\n    return tuple(open_cells[best].tolist()) if distances[best] <= limit else None\n\n\ndef search(clearance: np.ndarray, fits: np.ndarray, start: tuple[int, int]) -> tuple[dict, dict]:\n    \"\"\"Dijkstra from `start` over cells where the body fits, preferring open space.\n\n    Returns each reached cell's cost and predecessor. Costs rise near obstacles, so routes keep to\n    the middle of aisles, as a person would, unless a tight spot is the only way through.\n    \"\"\"\n    costs = {start: 0.0}\n    previous: dict[tuple[int, int], tuple[int, int]] = {}\n    queue = [(0.0, start)]\n    steps = [(i, j) for i in (-1, 0, 1) for j in (-1, 0, 1) if i or j]\n    while queue:\n        cost, (x, y) = heapq.heappop(queue)\n        if cost > costs[(x, y)]:\n            continue\n        for dx, dy in steps:\n            cell = (x + dx, y + dy)\n            if (\n                not (0 <= cell[0] < fits.shape[0] and 0 <= cell[1] < fits.shape[1])\n                or not fits[cell]\n            ):\n                continue\n            # Diagonal moves mustn't cut across a blocked corner.\n            if dx and dy and not (fits[x + dx, y] and fits[x, y + dy]):\n                continue\n            step = math.hypot(dx, dy) * (1 + 0.5 / max(clearance[cell], 0.1))\n            if cost + step < costs.get(cell, math.inf):\n                costs[cell] = cost + step\n                previous[cell] = (x, y)\n                heapq.heappush(queue, (cost + step, cell))\n    return costs, previous\n\n\ndef line_is_clear(fits: np.ndarray, a: tuple[int, int], b: tuple[int, int]) -> bool:\n    count = max(abs(b[0] - a[0]), abs(b[1] - a[1])) * 2 + 1\n    rows = np.linspace(a[0], b[0], count).round().astype(int)\n    cols = np.linspace(a[1], b[1], count).round().astype(int)\n    return bool(fits[rows, cols].all())\n\n\ndef shorten(cells: list[tuple[int, int]], fits: np.ndarray) -> list[tuple[int, int]]:\n    \"\"\"Replace the staircase of grid steps with straight lines wherever the body still fits.\"\"\"\n    result = [cells[0]]\n    index = 0\n    while index < len(cells) - 1:\n        reach = len(cells) - 1\n        while reach > index + 1 and not line_is_clear(fits, cells[index], cells[reach]):\n            reach -= 1\n        result.append(cells[reach])\n        index = reach\n    return result\n\nimport math\n\nimport pytest\n\nnp = pytest.importorskip(\"numpy\")\npytest.importorskip(\"scipy\")\n\nfrom app.nav.grid import build_nav_grid  # noqa: E402\nfrom app.nav.route import NoRoute, line_is_clear, plan_route, viewing_point  # noqa: E402\n\n\ndef room():\n    \"\"\"A 6 x 6 m floor. A wall at x = 3 has a 1.2 m gap at the far end, z from 4.8 to 6.\"\"\"\n    rng = np.random.default_rng(0)\n    floor = rng.uniform([0, 0, 0], [6, 0, 6], (120000, 3))\n    wall = rng.uniform([2.95, -1.8, 0], [3.05, -0.2, 4.8], (40000, 3))\n    points = np.concatenate([floor, wall])\n    return build_nav_grid(points, np.ones(len(points)), (0, -1, 0), floor_height=0.0)\n\n\nGRID = room()\nSTART = (1.0, 0.0, 1.0)\nTARGET = ((5.0, 0.0, 1.0), (5.4, -1.0, 1.4))\n\n\ndef cells_of(route):\n    return [(p[0], p[2]) for p in route.path]\n\n\ndef crosses_wall(route, grid=GRID):\n    for a, b in zip(route.path, route.path[1:], strict=False):\n        for t in np.linspace(0, 1, 200):\n            x = a[0] + (b[0] - a[0]) * t\n            z = a[2] + (b[2] - a[2]) * t\n            if 2.95 <= x <= 3.05 and z < 4.8:\n                return True\n    return False\n\n\ndef test_route_goes_through_the_gap_and_not_the_wall():\n    route = plan_route(GRID, START, *TARGET, width=0.6)\n    assert not crosses_wall(route)\n    assert max(p[2] for p in route.path) > 4.8\n    assert route.length > math.dist(START, TARGET[0])\n\n\ndef test_route_stays_on_the_floor_and_stops_close_to_the_target():\n    route = plan_route(GRID, START, *TARGET, width=0.6)\n    assert all(p[1] == pytest.approx(0.0) for p in route.path)\n    assert route.stop_distance < 0.8\n\n\ndef test_too_wide_a_body_gets_a_reason_instead_of_a_route():\n    with pytest.raises(NoRoute, match=\"closest reachable floor\"):\n        plan_route(GRID, START, *TARGET, width=2.0, max_stop_distance=0.5)\n\n\ndef test_footprint_in_the_gap_blocks_then_moving_it_reopens_the_route():\n    in_gap = ((2.5, 0.0, 4.6), (3.5, -1.0, 6.0))\n    with pytest.raises(NoRoute):\n        plan_route(GRID, START, *TARGET, width=0.6, footprints=[in_gap])\n    moved = ((0.2, 0.0, 5.0), (0.8, -1.0, 5.6))\n    assert plan_route(GRID, START, *TARGET, width=0.6, footprints=[moved])\n\n\ndef test_start_inside_an_obstacle_snaps_to_nearby_floor():\n    route = plan_route(GRID, (3.0, 0.0, 2.0), *TARGET, width=0.6)\n    assert route.path\n\n\ndef test_start_far_from_any_floor_is_refused():\n    with pytest.raises(NoRoute, match=\"start point\"):\n        plan_route(GRID, (40.0, 0.0, 40.0), *TARGET, width=0.6)\n\n\ndef test_line_check_sees_blocked_cells():\n    fits = np.ones((10, 10), dtype=bool)\n    fits[5, :] = False\n    assert not line_is_clear(fits, (0, 0), (9, 9))\n    assert line_is_clear(fits, (0, 0), (4, 9))\n\n\ndef test_viewing_point_stands_back_from_the_target_along_the_route():\n    points = [(0.0, 0.0, 0.0), (4.0, 0.0, 0.0), (6.0, 0.0, 0.0)]\n    point = viewing_point(GRID, points, (6.5, 1.0, 0.0), distance=2.0)\n    assert point[0] == pytest.approx(4.5, abs=GRID.cell)\n    assert viewing_point(GRID, points[:2], (4.5, 1.0, 0.0), distance=9.0) == points[0]\n\n\ndef test_real_route_reroutes_when_a_movable_object_is_moved(tmp_path):\n    import json\n\n    np = pytest.importorskip(\"numpy\")\n    pytest.importorskip(\"scipy\")\n    from app.nav.grid import build_nav_grid\n\n    rng = np.random.default_rng(0)\n    floor = rng.uniform([0, 0, 0], [6, 0, 6], (120000, 3))\n    wall = rng.uniform([2.95, -1.8, 0], [3.05, -0.2, 4.8], (40000, 3))\n    points = np.concatenate([floor, wall])\n    grid = build_nav_grid(points, np.ones(len(points)), (0, -1, 0), floor_height=0.0)\n    box = {\"label_confidence\": 0.5, \"mapping\": None}\n    assets = [\n        {\n            **box,\n            \"object_id\": \"pump\",\n            \"label\": \"pump\",\n            \"center\": [5.2, -0.5, 1.2],\n            \"bbox_min\": [5.0, 0.0, 1.0],\n            \"bbox_max\": [5.4, -1.0, 1.4],\n            \"mobility\": \"fixed\",\n        },\n        {\n            **box,\n            \"object_id\": \"cart\",\n            \"label\": \"cart\",\n            \"center\": [3.0, -0.5, 5.3],\n            \"bbox_min\": [2.5, 0.0, 4.6],\n            \"bbox_max\": [3.5, -1.0, 6.0],\n            \"mobility\": \"movable\",\n        },\n    ]\n    path = tmp_path / \"assets.json\"\n    path.write_text(json.dumps({\"scene_id\": \"t\", \"floor_y\": 0.0, \"assets\": assets}))\n    client = TestClient(create_app(path, grid=grid))\n    request = {\"start\": [1.0, 0.0, 1.0], \"object_id\": \"pump\"}\n    blocked = client.post(\"/api/route\", json=request)\n    assert blocked.status_code == 409\n    assert \"closest reachable floor\" in blocked.json()[\"detail\"]\n    moved = client.post(\n        \"/api/changes\", json={\"op\": \"move\", \"object_id\": \"cart\", \"position\": [0.5, -0.5, 5.3]}\n    )\n    assert moved.status_code == 200\n    route = client.post(\"/api/route\", json=request)\n    assert route.status_code == 200\n    assert route.json()[\"placeholder\"] is False\n    assert route.json()[\"stop_distance\"] < 0.8\nfrom app.nav.route import FloorMap, NoRoute, astar, plan_route  # noqa: E402\n\n\ndef floor_with_wall(gap_cells):\n    \"\"\"4 x 4 m at 5 cm, y up is negative. A wall at x = 2 m with a gap at the low z end.\"\"\"\n    free = np.ones((80, 80), bool)\n    free[[0, -1], :] = free[:, [0, -1]] = False\n    free[39:41, gap_cells:] = False\n    clearance = ndimage.distance_transform_edt(free) * 0.05\n    return FloorMap(\n        origin=np.zeros(2),\n        cell=0.05,\n        floor_height=0.0,\n        up=np.array([0.0, -1.0, 0.0]),\n        axes=(0, 2),\n        clearance=clearance,\n        clearance_low=clearance,\n    )\n\n\nTARGET = ([3.2, -1.0, 3.2], [3.4, 0.0, 3.4])\nSTART = [1.0, 0.0, 3.0]\n\n\ndef test_route_goes_through_gap_and_stays_clear():\n    floor = floor_with_wall(30)\n    fits = floor.fits(\"person\")\n    goals = floor.goal_cells(*TARGET)\n    path = astar(fits, floor.to_cell(START), goals)\n    assert path and goals[path[-1]]\n    assert all(fits[cell] for cell in path)\n    assert all(\n        abs(a[0] - b[0]) <= 1 and abs(a[1] - b[1]) <= 1\n        for a, b in zip(path, path[1:], strict=False)\n    )\n    route = plan_route(floor, START, *TARGET)\n    assert route[\"placeholder\"] is False\n    assert min(p[2] for p in route[\"path\"]) < 1.5\n\n\ndef test_route_ends_within_reach_of_object():\n    floor = floor_with_wall(30)\n    end = plan_route(floor, START, *TARGET)[\"path\"][-1]\n    assert np.hypot(max(3.2 - end[0], 0), max(3.2 - end[2], 0)) <= 0.8 + 0.05\n\n\ndef test_body_size_decides_who_fits():\n    floor = floor_with_wall(16)\n    assert plan_route(floor, START, *TARGET, profile=\"robot\")[\"length\"] > 0\n    with pytest.raises(NoRoute, match=\"No connected route\"):\n        plan_route(floor, START, *TARGET, profile=\"carrying\")\n\n\ndef test_blocked_cells_close_the_route():\n    floor = floor_with_wall(30)\n    blocked = np.zeros(floor.clearance.shape, bool)\n    blocked[39:41, :] = True\n    with pytest.raises(NoRoute):\n        plan_route(floor, START, *TARGET, blocked=blocked)\napp/nav/grid.py:62:def load_grid(path: Path) -> NavGrid:\napp/api/main.py:17:from app.nav.grid import NavGrid, load_grid\napp/api/main.py:63:        grid = load_grid(Path(grid))\ntests/test_nav_grid.py:80:    from app.nav.grid import load_grid\ntests/test_nav_grid.py:85:    loaded = load_grid(tmp_path / \"grid.npz\")\n        grid = load_grid(Path(grid))\n    app = FastAPI(title=\"Field-service copilot API\")\n    # The viewer is served from another port on the local network.\n    app.add_middleware(\n        CORSMiddleware, allow_origins=[\"*\"], allow_methods=[\"*\"], allow_headers=[\"*\"]\n    )\n\n    def require(object_id: str) -> dict:\n        asset = store.get(object_id)\n        if asset is None or asset[\"status\"] == \"removed\":\n            raise HTTPException(404, f\"No object {object_id}\")\n        return asset\n\n    @app.get(\"/api/assets\")\n    def list_assets() -> dict:","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"6a9e5381-13c4-4289-8b69-bebb6d6dc306","context":{"git_state":{"cwd":"/home/viktor-trilar/Projects/Newbies","root":"/home/viktor-trilar/Projects/Newbies","branch":"viktor/viewer-objects","default_branch":null,"status":{"clean":false,"counts":{"staged":6,"modified":4,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"},"push_remote":null,"remotes":[{"name":"origin","host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"}]}},"live_cwd":"/home/viktor-trilar/Projects/Newbies","platform":"linux"}},"sandboxed":false,"sourceToolAssistantUUID":"7bc123c3-f953-4cf4-91ff-25ed946e63a2","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-vscode","cwd":"/home/viktor-trilar/Projects/Newbies","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","version":"2.1.319","gitBranch":"viktor/viewer-objects","slug":"vast-jumping-lobster"}
