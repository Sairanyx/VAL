 m. Passed in every run since. Looks like test timing, not proven. Viktor\\n\"),\n]:\n    if old in t: t = t.replace(old, new, 1)\n    else: print(\"checklist line missing:\", old[:40])\nopen(\"docs/TEST_CHECKLIST.md\", \"w\").write(t)\nt = open(\"docs/USAGE.md\").read()\nold = \"- **Delete** asks first, then removes the object from the scan, the routes, BIM mode and the exports.\\n\"\nif old in t:\n    i = t.index(old); j = t.index(\"\\n\", t.index(\"\\n\", i) + 1)\n    t = t[:i] + old + \"  It hides a few small boxes around the object's own splats, so most neighbours stay. Undo brings it back.\\n\" + t[j+1:]\nelse: print(\"usage delete line missing\")\nold = \"## Other controls\\n\"\nassert old in t\nt = t.replace(old, \"## Frame colours\\nFrames are coloured by type, the same as BIM mode: pumps amber, tanks green, valves purple, pipes blue, cables\\nyellow, cabinets teal, chairs and shelves pink, anything else grey, and the faulty device red. **More** has the\\nfull list under **Frame colours**.\\n\\n\" + old, 1)\nt = t.replace(\"**Voice on** turns this off.\", \"It's off until you press **Voice off**.\")\nopen(\"docs/USAGE.md\", \"w\").write(t)\nEOF\ngrep -n \"read aloud\\|Voice\" docs/USAGE.md | cut -c1-110; for pid in $(ss -ltnp | grep -E \":8201 |:8223 \" | sed -n 's/.*pid=\\([0-9]*\\).*/\\1/p' | sort -u); do kill \"$pid\" 2>/dev/null; done; SCENE_ASSETS=\"$T/assets_mapped.json\" SCENE_GRID=\"$T/nav_grid.npz\" DATABASE_URL= PYTHONPATH=\"$W\" nohup uv run --no-project --with numpy --with scipy --with fastapi --with uvicorn --with websockets --with watchfiles --with pydantic --with openpyxl --with pandas --with pillow --with 'psycopg[binary]' uvicorn app.api.main:app --port 8201 --reload --reload-dir \"$V/watch\" > \"$V/recheck_api.log\" 2>&1 &\nnohup python3 \"$V/serve_on_port.py\" \"$W\" 8201 --scene \"$T/light_400k.ply\" --assets \"$T/assets_mapped.json\" --shapes \"$T/shapes.json\" --port 8223 --host 127.0.0.1 > \"$V/recheck_web.log\" 2>&1 &\nfor i in $(seq