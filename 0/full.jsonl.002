sset_ids_or_tags: list[str]) -> list[dict[str, Any]]:\n=== llm.answer\ndef answer(\n    engine: CopilotEngine, question: str, object_id: str | None, writer: Writer | None\n) -> dict[str, Any]:\n    \"\"\"Answer through the template engine, then let the model explain it where that's safe.\"\"\"\n    response = engine.query(question, object_id=object_id)\n    if writer is None:\n        return {**response.to_dict(), \"answer_source\": \"template\", \"reason\": \"no model loaded\"}\n    question_lower = question.lower()\n    template_only = (\n        not response.safety_passed\n        or not response.focused_asset\n        or not response.citations\n        or engine._is_navigation_intent(question_lower)\n    )\n    if template_only:\n        reason = \"refused or nothing to explain\"\n        return {**response.to_dict(), \"answer_source\": \"template\", \"reason\": reason}\n    if \"servic\" in question_lower or \"maintenance\" in question_lower:\n        record = engine.store.get_asset(response.focused_asset)\n        orders = get_maintenance_history(response.focused_asset, engine.store, limit=100)\n        opened = [order[\"opened_at\"] for order in orders if order.get(\"opened_at\")]\n        disagreement = service_date_note(record.last_service_date if record else None, opened)\n        if disagreement:\n            response.observations = [disagreement, *response.observations]\n    facts = gather_facts(engine, response.focused_asset)\n    explained, note = explain(response, facts, question, writer)\n    return {**explained.to_dict(), **note}\nPROMPT = \"\"\"You help a field technician in an industrial plant. Answer the question using only the\nfacts below. Each fact starts with its ID in square brackets.\n\nRules:\n- Use only these facts. If they don't answer the question, say what is missing.\n- Copy numbers exactly as written. Don't calculate new numbers.\n- In \"answer\", say only what was measured or recorded.\n- In \"hypotheses\", give possible causes, worded with \"may\", and only ones these facts suggest. Don't\n  say whether past work did or didn't fix anything. If nothing is wrong, leave it empty.\n- Cite the ID of every fact you use.\n- Never tell anyone to operate, start, stop, or change equipment. Suggest checks only.\n- Use two to four short, plain sentences.\n\nFacts:\n{facts}\n\nQuestion: {question}\n\nReply with JSON only:\n{{\"answer\": \"...\", \"hypotheses\": [\"...\"], \"citations\": [\"ID\"]}}\"\"\"\n=== api\n    def copilot(request: CopilotRequest) -> dict:\n        if request.object_id:\n            require(request.object_id)\n        if engine:\n            answer = ask(engine, store.visible(), request.question, request.object_id, writer)\n            return {**answer, \"placeholder\": False}\n        return {\n            \"answer\": \"The copilot isn't connected yet.\",\n            \"observations\": [],\n            \"hypotheses\": [],\n            \"citations\": [],\n            \"confidence\": 0.0,\n            \"actions\": [],\n            \"placeholder\": True,\n        }\n\n    @app.get(\"/api/changes\")\n    def list_changes() -> dict:\n        return {\"changes\": store.changes}\n\n    def move_check(object_id: str, position: list[float], yaw: float | None = None) -> MoveCheck:\n        asset = require(object_id)\n        # Check the box at the new angle, so turning can't push an object into another.\n        low, high = shifted_box(asset, asset[\"center\"], yaw)\n        turned = {**asset, \"bbox_min\": low, \"bbox_max\": high}\n        return check_move(turned, position, store.visible(), grid, store.original(object_id))\n\n    @app.post(\"/api/objects/{object_id}/check-move\")\n    def check_a_move(object_id: str, request: MoveCheckRequest) -> dict:\n205:    def load(cls, workbook_path: Path | str | None = None) -> DataStore:\n386:            p = Path(path)\n391:        matches = sorted(glob.glob(\"data/*.xlsx\"))\n393:            return Path(matches[0])\n395:        parent_matches = sorted(glob.glob(\"../data/*.xlsx\"))\n397:            return Path(parent_matches[0])\n400:            \"No Excel builder pack found in data/*.xlsx. Please deposit the pack file into data/\n596:def load_mapping(path: Path | str = \"fixtures/mapping.json\") -> dict[str, dict[str, Any]]:\n  \n.  \n..  \n.gitkeep  \nscene  \nvalmet_frames  \nValmet_SinceAI_2026_Synthetic_Industrial_Metaverse_Builder_Pack (1) (2)\n191:    def __init__(self) -> None:\n205:    def load(cls, workbook_path: Path | str | None = None) -> DataStore:\n384:    def _resolve_path(path: Path | str | None) -> Path:\n403:    def resolve_asset_id(self, id_or_tag: str) -> str | None:\n412:    def get_asset(self, id_or_tag: str) -> Asset | None:\n417:    def list_assets(self, asset_class: str | None = None, area: str | None =\n430:    def get_current_state(self, id_or_tag: str) -> CurrentState | None:\n435:    def get_telemetry(self, id_or_tag: str, limit: int = 50) -> list[Telemet\n443:    def get_events(\n456:    def get_maintenance(self, id_or_tag: str) -> list[WorkOrder]:\n463:    def get_service_cases(\n476:    def get_doc(self, doc_id: str) -> KnowledgeDoc | None:\n480:    def list_docs(self, scope: str | None = None) -> list[KnowledgeDoc]:\n488:    def get_data_quality(self, id_or_tag: str) -> list[DataQualityIssue]:\n493:    def get_faulty_target(self) -> tuple[Asset | None, CurrentState | None]:","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"022ea40e-ac56-4a6d-9f0b-11b31ffa2b58","context":{"git_state":{"cwd":"/home/viktor-trilar/Projects/Newbies/.claude/worktrees/agent-aef4b903dc16194fa","root":"/home/viktor-trilar/Projects/Newbies/.claude/worktrees/agent-aef4b903dc16194fa","branch":"viktor/viewer-and-val","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Sairanyx/Newbies","vi