{"parentUuid":"df15bd6f-354c-4fe1-87a9-4bf3c3eac189","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgobdQ8mT3A9GeeFtAUKg","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"I'm rewriting the Plan screen next: colors matching BIM mode, dashed outlines for movable objects, no stacked names, and type search that highlights every match.\n\n","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10608,"cache_read_input_tokens":272202,"output_tokens":23557,"output_tokens_details":{"thinking_tokens":9521},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":10608,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":23557,"cache_read_input_tokens":272202,"cache_creation_input_tokens":10608,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10608},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":6,"thinkingDisplay":"updates","serverClassifierRequest":"eba44f9e-c6f5-435b-9f40-695f26c6404b","apiBlockIndex":1,"requestId":"req_011CgobdPsA6Btdytmqs66Hi","requestRef":"d605822d-155d-4889-9e72-f3e3f933b2ce","requestedModel":"claude-opus-5-5","promptCacheRequested":"1h","type":"assistant","uuid":"ab0f5a33-01b8-40a7-9566-c32bab1fbf3b","timestamp":"2026-11-07T12:52:39.744Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-vscode","cwd":"/home/viktor-trilar/Projects/Newbies","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","version":"2.1.319","gitBranch":"viktor/bim","slug":"vast-jumping-lobster"}
{"parentUuid":"ab0f5a33-01b8-40a7-9566-c32bab1fbf3b","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgobdQ8mT3A9GeeFtAUKg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012X5RhUEXCVDSTN4SQmpK7R","name":"Bash","input":{"command":"cd /home/viktor-trilar/Projects/Newbies; cat > web/plan.js <<'EOF'\n// Bird's-eye floor layout: the room from above, with objects, the route, and where you are.\n// Generated from the scan, not surveyed, and it says so on screen.\n\nconst PADDING = 16;\nconst LABEL_HEIGHT = 16;\nconst FAULT_COLOR = \"#ff2d2d\";\nconst LINKED_COLOR = \"#ffffff\";\nconst FOUND_COLOR = \"#facc15\";\nconst ROUTE_COLOR = \"#22d3ee\";\nconst OTHER_COLOR = \"#9ca3af\";\n// The same colours as BIM mode, so a type looks the same in both.\nconst TYPE_COLORS = {\n  tank: \"#22c55e\",\n  pump: \"#f59e0b\",\n  valve: \"#a855f7\",\n  pipe: \"#3b82f6\",\n  hose: \"#3b82f6\",\n  \"pipe fitting\": \"#93c5fd\",\n  cable: \"#eab308\",\n  \"electrical cabinet\": \"#14b8a6\",\n  \"light fixture\": \"#fde68a\",\n  sensor: \"#ec4899\",\n  gauge: \"#ec4899\",\n  chair: \"#b45309\",\n  shelf: \"#b45309\",\n};\nconst LEGEND = [\n  [\"Faulty device\", FAULT_COLOR],\n  [\"Linked to a record\", LINKED_COLOR],\n  [\"Tank\", TYPE_COLORS.tank],\n  [\"Pump\", TYPE_COLORS.pump],\n  [\"Valve\", TYPE_COLORS.valve],\n  [\"Cabinet\", TYPE_COLORS[\"electrical cabinet\"]],\n  [\"Furniture\", TYPE_COLORS.chair],\n  [\"Other\", OTHER_COLOR],\n];\nconst HIDDEN_UNLESS_ASKED = new Set([\"pipe\", \"pipe fitting\", \"cable\", \"hose\", \"light fixture\"]);\n\nexport function setupPlan({\n  ui,\n  objects,\n  root,\n  camera,\n  route,\n  getFaultTag,\n  getSelected,\n  nameOf,\n  onSelect,\n}) {\n  const context = ui.canvas.getContext(\"2d\");\n  const image = new Image();\n  const state = { open: false, ready: false, description: null, showPipes: false, found: new Set() };\n\n  function fit() {\n    const box = ui.canvas.getBoundingClientRect();\n    const ratio = window.devicePixelRatio || 1;\n    const width = Math.round(box.width * ratio);\n    const height = Math.round(box.height * ratio);\n    // Setting a canvas's size clears it, so only do that when the size has changed.\n    if (ui.canvas.width !== width || ui.canvas.height !== height) {\n      ui.canvas.width = width;\n      ui.canvas.height = height;\n    }\n    const d = state.description;\n    const scale = Math.min(\n      (box.width - 2 * PADDING) / (d.x_max - d.x_min),\n      (box.height - 2 * PADDING) / (d.z_max - d.z_min),\n    );\n    const left = (box.width - scale * (d.x_max - d.x_min)) / 2;\n    const top = (box.height - scale * (d.z_max - d.z_min)) / 2;\n    return { scale, left, top, ratio, width: box.width, height: box.height };\n  }\n\n  // +z points up the page, the way the scan's start view faces.\n  function toScreen(view, x, z) {\n    const d = state.description;\n    return [view.left + (x - d.x_min) * view.scale, view.top + (d.z_max - z) * view.scale];\n  }\n\n  function colorOf(object) {\n    if (object.asset.mapping?.tag === getFaultTag()) return FAULT_COLOR;\n    if (object.asset.mapping) return LINKED_COLOR;\n    return TYPE_COLORS[object.asset.label] ?? OTHER_COLOR;\n  }\n\n  function isHighlighted(object) {\n    return object === getSelected() || state.found.has(object);\n  }\n\n  function shown(object) {\n    if (object.gone) return false;\n    if (isHighlighted(object) || object.asset.mapping) return true;\n    return state.showPipes || !HIDDEN_UNLESS_ASKED.has(object.asset.label);\n  }\n\n  // An object's footprint on screen. Its size comes from its box, its place from where it is now.\n  function footprint(view, object) {\n    const a = object.asset;\n    const halfX = Math.abs(a.bbox_max[0] - a.bbox_min[0]) / 2;\n    const halfZ = Math.abs(a.bbox_max[2] - a.bbox_min[2]) / 2;\n    const [left, top] = toScreen(view, object.center.x - halfX, object.center.z + halfZ);\n    return { left, top, width: 2 * halfX * view.scale, height: 2 * halfZ * view.scale };\n  }\n\n  // Important names go first. A name with no free spot waits until its object is found or tapped.\n  function drawLabels(c, view, labels) {\n    c.font = \"12px system-ui, sans-serif\";\n    c.textAlign = \"left\";\n    const placed = [];\n    labels.sort((a, b) => b.rank - a.rank);\n    for (const { text, box, color, rank } of labels) {\n      const width = c.measureText(text).width + 8;\n      const middleY = box.top + box.height / 2 - LABEL_HEIGHT / 2;\n      const middleX = box.left + box.width / 2 - width / 2;\n      const spots = [\n        [middleX, box.top - LABEL_HEIGHT - 2],\n        [middleX, box.top + box.height + 2],\n        [box.left - width - 2, middleY],\n        [box.left + box.width + 2, middleY],\n      ].map(([x, y]) => [\n        Math.max(2, Math.min(x, view.width - width - 2)),\n        Math.max(2, Math.min(y, view.height - LABEL_HEIGHT - 2)),\n      ]);\n      const free = spots.find(([x, y]) =>\n        placed.every(\n          (other) =>\n            x + width < other.x ||\n            other.x + other.width < x ||\n            y + LABEL_HEIGHT < other.y ||\n            other.y + LABEL_HEIGHT < y,\n        ),\n      );\n      const spot = free ?? (rank > 1 ? spots[0] : null);\n      if (!spot) continue;\n      placed.push({ x: spot[0], y: spot[1], width });\n      c.fillStyle = \"rgba(15, 20, 25, 0.9)\";\n      c.fillRect(spot[0], spot[1], width, LABEL_HEIGHT);\n      c.fillStyle = color;\n      c.fillText(text, spot[0] + 4, spot[1] + 12);\n    }\n  }\n\n  function drawRoute(c, view) {\n    const path = route.state.route?.path;\n    if (!path?.length) return;\n    c.beginPath();\n    c.strokeStyle = ROUTE_COLOR;\n    c.lineWidth = 4;\n    path.forEach((point, index) => {\n      const [x, y] = toScreen(view, point[0], point[2]);\n      if (index) c.lineTo(x, y);\n      else c.moveTo(x, y);\n    });\n    c.stroke();\n  }\n\n  // Where you are, and which way you face.\n  function drawViewer(c, view) {\n    const here = root.worldToLocal(camera.position.clone());\n    const ahead = root.worldToLocal(\n      camera.position.clone().add(camera.getWorldDirection(here.clone())),\n    );\n    const [x, y] = toScreen(view, here.x, here.z);\n    const [aheadX, aheadY] = toScreen(view, ahead.x, ahead.z);\n    c.save();\n    c.translate(x, y);\n    c.rotate(Math.atan2(aheadY - y, aheadX - x));\n    c.beginPath();\n    c.moveTo(14, 0);\n    c.lineTo(-8, -8);\n    c.lineTo(-4, 0);\n    c.lineTo(-8, 8);\n    c.closePath();\n    c.fillStyle = ROUTE_COLOR;\n    c.strokeStyle = \"#0f1419\";\n    c.lineWidth = 2;\n    c.fill();\n    c.stroke();\n    c.restore();\n  }\n\n  // One metre, in the scan's own units, which haven't been checked on site.\n  function drawScale(c, view) {\n    const d = state.description;\n    const x = view.left + 14;\n    const y = view.top + (d.z_max - d.z_min) * view.scale - 12;\n    c.font = \"12px system-ui, sans-serif\";\n    c.textAlign = \"left\";\n    c.fillStyle = \"rgba(15, 20, 25, 0.9)\";\n    c.fillRect(x - 8, y - 24, Math.max(view.scale + 16, 120), 32);\n    c.strokeStyle = \"#f8fafc\";\n    c.lineWidth = 3;\n    c.beginPath();\n    c.moveTo(x, y);\n    c.lineTo(x + view.scale, y);\n    c.stroke();\n    c.fillStyle = \"#f8fafc\";\n    c.fillText(\"1 m, scan's scale\", x, y - 8);\n  }\n\n  function draw() {\n    if (!state.open || !state.ready) return;\n    const view = fit();\n    const c = context;\n    const d = state.description;\n    c.setTransform(view.ratio, 0, 0, view.ratio, 0, 0);\n    c.clearRect(0, 0, view.width, view.height);\n    c.drawImage(\n      image,\n      view.left,\n      view.top,\n      (d.x_max - d.x_min) * view.scale,\n      (d.z_max - d.z_min) * view.scale,\n    );\n\n    c.strokeStyle = \"#f8fafc\";\n    c.lineWidth = 3;\n    for (const wall of d.walls) {\n      c.beginPath();\n      c.moveTo(...toScreen(view, ...wall.start));\n      c.lineTo(...toScreen(view, ...wall.end));\n      c.stroke();\n    }\n\n    const labels = [];\n    for (const object of objects) {\n      if (!shown(object)) continue;\n      const box = footprint(view, object);\n      const color = colorOf(object);\n      const highlighted = isHighlighted(object);\n      c.fillStyle = `${color}33`;\n      c.fillRect(box.left, box.top, box.width, box.height);\n      c.strokeStyle = highlighted ? FOUND_COLOR : color;\n      c.lineWidth = highlighted || color === FAULT_COLOR ? 3 : 1.5;\n      c.setLineDash(object.asset.mobility === \"movable\" ? [5, 4] : []);\n      c.strokeRect(box.left, box.top, box.width, box.height);\n      if (object.asset.mapping || highlighted) {\n        const rank = highlighted ? 3 : color === FAULT_COLOR ? 2 : 1;\n        labels.push({ text: nameOf(object), box, color, rank });\n      }\n    }\n    c.setLineDash([]);\n\n    drawRoute(c, view);\n    drawLabels(c, view, labels);\n    drawViewer(c, view);\n    drawScale(c, view);\n  }\n\n  function objectAt(view, x, y) {\n    const near = 6; // pixels of tolerance, for small objects under a finger\n    let best = null;\n    let bestArea = Infinity;\n    for (const object of objects) {\n      if (!shown(object)) continue;\n      const box = footprint(view, object);\n      const inside =\n        x >= box.left - near &&\n        x <= box.left + box.width + near &&\n        y >= box.top - near &&\n        y <= box.top + box.height + near;\n      if (inside && box.width * box.height < bestArea) {\n        best = object;\n        bestArea = box.width * box.height;\n      }\n    }\n    return best;\n  }\n\n  ui.canvas.addEventListener(\"click\", (event) => {\n    if (!state.ready) return;\n    const box = ui.canvas.getBoundingClientRect();\n    const found = objectAt(fit(), event.clientX - box.left, event.clientY - box.top);\n    if (found) onSelect(found);\n  });\n\n  function search(text) {\n    const wanted = text.trim().toLowerCase();\n    state.found.clear();\n    ui.note.textContent = \"\";\n    if (!wanted) return;\n    const here = objects.filter((object) => !object.gone);\n    const byTag = here.filter(\n      (object) =>\n        (object.asset.mapping?.tag ?? \"\").toLowerCase().includes(wanted) ||\n        object.asset.object_id.toLowerCase() === wanted,\n    );\n    const byType = here.filter((object) => object.asset.label?.toLowerCase() === wanted);\n    const matches = byTag.length ? byTag : byType;\n    for (const object of matches) state.found.add(object);\n    if (!matches.length) ui.note.textContent = \"Nothing with that tag or type.\";\n    else if (matches.length === 1) ui.note.textContent = `Found ${nameOf(matches[0])}.`;\n    else ui.note.textContent = `Found ${matches.length}.`;\n  }\n  ui.search.addEventListener(\"input\", () => search(ui.search.value));\n\n  ui.pipes.onclick = () => {\n    state.showPipes = !state.showPipes;\n    ui.pipes.textContent = state.showPipes ? \"Hide pipes\" : \"Show pipes\";\n  };\n\n  for (const [text, color] of LEGEND) {\n    const item = document.createElement(\"span\");\n    const swatch = document.createElement(\"i\");\n    swatch.style.background = color;\n    item.append(swatch, text);\n    ui.legend.append(item);\n  }\n  const dashed = document.createElement(\"span\");\n  const sample = document.createElement(\"i\");\n  sample.className = \"dashed\";\n  dashed.append(sample, \"Dashed: can move\");\n  ui.legend.append(dashed);\n\n  async function open() {\n    state.open = true;\n    ui.panel.hidden = false;\n    if (state.ready) return;\n    ui.note.textContent = \"Building the layout...\";\n    try {\n      const response = await fetch(\"/api/plan\");\n      const reply = await response.json().catch(() => ({}));\n      if (!response.ok) throw new Error(reply.detail ?? `backend error ${response.status}`);\n      state.description = reply;\n      image.src = \"/api/plan/floor.png\";\n      await image.decode();\n      state.ready = true;\n      ui.dxf.hidden = false;\n      ui.note.textContent = \"\";\n    } catch (error) {\n      ui.note.textContent = `Couldn't build the layout: ${error.message}.`;\n    }\n  }\n\n  function close() {\n    state.open = false;\n    ui.panel.hidden = true;\n  }\n\n  return { state, open, close, draw, search };\n}\nEOF\npython3 - <<'EOF'\ndef patch(path, pairs):\n    text = open(path).read()\n    for old, new in pairs:\n        assert old in text, (path, old[:70])\n        text = text.replace(old, new, 1)\n    open(path, \"w\").write(text)\n\npatch(\"web/main.js\", [\n(\"\"\"function name(asset) {\n  const link = asset.mapping;\n  if (!link) return asset.label;\n  return link.method?.startsWith(\"procedural\") ? `${link.tag}?` : link.tag;\n}\"\"\", \"\"\"// A link made by rule or by eye is a guess, so it reads as a question.\nfunction name(asset) {\n  const link = asset.mapping;\n  if (!link) return asset.label;\n  const method = link.method ?? \"\";\n  const guess = method.startsWith(\"procedural\") || method.includes(\"unconfirmed\");\n  return guess ? `${link.tag}?` : link.tag;\n}\"\"\"),\n(\"\"\"  if (!phone.enabled && !busy) controls.update(camera);\"\"\",\n \"\"\"  // Typing in the Plan screen's search box shouldn't walk the viewer around.\n  if (!phone.enabled && !busy && !plan?.state.open) controls.update(camera);\"\"\"),\n(\"\"\"      note: $(\"plan-note\"),\n    },\"\"\", \"\"\"      note: $(\"plan-note\"),\n      dxf: $(\"plan-dxf\"),\n    },\"\"\"),\n(\"\"\"    getSelected: () => selected,\n    onSelect: showInfo,\n  });\n  $(\"open-plan\").onclick = () => plan.open();\n  $(\"plan-close\").onclick = () => plan.close();\n\"\"\", \"\"\"    getSelected: () => selected,\n    nameOf: (object) => name(object.asset),\n    onSelect: showInfo,\n  });\n  $(\"open-plan\").onclick = () => plan.open();\n  $(\"plan-close\").onclick = () => plan.close();\n  // These work in the 3D view, so the Plan screen makes way for them.\n  for (const id of [\"move\", \"split-object\", \"combine-object\"]) {\n    $(id).addEventListener(\"click\", () => plan.close());\n  }\n\"\"\"),\n])\n\npatch(\"web/index.html\", [\n(\"\"\"<a id=\"plan-dxf\" href=\"/api/plan/layout.dxf\" download>Download DXF</a>\"\"\",\n \"\"\"<a id=\"plan-dxf\" href=\"/api/plan/layout.dxf\" download=\"floor_layout.dxf\" hidden>Download DXF</a>\"\"\"),\n])\n\npatch(\"web/style.css\", [\n(\"\"\"#plan-canvas {\n\"\"\", \"\"\"#plan-dxf[hidden] {\n  display: none;\n}\n#plan-canvas {\n\"\"\"),\n(\"\"\"#plan-legend i {\n  display: inline-block;\n  width: 10px;\n  height: 10px;\n  margin-right: 4px;\n  border-radius: 2px;\n}\n\"\"\", \"\"\"#plan-legend i {\n  display: inline-block;\n  width: 10px;\n  height: 10px;\n  margin-right: 4px;\n  border-radius: 2px;\n}\n#plan-legend i.dashed {\n  box-sizing: border-box;\n  border: 1px dashed #9ca3af;\n  border-radius: 0;\n}\n/* The object panel opens over the Plan screen, below its search bar. */\nbody:has(#plan:not([hidden])) #info {\n  top: 68px;\n  z-index: 5;\n  max-height: calc(100vh - 80px);\n  overflow-y: auto;\n}\nbody:has(#plan:not([hidden])) #copilot {\n  z-index: 5;\n}\n\"\"\"),\n])\n\npatch(\"web/serve.py\", [\n(\"\"\"            with urllib.request.urlopen(request, timeout=30) as response:\n                status, body = response.status, response.read()\n        except urllib.error.HTTPError as error:\n            status, body = error.code, error.read()\n        except urllib.error.URLError:\n            status, body = 502, b'{\"detail\": \"The backend isn\\\\'t running: start it with make api\"}'\n        self.send_response(status)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n\"\"\", \"\"\"            with urllib.request.urlopen(request, timeout=30) as response:\n                status, body, headers = response.status, response.read(), response.headers\n        except urllib.error.HTTPError as error:\n            status, body, headers = error.code, error.read(), error.headers\n        except urllib.error.URLError:\n            status, headers = 502, {}\n            body = b'{\"detail\": \"The backend isn\\\\'t running: start it with make api\"}'\n        self.send_response(status)\n        self.send_header(\"Content-Type\", headers.get(\"Content-Type\", \"application/json\"))\n        if headers.get(\"Content-Disposition\"):\n            self.send_header(\"Content-Disposition\", headers[\"Content-Disposition\"])\n        self.send_header(\"Content-Length\", str(len(body)))\n\"\"\"),\n])\n\npatch(\"app/plan/layout.py\", [\n('''\"\"\"Make a top-down floor layout from a scan: a floor image, fitted walls, and object footprints.\n\nIt's generated from the scan, not surveyed. Walls are fitted to what the scan saw, and a wall with\nlittle evidence is marked `assumed`. Scale is the scan's own, which hasn't been checked on site.\n\"\"\"\n\nfrom dataclasses import dataclass\n\nimport numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\n\nfrom app.scene.load import Splats\n''', '''\"\"\"Make a top-down floor layout from a scan: a floor image, walls, and object footprints.\n\nIt's generated from the scan, not surveyed. The walls are the same room estimate the BIM model uses,\nand the scale is the scan's own, which hasn't been checked on site.\n\"\"\"\n\nimport numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\n\nfrom app.bim.room import estimate_room\nfrom app.scene.load import Splats\n'''),\n(\"\"\"WALL_CELL = 0.05\nWALL_MIN_SHARE = 0.25  # share of a side's length a wall line must cover to count as seen\nWALL_SEARCH = 0.25  # share of the room from each edge in which to look for its wall\n\"\"\", \"\"),\n(\"\"\"@dataclass\nclass Wall:\n    start: tuple[float, float]  # (x, z) in scene coordinates\n    end: tuple[float, float]\n    support: float  # share of its length where the scan saw something\n    assumed: bool\n\n\n\"\"\", \"\"),\n])\ntext = open(\"app/plan/layout.py\").read()\nstart = text.index(\"def fit_walls(\")\nend = text.index(\"def build_layout(\")\ntext = text[:start] + text[end:]\nold = '''    \"\"\"Return the floor image and a description: its extent in scene coordinates, and the walls.\"\"\"\n'''\nnew = '''    \"\"\"Return the floor image and a description: its extent in scene coordinates, and the room.\"\"\"\n'''\nassert old in text; text = text.replace(old, new, 1)\nold = \"\"\"    standing = solid & (heights > BODY_BAND[0]) & (heights < BODY_BAND[1])\n    low = np.percentile(flat[standing], 0.5, axis=0)\n    high = np.percentile(flat[standing], 99.5, axis=0)\n    walls = fit_walls(flat[standing], low, high)\n\n    corners = np.array([point for wall in walls for point in (wall.start, wall.end)])\n    origin = corners.min(axis=0) - EDGE_MARGIN\n    top = corners.max(axis=0) + EDGE_MARGIN\n\"\"\"\nnew = \"\"\"    standing = solid & (heights > BODY_BAND[0]) & (heights < BODY_BAND[1])\n\n    room = estimate_room(positions, splats.opacities, list(up), floor_y * sign)\n    faces, support = room[\"faces\"], room[\"wall_support\"]\n    room_low = np.array([faces[\"first_min\"], faces[\"second_min\"]])\n    room_high = np.array([faces[\"first_max\"], faces[\"second_max\"]])\n    origin = room_low - EDGE_MARGIN\n    top = room_high + EDGE_MARGIN\n\"\"\"\nassert old in text; text = text.replace(old, new, 1)\nold = \"\"\"    room_low = corners.min(axis=0)\n    room_high = corners.max(axis=0)\n    xs = origin\"\"\"\nnew = \"\"\"    xs = origin\"\"\"\nassert old in text; text = text.replace(old, new, 1)\nold = \"\"\"    description = {\n        \"x_min\": float(origin[0]),\"\"\"\nnew = \"\"\"    x0, z0 = room_low.tolist()\n    x1, z1 = room_high.tolist()\n    description = {\n        \"x_min\": float(origin[0]),\"\"\"\nassert old in text; text = text.replace(old, new, 1)\nold = \"\"\"        \"walls\": [\n            {\"start\": list(w.start), \"end\": list(w.end), \"support\": w.support, \"assumed\": w.assumed}\n            for w in walls\n        ],\n\"\"\"\nnew = \"\"\"        \"room\": room,\n        \"walls\": [\n            {\"start\": [x0, z0], \"end\": [x1, z0], \"support\": support[\"second_min\"]},\n            {\"start\": [x1, z0], \"end\": [x1, z1], \"support\": support[\"first_max\"]},\n            {\"start\": [x1, z1], \"end\": [x0, z1], \"support\": support[\"second_max\"]},\n            {\"start\": [x0, z1], \"end\": [x0, z0], \"support\": support[\"first_min\"]},\n        ],\n\"\"\"\nassert old in text; text = text.replace(old, new, 1)\nopen(\"app/plan/layout.py\", \"w\").write(text)\n\npatch(\"app/plan/export_dxf.py\", [\n(\"\"\"from app.plan.layout import plan_axes\n\"\"\", \"\"\"from app.bim.model import identity_confirmed\nfrom app.plan.layout import plan_axes\n\"\"\"),\n(\"\"\"COLORS = {\"WALLS\": 7, \"WALLS_ASSUMED\": 1, \"FAULT\": 1,\"\"\", \"\"\"COLORS = {\"WALLS\": 7, \"FAULT\": 1,\"\"\"),\n(\"\"\"        layer = \"WALLS_ASSUMED\" if wall[\"assumed\"] else \"WALLS\"\n        body += _line(layer, tuple(wall[\"start\"]), tuple(wall[\"end\"]))\n\"\"\", \"\"\"        body += _line(\"WALLS\", tuple(wall[\"start\"]), tuple(wall[\"end\"]))\n\"\"\"),\n(\"\"\"            method = str(asset[\"mapping\"].get(\"method\") or \"\")\n            shown = f\"{tag}?\" if method.startswith(\"procedural\") else tag\n\"\"\", \"\"\"            shown = tag if identity_confirmed(asset[\"mapping\"]) else f\"{tag}?\"\n\"\"\"),\n])\n\npatch(\"app/bim/ifc.py\", [\n(\"\"\"def write_ifc(model: dict, path: Path, timestamp: str | None = None) -> None:\n    rotation, floor\"\"\", \"\"\"def ifc_text(model: dict, file_name: str = \"model.ifc\", timestamp: str | None = None) -> str:\n    \\\"\\\"\\\"Return a BIM model as the text of an IFC4 STEP file.\\\"\\\"\\\"\n    rotation, floor\"\"\"),\n(\"\"\"        f\"FILE_NAME({string(path.name)},'{stamp}',(''),(''),'','app.bim','');\",\"\"\",\n \"\"\"        f\"FILE_NAME({string(file_name)},'{stamp}',(''),(''),'','app.bim','');\",\"\"\"),\n(\"\"\"    path.write_text(\"\\\\n\".join(header + body + [\"ENDSEC;\", \"END-ISO-10303-21;\", \"\"]))\"\"\",\n \"\"\"    return \"\\\\n\".join(header + body + [\"ENDSEC;\", \"END-ISO-10303-21;\", \"\"])\n\n\ndef write_ifc(model: dict, path: Path, timestamp: str | None = None) -> None:\n    path.write_text(ifc_text(model, path.name, timestamp))\"\"\"),\n])\n\npatch(\"app/bim/model.py\", [\n(\"\"\"            \"IdentityConfirmed\": identity_confirmed(mapping),\n\"\"\", \"\"\"            \"IdentityConfirmed\": identity_confirmed(mapping),\n            \"Status\": asset.get(\"status\"),\n\"\"\"),\n])\n\npatch(\"web/bim.js\", [\n(\"\"\"    guid: \"none in the file\",\n\"\"\", \"\"\"    guid: \"assigned on export\",\n\"\"\"),\n(\"\"\"  function setActive(on) {\n    state.active = on;\n    group.visible = on;\n    panel.hidden = !on;\n  }\n\"\"\", \"\"\"  function setActive(on) {\n    state.active = on;\n    group.visible = on;\n    panel.hidden = !on;\n    if (on) chooseDownload();\n  }\n\n  // The backend's copy shows the model as it stands now. Without one, there's still the built file.\n  async function chooseDownload() {\n    const reply = await fetch(\"/api/plan\").catch(() => null);\n    document.getElementById(\"bim-download\").href = reply?.ok ? \"/api/plan/model.ifc\" : \"model.ifc\";\n  }\n\"\"\"),\n])\n\npatch(\"app/api/main.py\", [\n(\"\"\"import io\nimport os\n\"\"\", \"\"\"import io\nimport json\nimport os\n\"\"\"),\n(\"\"\"from app.api.store import GONE, ChangeError, SceneStore\n\"\"\", \"\"\"from app.api.store import GONE, ChangeError, SceneStore\nfrom app.bim.ifc import ifc_text\nfrom app.bim.model import build_model\n\"\"\"),\n(\"\"\"            image, description = build_layout(splats_for_selection(), floor_y, up)\n            buffer = io.BytesIO()\"\"\", \"\"\"            try:\n                image, description = build_layout(splats_for_selection(), floor_y, up)\n            except ValueError as error:\n                raise HTTPException(503, f\"Couldn't work out the room: {error}\") from error\n            buffer = io.BytesIO()\"\"\"),\n(\"\"\"        \\\"\\\"\\\"Describe the floor layout: its extent, and the walls fitted to the scan.\\\"\\\"\\\"\n\"\"\", \"\"\"        \\\"\\\"\\\"Describe the floor layout: its extent, and the room estimated from the scan.\\\"\\\"\\\"\n\"\"\"),\n(\"\"\"    @app.post(\"/api/changes/reset\")\n\"\"\", \"\"\"    def shapes_where_they_stand() -> dict[str, dict]:\n        \\\"\\\"\\\"Return the fitted shapes of objects still in the room, moved along with them.\\\"\\\"\\\"\n        path = store.path.with_name(\"shapes.json\")\n        shapes = json.loads(path.read_text()) if path.exists() else {}\n        placed = {}\n        for asset in store.visible():\n            object_id = asset[\"object_id\"]\n            if object_id in shapes:\n                shift = np.subtract(asset[\"center\"], store.home_box(object_id)[\"center\"])\n                center = np.add(shapes[object_id][\"center\"], shift).tolist()\n                placed[object_id] = {**shapes[object_id], \"center\": center}\n        return placed\n\n    @app.get(\"/api/plan/model.ifc\")\n    def plan_ifc() -> Response:\n        \\\"\\\"\\\"Return the BIM model for BIM tools, with objects as they stand now.\\\"\\\"\\\"\n        document = {**store.scene, \"scene_id\": store.scene_id, \"assets\": store.visible()}\n        room = plan_layout()[\"description\"][\"room\"]\n        model = build_model(document, shapes_where_they_stand(), room)\n        headers = {\"Content-Disposition\": 'attachment; filename=\"model.ifc\"'}\n        return Response(ifc_text(model), media_type=\"application/x-step\", headers=headers)\n\n    @app.post(\"/api/changes/reset\")\n\"\"\"),\n(\"\"\"raise HTTPException(503, \"Selecting needs the scene: set SCENE_PLY to its file.\")\"\"\",\n \"\"\"raise HTTPException(503, \"This needs the scene: set SCENE_PLY to its file.\")\"\"\"),\n])\n\npatch(\"docs/USAGE.md\", [\n(\"\"\"Objects you move follow in BIM mode. Objects added, split or combined in the viewer show as plain\nsee-through boxes. **Download IFC** saves the model as `make bim` built it, without any of those\nchanges: they stay in the backend, so running `make bim` again doesn't add them.\n\"\"\", \"\"\"Objects you move follow in BIM mode. Objects added, split or combined in the viewer show as plain\nsee-through boxes. With the backend running, **Download IFC** saves the model as it stands now,\nincluding all of those changes. Without it, you get the file `make bim` built, which has none of them.\n\"\"\"),\n(\"\"\"Press **Plan** for the room from above: walls, objects by type, the route, and an arrow showing where you are.\n- **Find:** type a tag or type, such as `P-005` or `tank`.\n\"\"\", \"\"\"Press **Plan** for the room from above: walls, objects by type, the route, and an arrow showing where you are.\nColours match BIM mode, and a dashed outline means the object can be moved.\n- **Find:** type a tag or type. `P-005` highlights one object, and `tank` highlights them all.\n\"\"\"),\n(\"\"\"`make bim` writes an IFC model of the walls and objects for BIM tools, with each object's label and link in its\nproperties. Both are generated from the scan, not surveyed. Objects are boxes, and the scale hasn't been checked\non site. Without good evidence for a label, an object stays generic in the IFC. Needs `make api` and\n`Equipment Room.ply`.\n\"\"\", \"\"\"It's generated from the scan, not surveyed: objects are boxes, and the scale hasn't been checked on site. A name\nwith no room to show stays hidden until you find or tap its object. Needs `make api` and `Equipment Room.ply`.\n\"\"\"),\n])\n\npatch(\"README.md\", [\n(\"\"\"| `make bim` | Write a review IFC model of the objects and walls |\"\"\",\n \"\"\"| `make bim` | Build the simulated BIM model for BIM mode, and its IFC file |\"\"\"),\n])\n\ntest = open(\"tests/test_plan.py\").read()\ndef cut(text, start, end):\n    a = text.index(start); b = text.index(end, a)\n    return text[:a] + text[b:]\ntest = test.replace(\"\"\"from app.plan.export_dxf import layer_for, write_dxf  # noqa: E402\nfrom app.plan.export_ifc import ifc_class_for, to_model  # noqa: E402\nfrom app.plan.layout import build_layout, fit_walls  # noqa: E402\n\"\"\", \"\"\"from app.bim.room import estimate_room  # noqa: E402\nfrom app.plan.export_dxf import layer_for, write_dxf  # noqa: E402\nfrom app.plan.layout import build_layout  # noqa: E402\n\"\"\")\ntest = test.replace('''def room_points(open_side=False):\n    \"\"\"A 6 x 4 m room: walls at x = 0 and 6, z = 0 and 4, and a machine in the middle.\"\"\"\n    random = np.random.default_rng(0)\n    groups = [\n        random.uniform([0, 0], [0.05, 4], (3000, 2)),\n        random.uniform([5.95, 0], [6, 4], (3000, 2)),\n        random.uniform([0, 0], [6, 0.05], (3000, 2)),\n        random.uniform([2.5, 1.5], [3.5, 2.5], (3000, 2)),\n    ]\n    if not open_side:\n        groups.append(random.uniform([0, 3.95], [6, 4], (3000, 2)))\n    return np.concatenate(groups)\n''', '''def room_points():\n    \"\"\"A 6 x 4 m room: walls at x = 0 and 6, z = 0 and 4, and a machine in the middle.\"\"\"\n    random = np.random.default_rng(0)\n    groups = [\n        random.uniform([0, 0], [0.05, 4], (3000, 2)),\n        random.uniform([5.95, 0], [6, 4], (3000, 2)),\n        random.uniform([0, 0], [6, 0.05], (3000, 2)),\n        random.uniform([0, 3.95], [6, 4], (3000, 2)),\n        random.uniform([2.5, 1.5], [3.5, 2.5], (3000, 2)),\n    ]\n    return np.concatenate(groups)\n''')\ntest = cut(test, \"def test_walls_are_found_outside_the_things_in_the_room():\", \"def scene_splats():\")\ntest = test.replace('''def test_layout_has_an_image_and_the_room_extent():''', '''def test_walls_are_the_room_estimate_the_bim_model_uses():\n    splats = scene_splats()\n    _, description = build_layout(splats, FLOOR_Y)\n    positions = splats.positions.astype(np.float64)\n    assert description[\"room\"] == estimate_room(\n        positions, splats.opacities, [0.0, -1.0, 0.0], -FLOOR_Y\n    )\n    xs = [p[0] for wall in description[\"walls\"] for p in (wall[\"start\"], wall[\"end\"])]\n    zs = [p[1] for wall in description[\"walls\"] for p in (wall[\"start\"], wall[\"end\"])]\n    assert min(xs) == pytest.approx(0, abs=0.1) and max(xs) == pytest.approx(6, abs=0.1)\n    assert min(zs) == pytest.approx(0, abs=0.1) and max(zs) == pytest.approx(4, abs=0.1)\n\n\ndef test_layout_has_an_image_and_the_room_extent():''')\ntest = test.replace('''    assert \"M-001?\" in text and \"\\\\nP-005\\\\n\" in text  # Procedural links are shown as questions.\n    assert \"NOT SURVEYED\" in text\n''', '''    assert \"M-001?\" in text and \"P-005?\" in text  # Links made by rule or by eye are questions.\n    assert \"NOT SURVEYED\" in text\n    confirmed = asset(\"d\", mapping={\"tag\": \"T-1\", \"method\": \"nameplate\"})\n    assert \"\\\\nT-1\\\\n\" in write_dxf(description, [confirmed])\n''')\ntest = cut(test, \"def test_only_labels_with_evidence_get_a_specific_ifc_type():\", \"def plan_client(tmp_path, monkeypatch):\")\ntest = test.replace('''    document = {\"scene_id\": \"t\", \"floor_y\": FLOOR_Y, \"fault_tag\": \"P-005\", \"assets\": [asset(\"a\")]}\n    path.write_text(json.dumps(document))\n    return TestClient(create_app(path, engine=False, database=False))\n''', '''    assets = [asset(\"a\"), asset(\"b\")]\n    document = {\"scene_id\": \"t\", \"floor_y\": FLOOR_Y, \"fault_tag\": \"P-005\", \"assets\": assets}\n    path.write_text(json.dumps(document))\n    (tmp_path / \"shapes.json\").write_text(json.dumps({\"a\": CYLINDER}))\n    return TestClient(create_app(path, engine=False, database=False))\n''')\ntest = test.replace('''def plan_client(tmp_path, monkeypatch):''', '''CYLINDER = {\n    \"type\": \"cylinder\",\n    \"center\": [1.5, 0.75, 1.5],\n    \"axis\": [0.0, -1.0, 0.0],\n    \"radius\": 0.4,\n    \"height\": 0.5,\n    \"score\": 0.9,\n    \"use_shape\": True,\n}\n\n\ndef plan_client(tmp_path, monkeypatch):''')\ntest = test.replace('''def test_plan_without_a_scene_says_what_is_missing(tmp_path, monkeypatch):''', '''def test_ifc_download_shows_the_model_as_it_stands_now(tmp_path, monkeypatch):\n    client = plan_client(tmp_path, monkeypatch)\n    response = client.get(\"/api/plan/model.ifc\")\n    assert response.status_code == 200 and response.text.startswith(\"ISO-10303-21;\")\n    assert 'filename=\"model.ifc\"' in response.headers[\"content-disposition\"]\n    assert \"(b)\" in response.text\n    assert client.post(\"/api/changes\", json={\"op\": \"remove\", \"object_id\": \"b\"}).status_code == 200\n    added = client.post(\"/api/changes\", json={\"op\": \"add\", \"position\": [4, 0.5, 2]}).json()\n    text = client.get(\"/api/plan/model.ifc\").text\n    assert \"(b)\" not in text and f\"({added['change']['object_id']})\" in text\n    assert \"new, unconfirmed\" in text\n\n\ndef test_moved_object_keeps_its_fitted_shape_in_the_ifc(tmp_path, monkeypatch):\n    ifcopenshell = pytest.importorskip(\"ifcopenshell\")\n    import ifcopenshell.geom\n\n    client = plan_client(tmp_path, monkeypatch)\n    move = {\"op\": \"move\", \"object_id\": \"a\", \"position\": [3.5, 0.75, 3.0]}\n    assert client.post(\"/api/changes\", json=move).status_code == 200\n    path = tmp_path / \"model.ifc\"\n    path.write_text(client.get(\"/api/plan/model.ifc\").text)\n    model = ifcopenshell.open(str(path))\n    element = next(e for e in model.by_type(\"IfcElement\") if \"(a)\" in (e.Name or \"\"))\n    settings = ifcopenshell.geom.settings()\n    settings.set(\"use-world-coords\", True)\n    shape = ifcopenshell.geom.create_shape(settings, element).geometry\n    points = np.array(shape.verts).reshape(-1, 3)\n    # IFC's X and Y are the scene's x and z. The cylinder is 0.8 m across, around where it stands now.\n    np.testing.assert_allclose((points.min(axis=0) + points.max(axis=0))[:2] / 2, [3.5, 3.0], atol=0.01)\n    np.testing.assert_allclose((points.max(axis=0) - points.min(axis=0))[:2], [0.8, 0.8], atol=0.01)\n\n\ndef test_plan_without_a_scene_says_what_is_missing(tmp_path, monkeypatch):''')\ntest = test.replace('''    assert response.status_code == 503 and \"SCENE_PLY\" in response.json()[\"detail\"]\n''', '''    assert response.status_code == 503 and \"SCENE_PLY\" in response.json()[\"detail\"]\n    assert client.get(\"/api/plan/model.ifc\").status_code == 503\n''')\nopen(\"tests/test_plan.py\", \"w\").write(test)\nEOF\ngrep -n \"added\\b\\|\\\"change\\\"\" tests/test_api.py | head -5 | cut -c1-110; sed -n 140,144p web/style.css | cut -c1-50; sed -n 222,228p web/style.css | cut -c1-50; uv run --no-project --with numpy --with scipy --with pandas --with openpyxl --with pytest --with fastapi --with httpx --with pillow --with 'psycopg[binary]' --with ifcopenshell --with ezdxf pytest -q tests/test_plan.py tests/test_bim.py tests/test_primitives.py 2>&1 | tail -22 | cut -c1-130; make lint 2>&1 | tail -6 | cut -c1-110","description":"Apply the Plan, walls, live IFC and proxy changes, then run the tests","timeout":240000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10608,"cache_read_input_tokens":272202,"output_tokens":23557,"output_tokens_details":{"thinking_tokens":9521},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":10608,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":23557,"cache_read_input_tokens":272202,"cache_creation_input_tokens":10608,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10608},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"toolInputStreamMs":90530,"wireToolInputs":{"toolu_012X5RhUEXCVDSTN4SQmpK7R":{"command":"cd /home/viktor-trilar/Projects/Newbies; cat > web/plan.js <<'EOF'\n// Bird's-eye floor layout: the room from above, with objects, the route, and where you are.\n// Generated from the scan, not surveyed, and it says so on screen.\n\nconst PADDING = 16;\nconst LABEL_HEIGHT = 16;\nconst FAULT_COLOR = \"#ff2d2d\";\nconst LINKED_COLOR = \"#ffffff\";\nconst FOUND_COLOR = \"#facc15\";\nconst ROUTE_COLOR = \"#22d3ee\";\nconst OTHER_COLOR = \"#9ca3af\";\n// The same colours as BIM mode, so a type looks the same in both.\nconst TYPE_COLORS = {\n  tank: \"#22c55e\",\n  pump: \"#f59e0b\",\n  valve: \"#a855f7\",\n  pipe: \"#3b82f6\",\n  hose: \"#3b82f6\",\n  \"pipe fitting\": \"#93c5fd\",\n  cable: \"#eab308\",\n  \"electrical cabinet\": \"#14b8a6\",\n  \"light fixture\": \"#fde68a\",\n  sensor: \"#ec4899\",\n  gauge: \"#ec4899\",\n  chair: \"#b45309\",\n  shelf: \"#b45309\",\n};\nconst LEGEND = [\n  [\"Faulty device\", FAULT_COLOR],\n  [\"Linked to a record\", LINKED_COLOR],\n  [\"Tank\", TYPE_COLORS.tank],\n  [\"Pump\", TYPE_COLORS.pump],\n  [\"Valve\", TYPE_COLORS.valve],\n  [\"Cabinet\", TYPE_COLORS[\"electrical cabinet\"]],\n  [\"Furniture\", TYPE_COLORS.chair],\n  [\"Other\", OTHER_COLOR],\n];\nconst HIDDEN_UNLESS_ASKED = new Set([\"pipe\", \"pipe fitting\", \"cable\", \"hose\", \"light fixture\"]);\n\nexport function setupPlan({\n  ui,\n  objects,\n  root,\n  camera,\n  route,\n  getFaultTag,\n  getSelected,\n  nameOf,\n  onSelect,\n}) {\n  const context = ui.canvas.getContext(\"2d\");\n  const image = new Image();\n  const state = { open: false, ready: false, description: null, showPipes: false, found: new Set() };\n\n  function fit() {\n    const box = ui.canvas.getBoundingClientRect();\n    const ratio = window.devicePixelRatio || 1;\n    const width = Math.round(box.width * ratio);\n    const height = Math.round(box.height * ratio);\n    // Setting a canvas's size clears it, so only do that when the size has changed.\n    if (ui.canvas.width !== width || ui.canvas.height !== height) {\n      ui.canvas.width = width;\n      ui.canvas.height = height;\n    }\n    const d = state.description;\n    const scale = Math.min(\n      (box.width - 2 * PADDING) / (d.x_max - d.x_min),\n      (box.height - 2 * PADDING) / (d.z_max - d.z_min),\n    );\n    const left = (box.width - scale * (d.x_max - d.x_min)) / 2;\n    const top = (box.height - scale * (d.z_max - d.z_min)) / 2;\n    return { scale, left, top, ratio, width: box.width, height: box.height };\n  }\n\n  // +z points up the page, the way the scan's start view faces.\n  function toScreen(view, x, z) {\n    const d = state.description;\n    return [view.left + (x - d.x_min) * view.scale, view.top + (d.z_max - z) * view.scale];\n  }\n\n  function colorOf(object) {\n    if (object.asset.mapping?.tag === getFaultTag()) return FAULT_COLOR;\n    if (object.asset.mapping) return LINKED_COLOR;\n    return TYPE_COLORS[object.asset.label] ?? OTHER_COLOR;\n  }\n\n  function isHighlighted(object) {\n    return object === getSelected() || state.found.has(object);\n  }\n\n  function shown(object) {\n    if (object.gone) return false;\n    if (isHighlighted(object) || object.asset.mapping) return true;\n    return state.showPipes || !HIDDEN_UNLESS_ASKED.has(object.asset.label);\n  }\n\n  // An object's footprint on screen. Its size comes from its box, its place from where it is now.\n  function footprint(view, object) {\n    const a = object.asset;\n    const halfX = Math.abs(a.bbox_max[0] - a.bbox_min[0]) / 2;\n    const halfZ = Math.abs(a.bbox_max[2] - a.bbox_min[2]) / 2;\n    const [left, top] = toScreen(view, object.center.x - halfX, object.center.z + halfZ);\n    return { left, top, width: 2 * halfX * view.scale, height: 2 * halfZ * view.scale };\n  }\n\n  // Important names go first. A name with no free spot waits until its object is found or tapped.\n  function drawLabels(c, view, labels) {\n    c.font = \"12px system-ui, sans-serif\";\n    c.textAlign = \"left\";\n    const placed = [];\n    labels.sort((a, b) => b.rank - a.rank);\n    for (const { text, box, color, rank } of labels) {\n      const width = c.measureText(text).width + 8;\n      const middleY = box.top + box.height / 2 - LABEL_HEIGHT / 2;\n      const middleX = box.left + box.width / 2 - width / 2;\n      const spots = [\n        [middleX, box.top - LABEL_HEIGHT - 2],\n        [middleX, box.top + box.height + 2],\n        [box.left - width - 2, middleY],\n        [box.left + box.width + 2, middleY],\n      ].map(([x, y]) => [\n        Math.max(2, Math.min(x, view.width - width - 2)),\n        Math.max(2, Math.min(y, view.height - LABEL_HEIGHT - 2)),\n      ]);\n      const free = spots.find(([x, y]) =>\n        placed.every(\n          (other) =>\n            x + width < other.x ||\n            other.x + other.width < x ||\n            y + LABEL_HEIGHT < other.y ||\n            other.y + LABEL_HEIGHT < y,\n        ),\n      );\n      const spot = free ?? (rank > 1 ? spots[0] : null);\n      if (!spot) continue;\n      placed.push({ x: spot[0], y: spot[1], width });\n      c.fillStyle = \"rgba(15, 20, 25, 0.9)\";\n      c.fillRect(spot[0], spot[1], width, LABEL_HEIGHT);\n      c.fillStyle = color;\n      c.fillText(text, spot[0] + 4, spot[1] + 12);\n    }\n  }\n\n  function drawRoute(c, view) {\n    const path = route.state.route?.path;\n    if (!path?.length) return;\n    c.beginPath();\n    c.strokeStyle = ROUTE_COLOR;\n    c.lineWidth = 4;\n    path.forEach((point, index) => {\n      const [x, y] = toScreen(view, point[0], point[2]);\n      if (index) c.lineTo(x, y);\n      else c.moveTo(x, y);\n    });\n    c.stroke();\n  }\n\n  // Where you are, and which way you face.\n  function drawViewer(c, view) {\n    const here = root.worldToLocal(camera.position.clone());\n    const ahead = root.worldToLocal(\n      camera.position.clone().add(camera.getWorldDirection(here.clone())),\n    );\n    const [x, y] = toScreen(view, here.x, here.z);\n    const [aheadX, aheadY] = toScreen(view, ahead.x, ahead.z);\n    c.save();\n    c.translate(x, y);\n    c.rotate(Math.atan2(aheadY - y, aheadX - x));\n    c.beginPath();\n    c.moveTo(14, 0);\n    c.lineTo(-8, -8);\n    c.lineTo(-4, 0);\n    c.lineTo(-8, 8);\n    c.closePath();\n    c.fillStyle = ROUTE_COLOR;\n    c.strokeStyle = \"#0f1419\";\n    c.lineWidth = 2;\n    c.fill();\n    c.stroke();\n    c.restore();\n  }\n\n  // One metre, in the scan's own units, which haven't been checked on site.\n  function drawScale(c, view) {\n    const d = state.description;\n    const x = view.left + 14;\n    const y = view.top + (d.z_max - d.z_min) * view.scale - 12;\n    c.font = \"12px system-ui, sans-serif\";\n    c.textAlign = \"left\";\n    c.fillStyle = \"rgba(15, 20, 25, 0.9)\";\n    c.fillRect(x - 8, y - 24, Math.max(view.scale + 16, 120), 32);\n    c.strokeStyle = \"#f8fafc\";\n    c.lineWidth = 3;\n    c.beginPath();\n    c.moveTo(x, y);\n    c.lineTo(x + view.scale, y);\n    c.stroke();\n    c.fillStyle = \"#f8fafc\";\n    c.fillText(\"1 m, scan's scale\", x, y - 8);\n  }\n\n  function draw() {\n    if (!state.open || !state.ready) return;\n    const view = fit();\n    const c = context;\n    const d = state.description;\n    c.setTransform(view.ratio, 0, 0, view.ratio, 0, 0);\n    c.clearRect(0, 0, view.width, view.height);\n    c.drawImage(\n      image,\n      view.left,\n      view.top,\n      (d.x_max - d.x_min) * view.scale,\n      (d.z_max - d.z_min) * view.scale,\n    );\n\n    c.strokeStyle = \"#f8fafc\";\n    c.lineWidth = 3;\n    for (const wall of d.walls) {\n      c.beginPath();\n      c.moveTo(...toScreen(view, ...wall.start));\n      c.lineTo(...toScreen(view, ...wall.end));\n      c.stroke();\n    }\n\n    const labels = [];\n    for (const object of objects) {\n      if (!shown(object)) continue;\n      const box = footprint(view, object);\n      const color = colorOf(object);\n      const highlighted = isHighlighted(object);\n      c.fillStyle = `${color}33`;\n      c.fillRect(box.left, box.top, box.width, box.height);\n      c.strokeStyle = highlighted ? FOUND_COLOR : color;\n      c.lineWidth = highlighted || color === FAULT_COLOR ? 3 : 1.5;\n      c.setLineDash(object.asset.mobility === \"movable\" ? [5, 4] : []);\n      c.strokeRect(box.left, box.top, box.width, box.height);\n      if (object.asset.mapping || highlighted) {\n        const rank = highlighted ? 3 : color === FAULT_COLOR ? 2 : 1;\n        labels.push({ text: nameOf(object), box, color, rank });\n      }\n    }\n    c.setLineDash([]);\n\n    drawRoute(c, view);\n    drawLabels(c, view, labels);\n    drawViewer(c, view);\n    drawScale(c, view);\n  }\n\n  function objectAt(view, x, y) {\n    const near = 6; // pixels of tolerance, for small objects under a finger\n    let best = null;\n    let bestArea = Infinity;\n    for (const object of objects) {\n      if (!shown(object)) continue;\n      const box = footprint(view, object);\n      const inside =\n        x >= box.left - near &&\n        x <= box.left + box.width + near &&\n        y >= box.top - near &&\n        y <= box.top + box.height + near;\n      if (inside && box.width * box.height < bestArea) {\n        best = object;\n        bestArea = box.width * box.height;\n      }\n    }\n    return best;\n  }\n\n  ui.canvas.addEventListener(\"click\", (event) => {\n    if (!state.ready) return;\n    const box = ui.canvas.getBoundingClientRect();\n    const found = objectAt(fit(), event.clientX - box.left, event.clientY - box.top);\n    if (found) onSelect(found);\n  });\n\n  function search(text) {\n    const wanted = text.trim().toLowerCase();\n    state.found.clear();\n    ui.note.textContent = \"\";\n    if (!wanted) return;\n    const here = objects.filter((object) => !object.gone);\n    const byTag = here.filter(\n      (object) =>\n        (object.asset.mapping?.tag ?? \"\").toLowerCase().includes(wanted) ||\n        object.asset.object_id.toLowerCase() === wanted,\n    );\n    const byType = here.filter((object) => object.asset.label?.toLowerCase() === wanted);\n    const matches = byTag.length ? byTag : byType;\n    for (const object of matches) state.found.add(object);\n    if (!matches.length) ui.note.textContent = \"Nothing with that tag or type.\";\n    else if (matches.length === 1) ui.note.textContent = `Found ${nameOf(matches[0])}.`;\n    else ui.note.textContent = `Found ${matches.length}.`;\n  }\n  ui.search.addEventListener(\"input\", () => search(ui.search.value));\n\n  ui.pipes.onclick = () => {\n    state.showPipes = !state.showPipes;\n    ui.pipes.textContent = state.showPipes ? \"Hide pipes\" : \"Show pipes\";\n  };\n\n  for (const [text, color] of LEGEND) {\n    const item = document.createElement(\"span\");\n    const swatch = document.createElement(\"i\");\n    swatch.style.background = color;\n    item.append(swatch, text);\n    ui.legend.append(item);\n  }\n  const dashed = document.createElement(\"span\");\n  const sample = document.createElement(\"i\");\n  sample.className = \"dashed\";\n  dashed.append(sample, \"Dashed: can move\");\n  ui.legend.append(dashed);\n\n  async function open() {\n    state.open = true;\n    ui.panel.hidden = false;\n    if (state.ready) return;\n    ui.note.textContent = \"Building the layout...\";\n    try {\n      const response = await fetch(\"/api/plan\");\n      const reply = await response.json().catch(() => ({}));\n      if (!response.ok) throw new Error(reply.detail ?? `backend error ${response.status}`);\n      state.description = reply;\n      image.src = \"/api/plan/floor.png\";\n      await image.decode();\n      state.ready = true;\n      ui.dxf.hidden = false;\n      ui.note.textContent = \"\";\n    } catch (error) {\n      ui.note.textContent = `Couldn't build the layout: ${error.message}.`;\n    }\n  }\n\n  function close() {\n    state.open = false;\n    ui.panel.hidden = true;\n  }\n\n  return { state, open, close, draw, search };\n}\nEOF\npython3 - <<'EOF'\ndef patch(path, pairs):\n    text = open(path).read()\n    for old, new in pairs:\n        assert old in text, (path, old[:70])\n        text = text.replace(old, new, 1)\n    open(path, \"w\").write(text)\n\npatch(\"web/main.js\", [\n(\"\"\"function name(asset) {\n  const link = asset.mapping;\n  if (!link) return asset.label;\n  return link.method?.startsWith(\"procedural\") ? `${link.tag}?` : link.tag;\n}\"\"\", \"\"\"// A link made by rule or by eye is a guess, so it reads as a question.\nfunction name(asset) {\n  const link = asset.mapping;\n  if (!link) return asset.label;\n  const method = link.method ?? \"\";\n  const guess = method.startsWith(\"procedural\") || method.includes(\"unconfirmed\");\n  return guess ? `${link.tag}?` : link.tag;\n}\"\"\"),\n(\"\"\"  if (!phone.enabled && !busy) controls.update(camera);\"\"\",\n \"\"\"  // Typing in the Plan screen's search box shouldn't walk the viewer around.\n  if (!phone.enabled && !busy && !plan?.state.open) controls.update(camera);\"\"\"),\n(\"\"\"      note: $(\"plan-note\"),\n    },\"\"\", \"\"\"      note: $(\"plan-note\"),\n      dxf: $(\"plan-dxf\"),\n    },\"\"\"),\n(\"\"\"    getSelected: () => selected,\n    onSelect: showInfo,\n  });\n  $(\"open-plan\").onclick = () => plan.open();\n  $(\"plan-close\").onclick = () => plan.close();\n\"\"\", \"\"\"    getSelected: () => selected,\n    nameOf: (object) => name(object.asset),\n    onSelect: showInfo,\n  });\n  $(\"open-plan\").onclick = () => plan.open();\n  $(\"plan-close\").onclick = () => plan.close();\n  // These work in the 3D view, so the Plan screen makes way for them.\n  for (const id of [\"move\", \"split-object\", \"combine-object\"]) {\n    $(id).addEventListener(\"click\", () => plan.close());\n  }\n\"\"\"),\n])\n\npatch(\"web/index.html\", [\n(\"\"\"<a id=\"plan-dxf\" href=\"/api/plan/layout.dxf\" download>Download DXF</a>\"\"\",\n \"\"\"<a id=\"plan-dxf\" href=\"/api/plan/layout.dxf\" download=\"floor_layout.dxf\" hidden>Download DXF</a>\"\"\"),\n])\n\npatch(\"web/style.css\", [\n(\"\"\"#plan-canvas {\n\"\"\", \"\"\"#plan-dxf[hidden] {\n  display: none;\n}\n#plan-canvas {\n\"\"\"),\n(\"\"\"#plan-legend i {\n  display: inline-block;\n  width: 10px;\n  height: 10px;\n  margin-right: 4px;\n  border-radius: 2px;\n}\n\"\"\", \"\"\"#plan-legend i {\n  display: inline-block;\n  width: 10px;\n  height: 10px;\n  margin-right: 4px;\n  border-radius: 2px;\n}\n#plan-legend i.dashed {\n  box-sizing: border-box;\n  border: 1px dashed #9ca3af;\n  border-radius: 0;\n}\n/* The object panel opens over the Plan screen, below its search bar. */\nbody:has(#plan:not([hidden])) #info {\n  top: 68px;\n  z-index: 5;\n  max-height: calc(100vh - 80px);\n  overflow-y: auto;\n}\nbody:has(#plan:not([hidden])) #copilot {\n  z-index: 5;\n}\n\"\"\"),\n])\n\npatch(\"web/serve.py\", [\n(\"\"\"            with urllib.request.urlopen(request, timeout=30) as response:\n                status, body = response.status, response.read()\n        except urllib.error.HTTPError as error:\n            status, body = error.code, error.read()\n        except urllib.error.URLError:\n            status, body = 502, b'{\"detail\": \"The backend isn\\\\'t running: start it with make api\"}'\n        self.send_response(status)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n\"\"\", \"\"\"            with urllib.request.urlopen(request, timeout=30) as response:\n                status, body, headers = response.status, response.read(), response.headers\n        except urllib.error.HTTPError as error:\n            status, body, headers = error.code, error.read(), error.headers\n        except urllib.error.URLError:\n            status, headers = 502, {}\n            body = b'{\"detail\": \"The backend isn\\\\'t running: start it with make api\"}'\n        self.send_response(status)\n        self.send_header(\"Content-Type\", headers.get(\"Content-Type\", \"application/json\"))\n        if headers.get(\"Content-Disposition\"):\n            self.send_header(\"Content-Disposition\", headers[\"Content-Disposition\"])\n        self.send_header(\"Content-Length\", str(len(body)))\n\"\"\"),\n])\n\npatch(\"app/plan/layout.py\", [\n('''\"\"\"Make a top-down floor layout from a scan: a floor image, fitted walls, and object footprints.\n\nIt's generated from the scan, not surveyed. Walls are fitted to what the scan saw, and a wall with\nlittle evidence is marked `assumed`. Scale is the scan's own, which hasn't been checked on site.\n\"\"\"\n\nfrom dataclasses import dataclass\n\nimport numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\n\nfrom app.scene.load import Splats\n''', '''\"\"\"Make a top-down floor layout from a scan: a floor image, walls, and object footprints.\n\nIt's generated from the scan, not surveyed. The walls are the same room estimate the BIM model uses,\nand the scale is the scan's own, which hasn't been checked on site.\n\"\"\"\n\nimport numpy as np\nfrom PIL import Image\nfrom scipy import ndimage\n\nfrom app.bim.room import estimate_room\nfrom app.scene.load import Splats\n'''),\n(\"\"\"WALL_CELL = 0.05\nWALL_MIN_SHARE = 0.25  # share of a side's length a wall line must cover to count as seen\nWALL_SEARCH = 0.25  # share of the room from each edge in which to look for its wall\n\"\"\", \"\"),\n(\"\"\"@dataclass\nclass Wall:\n    start: tuple[float, float]  # (x, z) in scene coordinates\n    end: tuple[float, float]\n    support: float  # share of its length where the scan saw something\n    assumed: bool\n\n\n\"\"\", \"\"),\n])\ntext = open(\"app/plan/layout.py\").read()\nstart = text.index(\"def fit_walls(\")\nend = text.index(\"def build_layout(\")\ntext = text[:start] + text[end:]\nold = '''    \"\"\"Return the floor image and a description: its extent in scene coordinates, and the walls.\"\"\"\n'''\nnew = '''    \"\"\"Return the floor image and a description: its extent in scene coordinates, and the room.\"\"\"\n'''\nassert old in text; text = text.replace(old, new, 1)\nold = \"\"\"    standing = solid & (heights > BODY_BAND[0]) & (heights < BODY_BAND[1])\n    low = np.percentile(flat[standing], 0.5, axis=0)\n    high = np.percentile(flat[standing], 99.5, axis=0)\n    walls = fit_walls(flat[standing], low, high)\n\n    corners = np.array([point for wall in walls for point in (wall.start, wall.end)])\n    origin = corners.min(axis=0) - EDGE_MARGIN\n    top = corners.max(axis=0) + EDGE_MARGIN\n\"\"\"\nnew = \"\"\"    standing = solid & (heights > BODY_BAND[0]) & (heights < BODY_BAND[1])\n\n    room = estimate_room(positions, splats.opacities, list(up), floor_y * sign)\n    faces, support = room[\"faces\"], room[\"wall_support\"]\n    room_low = np.array([faces[\"first_min\"], faces[\"second_min\"]])\n    room_high = np.array([faces[\"first_max\"], faces[\"second_max\"]])\n    origin = room_low - EDGE_MARGIN\n    top = room_high + EDGE_MARGIN\n\"\"\"\nassert old in text; text = text.replace(old, new, 1)\nold = \"\"\"    room_low = corners.min(axis=0)\n    room_high = corners.max(axis=0)\n    xs = origin\"\"\"\nnew = \"\"\"    xs = origin\"\"\"\nassert old in text; text = text.replace(old, new, 1)\nold = \"\"\"    description = {\n        \"x_min\": float(origin[0]),\"\"\"\nnew = \"\"\"    x0, z0 = room_low.tolist()\n    x1, z1 = room_high.tolist()\n    description = {\n        \"x_min\": float(origin[0]),\"\"\"\nassert old in text; text = text.replace(old, new, 1)\nold = \"\"\"        \"walls\": [\n            {\"start\": list(w.start), \"end\": list(w.end), \"support\": w.support, \"assumed\": w.assumed}\n            for w in walls\n        ],\n\"\"\"\nnew = \"\"\"        \"room\": room,\n        \"walls\": [\n            {\"start\": [x0, z0], \"end\": [x1, z0], \"support\": support[\"second_min\"]},\n            {\"start\": [x1, z0], \"end\": [x1, z1], \"support\": support[\"first_max\"]},\n            {\"start\": [x1, z1], \"end\": [x0, z1], \"support\": support[\"second_max\"]},\n            {\"start\": [x0, z1], \"end\": [x0, z0], \"support\": support[\"first_min\"]},\n        ],\n\"\"\"\nassert old in text; text = text.replace(old, new, 1)\nopen(\"app/plan/layout.py\", \"w\").write(text)\n\npatch(\"app/plan/export_dxf.py\", [\n(\"\"\"from app.plan.layout import plan_axes\n\"\"\", \"\"\"from app.bim.model import identity_confirmed\nfrom app.plan.layout import plan_axes\n\"\"\"),\n(\"\"\"COLORS = {\"WALLS\": 7, \"WALLS_ASSUMED\": 1, \"FAULT\": 1,\"\"\", \"\"\"COLORS = {\"WALLS\": 7, \"FAULT\": 1,\"\"\"),\n(\"\"\"        layer = \"WALLS_ASSUMED\" if wall[\"assumed\"] else \"WALLS\"\n        body += _line(layer, tuple(wall[\"start\"]), tuple(wall[\"end\"]))\n\"\"\", \"\"\"        body += _line(\"WALLS\", tuple(wall[\"start\"]), tuple(wall[\"end\"]))\n\"\"\"),\n(\"\"\"            method = str(asset[\"mapping\"].get(\"method\") or \"\")\n            shown = f\"{tag}?\" if method.startswith(\"procedural\") else tag\n\"\"\", \"\"\"            shown = tag if identity_confirmed(asset[\"mapping\"]) else f\"{tag}?\"\n\"\"\"),\n])\n\npatch(\"app/bim/ifc.py\", [\n(\"\"\"def write_ifc(model: dict, path: Path, timestamp: str | None = None) -> None:\n    rotation, floor\"\"\", \"\"\"def ifc_text(model: dict, file_name: str = \"model.ifc\", timestamp: str | None = None) -> str:\n    \\\"\\\"\\\"Return a BIM model as the text of an IFC4 STEP file.\\\"\\\"\\\"\n    rotation, floor\"\"\"),\n(\"\"\"        f\"FILE_NAME({string(path.name)},'{stamp}',(''),(''),'','app.bim','');\",\"\"\",\n \"\"\"        f\"FILE_NAME({string(file_name)},'{stamp}',(''),(''),'','app.bim','');\",\"\"\"),\n(\"\"\"    path.write_text(\"\\\\n\".join(header + body + [\"ENDSEC;\", \"END-ISO-10303-21;\", \"\"]))\"\"\",\n \"\"\"    return \"\\\\n\".join(header + body + [\"ENDSEC;\", \"END-ISO-10303-21;\", \"\"])\n\n\ndef write_ifc(model: dict, path: Path, timestamp: str | None = None) -> None:\n    path.write_text(ifc_text(model, path.name, timestamp))\"\"\"),\n])\n\npatch(\"app/bim/model.py\", [\n(\"\"\"            \"IdentityConfirmed\": identity_confirmed(mapping),\n\"\"\", \"\"\"            \"IdentityConfirmed\": identity_confirmed(mapping),\n            \"Status\": asset.get(\"status\"),\n\"\"\"),\n])\n\npatch(\"web/bim.js\", [\n(\"\"\"    guid: \"none in the file\",\n\"\"\", \"\"\"    guid: \"assigned on export\",\n\"\"\"),\n(\"\"\"  function setActive(on) {\n    state.active = on;\n    group.visible = on;\n    panel.hidden = !on;\n  }\n\"\"\", \"\"\"  function setActive(on) {\n    state.active = on;\n    group.visible = on;\n    panel.hidden = !on;\n    if (on) chooseDownload();\n  }\n\n  // The backend's copy shows the model as it stands now. Without one, there's still the built file.\n  async function chooseDownload() {\n    const reply = await fetch(\"/api/plan\").catch(() => null);\n    document.getElementById(\"bim-download\").href = reply?.ok ? \"/api/plan/model.ifc\" : \"model.ifc\";\n  }\n\"\"\"),\n])\n\npatch(\"app/api/main.py\", [\n(\"\"\"import io\nimport os\n\"\"\", \"\"\"import io\nimport json\nimport os\n\"\"\"),\n(\"\"\"from app.api.store import GONE, ChangeError, SceneStore\n\"\"\", \"\"\"from app.api.store import GONE, ChangeError, SceneStore\nfrom app.bim.ifc import ifc_text\nfrom app.bim.model import build_model\n\"\"\"),\n(\"\"\"            image, description = build_layout(splats_for_selection(), floor_y, up)\n            buffer = io.BytesIO()\"\"\", \"\"\"            try:\n                image, description = build_layout(splats_for_selection(), floor_y, up)\n            except ValueError as error:\n                raise HTTPException(503, f\"Couldn't work out the room: {error}\") from error\n            buffer = io.BytesIO()\"\"\"),\n(\"\"\"        \\\"\\\"\\\"Describe the floor layout: its extent, and the walls fitted to the scan.\\\"\\\"\\\"\n\"\"\", \"\"\"        \\\"\\\"\\\"Describe the floor layout: its extent, and the room estimated from the scan.\\\"\\\"\\\"\n\"\"\"),\n(\"\"\"    @app.post(\"/api/changes/reset\")\n\"\"\", \"\"\"    def shapes_where_they_stand() -> dict[str, dict]:\n        \\\"\\\"\\\"Return the fitted shapes of objects still in the room, moved along with them.\\\"\\\"\\\"\n        path = store.path.with_name(\"shapes.json\")\n        shapes = json.loads(path.read_text()) if path.exists() else {}\n        placed = {}\n        for asset in store.visible():\n            object_id = asset[\"object_id\"]\n            if object_id in shapes:\n                shift = np.subtract(asset[\"center\"], store.home_box(object_id)[\"center\"])\n                center = np.add(shapes[object_id][\"center\"], shift).tolist()\n                placed[object_id] = {**shapes[object_id], \"center\": center}\n        return placed\n\n    @app.get(\"/api/plan/model.ifc\")\n    def plan_ifc() -> Response:\n        \\\"\\\"\\\"Return the BIM model for BIM tools, with objects as they stand now.\\\"\\\"\\\"\n        document = {**store.scene, \"scene_id\": store.scene_id, \"assets\": store.visible()}\n        room = plan_layout()[\"description\"][\"room\"]\n        model = build_model(document, shapes_where_they_stand(), room)\n        headers = {\"Content-Disposition\": 'attachment; filename=\"model.ifc\"'}\n        return Response(ifc_text(model), media_type=\"application/x-step\", headers=headers)\n\n    @app.post(\"/api/changes/reset\")\n\"\"\"),\n(\"\"\"raise HTTPException(503, \"Selecting needs the scene: set SCENE_PLY to its file.\")\"\"\",\n \"\"\"raise HTTPException(503, \"This needs the scene: set SCENE_PLY to its file.\")\"\"\"),\n])\n\npatch(\"docs/USAGE.md\", [\n(\"\"\"Objects you move follow in BIM mode. Objects added, split or combined in the viewer show as plain\nsee-through boxes. **Download IFC** saves the model as `make bim` built it, without any of those\nchanges: they stay in the backend, so running `make bim` again doesn't add them.\n\"\"\", \"\"\"Objects you move follow in BIM mode. Objects added, split or combined in the viewer show as plain\nsee-through boxes. With the backend running, **Download IFC** saves the model as it stands now,\nincluding all of those changes. Without it, you get the file `make bim` built, which has none of them.\n\"\"\"),\n(\"\"\"Press **Plan** for the room from above: walls, objects by type, the route, and an arrow showing where you are.\n- **Find:** type a tag or type, such as `P-005` or `tank`.\n\"\"\", \"\"\"Press **Plan** for the room from above: walls, objects by type, the route, and an arrow showing where you are.\nColours match BIM mode, and a dashed outline means the object can be moved.\n- **Find:** type a tag or type. `P-005` highlights one object, and `tank` highlights them all.\n\"\"\"),\n(\"\"\"`make bim` writes an IFC model of the walls and objects for BIM tools, with each object's label and link in its\nproperties. Both are generated from the scan, not surveyed. Objects are boxes, and the scale hasn't been checked\non site. Without good evidence for a label, an object stays generic in the IFC. Needs `make api` and\n`Equipment Room.ply`.\n\"\"\", \"\"\"It's generated from the scan, not surveyed: objects are boxes, and the scale hasn't been checked on site. A name\nwith no room to show stays hidden until you find or tap its object. Needs `make api` and `Equipment Room.ply`.\n\"\"\"),\n])\n\npatch(\"README.md\", [\n(\"\"\"| `make bim` | Write a review IFC model of the objects and walls |\"\"\",\n \"\"\"| `make bim` | Build the simulated BIM model for BIM mode, and its IFC file |\"\"\"),\n])\n\ntest = open(\"tests/test_plan.py\").read()\ndef cut(text, start, end):\n    a = text.index(start); b = text.index(end, a)\n    return text[:a] + text[b:]\ntest = test.replace(\"\"\"from app.plan.export_dxf import layer_for, write_dxf  # noqa: E402\nfrom app.plan.export_ifc import ifc_class_for, to_model  # noqa: E402\nfrom app.plan.layout import build_layout, fit_walls  # noqa: E402\n\"\"\", \"\"\"from app.bim.room import estimate_room  # noqa: E402\nfrom app.plan.export_dxf import layer_for, write_dxf  # noqa: E402\nfrom app.plan.layout import build_layout  # noqa: E402\n\"\"\")\ntest = test.replace('''def room_points(open_side=False):\n    \"\"\"A 6 x 4 m room: walls at x = 0 and 6, z = 0 and 4, and a machine in the middle.\"\"\"\n    random = np.random.default_rng(0)\n    groups = [\n        random.uniform([0, 0], [0.05, 4], (3000, 2)),\n        random.uniform([5.95, 0], [6, 4], (3000, 2)),\n        random.uniform([0, 0], [6, 0.05], (3000, 2)),\n        random.uniform([2.5, 1.5], [3.5, 2.5], (3000, 2)),\n    ]\n    if not open_side:\n        groups.append(random.uniform([0, 3.95], [6, 4], (3000, 2)))\n    return np.concatenate(groups)\n''', '''def room_points():\n    \"\"\"A 6 x 4 m room: walls at x = 0 and 6, z = 0 and 4, and a machine in the middle.\"\"\"\n    random = np.random.default_rng(0)\n    groups = [\n        random.uniform([0, 0], [0.05, 4], (3000, 2)),\n        random.uniform([5.95, 0], [6, 4], (3000, 2)),\n        random.uniform([0, 0], [6, 0.05], (3000, 2)),\n        random.uniform([0, 3.95], [6, 4], (3000, 2)),\n        random.uniform([2.5, 1.5], [3.5, 2.5], (3000, 2)),\n    ]\n    return np.concatenate(groups)\n''')\ntest = cut(test, \"def test_walls_are_found_outside_the_things_in_the_room():\", \"def scene_splats():\")\ntest = test.replace('''def test_layout_has_an_image_and_the_room_extent():''', '''def test_walls_are_the_room_estimate_the_bim_model_uses():\n    splats = scene_splats()\n    _, description = build_layout(splats, FLOOR_Y)\n    positions = splats.positions.astype(np.float64)\n    assert description[\"room\"] == estimate_room(\n        positions, splats.opacities, [0.0, -1.0, 0.0], -FLOOR_Y\n    )\n    xs = [p[0] for wall in description[\"walls\"] for p in (wall[\"start\"], wall[\"end\"])]\n    zs = [p[1] for wall in description[\"walls\"] for p in (wall[\"start\"], wall[\"end\"])]\n    assert min(xs) == pytest.approx(0, abs=0.1) and max(xs) == pytest.approx(6, abs=0.1)\n    assert min(zs) == pytest.approx(0, abs=0.1) and max(zs) == pytest.approx(4, abs=0.1)\n\n\ndef test_layout_has_an_image_and_the_room_extent():''')\ntest = test.replace('''    assert \"M-001?\" in text and \"\\\\nP-005\\\\n\" in text  # Procedural links are shown as questions.\n    assert \"NOT SURVEYED\" in text\n''', '''    assert \"M-001?\" in text and \"P-005?\" in text  # Links made by rule or by eye are questions.\n    assert \"NOT SURVEYED\" in text\n    confirmed = asset(\"d\", mapping={\"tag\": \"T-1\", \"method\": \"nameplate\"})\n    assert \"\\\\nT-1\\\\n\" in write_dxf(description, [confirmed])\n''')\ntest = cut(test, \"def test_only_labels_with_evidence_get_a_specific_ifc_type():\", \"def plan_client(tmp_path, monkeypatch):\")\ntest = test.replace('''    document = {\"scene_id\": \"t\", \"floor_y\": FLOOR_Y, \"fault_tag\": \"P-005\", \"assets\": [asset(\"a\")]}\n    path.write_text(json.dumps(document))\n    return TestClient(create_app(path, engine=False, database=False))\n''', '''    assets = [asset(\"a\"), asset(\"b\")]\n    document = {\"scene_id\": \"t\", \"floor_y\": FLOOR_Y, \"fault_tag\": \"P-005\", \"assets\": assets}\n    path.write_text(json.dumps(document))\n    (tmp_path / \"shapes.json\").write_text(json.dumps({\"a\": CYLINDER}))\n    return TestClient(create_app(path, engine=False, database=False))\n''')\ntest = test.replace('''def plan_client(tmp_path, monkeypatch):''', '''CYLINDER = {\n    \"type\": \"cylinder\",\n    \"center\": [1.5, 0.75, 1.5],\n    \"axis\": [0.0, -1.0, 0.0],\n    \"radius\": 0.4,\n    \"height\": 0.5,\n    \"score\": 0.9,\n    \"use_shape\": True,\n}\n\n\ndef plan_client(tmp_path, monkeypatch):''')\ntest = test.replace('''def test_plan_without_a_scene_says_what_is_missing(tmp_path, monkeypatch):''', '''def test_ifc_download_shows_the_model_as_it_stands_now(tmp_path, monkeypatch):\n    client = plan_client(tmp_path, monkeypatch)\n    response = client.get(\"/api/plan/model.ifc\")\n    assert response.status_code == 200 and response.text.startswith(\"ISO-10303-21;\")\n    assert 'filename=\"model.ifc\"' in response.headers[\"content-disposition\"]\n    assert \"(b)\" in response.text\n    assert client.post(\"/api/changes\", json={\"op\": \"remove\", \"object_id\": \"b\"}).status_code == 200\n    added = client.post(\"/api/changes\", json={\"op\": \"add\", \"position\": [4, 0.5, 2]}).json()\n    text = client.get(\"/api/plan/model.ifc\").text\n    assert \"(b)\" not in text and f\"({added['change']['object_id']})\" in text\n    assert \"new, unconfirmed\" in text\n\n\ndef test_moved_object_keeps_its_fitted_shape_in_the_ifc(tmp_path, monkeypatch):\n    ifcopenshell = pytest.importorskip(\"ifcopenshell\")\n    import ifcopenshell.geom\n\n    client = plan_client(tmp_path, monkeypatch)\n    move = {\"op\": \"move\", \"object_id\": \"a\", \"position\": [3.5, 0.75, 3.0]}\n    assert client.post(\"/api/changes\", json=move).status_code == 200\n    path = tmp_path / \"model.ifc\"\n    path.write_text(client.get(\"/api/plan/model.ifc\").text)\n    model = ifcopenshell.open(str(path))\n    element = next(e for e in model.by_type(\"IfcElement\") if \"(a)\" in (e.Name or \"\"))\n    settings = ifcopenshell.geom.settings()\n    settings.set(\"use-world-coords\", True)\n    shape = ifcopenshell.geom.create_shape(settings, element).geometry\n    points = np.array(shape.verts).reshape(-1, 3)\n    # IFC's X and Y are the scene's x and z. The cylinder is 0.8 m across, around where it stands now.\n    np.testing.assert_allclose((points.min(axis=0) + points.max(axis=0))[:2] / 2, [3.5, 3.0], atol=0.01)\n    np.testing.assert_allclose((points.max(axis=0) - points.min(axis=0))[:2], [0.8, 0.8], atol=0.01)\n\n\ndef test_plan_without_a_scene_says_what_is_missing(tmp_path, monkeypatch):''')\ntest = test.replace('''    assert response.status_code == 503 and \"SCENE_PLY\" in response.json()[\"detail\"]\n''', '''    assert response.status_code == 503 and \"SCENE_PLY\" in response.json()[\"detail\"]\n    assert client.get(\"/api/plan/model.ifc\").status_code == 503\n''')\nopen(\"tests/test_plan.py\", \"w\").write(test)\nEOF\ngrep -n \"added\\b\\|\\\"change\\\"\" tests/test_api.py | head -5 | cut -c1-110; sed -n 140,144p web/style.css | cut -c1-50; sed -n 222,228p web/style.cs