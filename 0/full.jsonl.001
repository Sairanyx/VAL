{"parentUuid":"b75d21cd-42fc-4d9c-90ff-12cb5367aa30","isSidechain":false,"promptId":"185211ed-eef0-48b1-8f9b-e48fa7bb039e","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012jJcuo43eZG8P9BC2UMFCt","type":"tool_result","content":"1\t// Plant room viewer: walk through the splat scene like a camera feed, with object boxes and labels.\n2\t// Data: /scene.ply (Gaussian splat) and /assets.json (same format as fixtures/sample_assets.json),\n3\t// both served by web/serve.py.\n4\timport * as THREE from \"three\";\n5\timport { SparkControls, SparkRenderer, SplatMesh } from \"@sparkjsdev/spark\";\n6\timport { setupObjects } from \"./objects.js\";\n7\timport { setupPhone } from \"./phone.js\";\n8\t\n9\tconst FAULT_TAG = \"P-005\"; // the pre-chosen faulty device (docs/PLAN.md)\n10\tconst EYE_HEIGHT = 1.6; // metres above the floor in walk mode (scene units look close to metres)\n11\tconst LABEL_RANGE = 10; // only label objects closer than this\n12\tconst MAX_LABELS = 12;\n13\tconst BOX_RANGE = 3; // frames show near the viewer, as the brief asks, plus the fault and the selection\n14\t\n15\t// Speed settings, changeable in the URL without editing code, e.g. ?res=0.5&splats=300000\n16\t//   res     render resolution relative to the screen (default 1; 0.5 is about 4x fewer pixels)\n17\t//   lod     1 = level of detail on: far-away areas use fewer, bigger splats (default 1)\n18\t//   splats  how many splats LOD aims to draw per frame (default: Spark's choice for the device)\n19\tconst params = new URLSearchParams(location.search);\n20\tconst RES = Number(params.get(\"res\") ?? 1);\n21\tconst LOD = params.get(\"lod\") !== \"0\";\n22\tconst LOD_SPLATS = params.has(\"splats\") ? Number(params.get(\"splats\")) : undefined;\n23\t\n24\tconst $ = (id) => document.getElementById(id);\n25\tconst canvas = $(\"view\");\n26\t\n27\tconst renderer = new THREE.WebGLRenderer({ canvas, antialias: false });\n28\t// Rendering every splat at full high-DPI resolution is the main cost; 1 pixel per CSS pixel is enough.\n29\trenderer.setPixelRatio(RES);\n30\tconst scene = new THREE.Scene();\n31\tconst camera = new THREE.PerspectiveCamera(70, 1, 0.05, 200);\n32\tscene.add(new SparkRenderer({ renderer, lodSplatCount: LOD_SPLATS }));\n33\t\n34\t// The scene's +y points down. Turn it upright once here, and put everything in scene\n35\t// coordinates inside `root`, so file coordinates can be used as they are.\n36\tconst root = new THREE.Group();\n37\troot.rotation.x = Math.PI;\n38\tscene.add(root);\n39\t\n40\tconst controls = new SparkControls({ canvas });\n41\tconst phone = setupPhone({\n42\t  camera,\n43\t  button: $(\"phone\"),\n44\t  joystick: $(\"joystick\"),\n45\t  onMessage: (msg) => ($(\"status\").textContent = msg),\n46\t});\n47\tconst raycaster = new THREE.Raycaster();\n48\tconst objects = []; // { asset, box, pick, label, center }\n49\tlet walk = true;\n50\tlet eyeY = EYE_HEIGHT;\n51\tlet startPos = new THREE.Vector3(0, EYE_HEIGHT, 0);\n52\tlet objectLayer = null;\n53\tlet selected = null;\n54\tlet boxesOn = true;\n55\t\n56\tfunction resize() {\n57\t  const w = window.innerWidth;\n58\t  const h = window.innerHeight;\n59\t  renderer.setSize(w, h, false);\n60\t  camera.aspect = w / h;\n61\t  camera.updateProjectionMatrix();\n62\t}\n63\twindow.addEventListener(\"resize\", resize);\n64\tresize();\n65\t\n66\tfunction kind(asset) {\n67\t  if (asset.mapping?.tag === FAULT_TAG) return \"fault\";\n68\t  return asset.mapping ? \"mapped\" : \"plain\";\n69\t}\n70\tconst COLORS = { fault: 0xff4d4f, mapped: 0x38bdf8, plain: 0xd1d5db };\n71\t\n72\tfunction name(asset) {\n73\t  return asset.mapping?.tag ?? asset.label;\n74\t}\n75\t\n76\tfunction addAsset(asset) {\n77\t  const min = new THREE.Vector3(...asset.bbox_min);\n78\t  const max = new THREE.Vector3(...asset.bbox_max);\n79\t  const size = max.clone().sub(min);\n80\t  const mid = min.clone().add(max).multiplyScalar(0.5);\n81\t  const geom = new THREE.BoxGeometry(size.x, size.y, size.z);\n82\t\n83\t  const box = new THREE.LineSegments(\n84\t    new THREE.EdgesGeometry(geom),\n85\t    new THREE.LineBasicMaterial({ color: COLORS[kind(asset)] }),\n86\t  );\n87\t  box.position.copy(mid);\n88\t  root.add(box);\n89\t\n90\t  // Invisible solid box, so taps and the crosshair can hit the object.\n91\t  const pick = new THREE.Mesh(geom, new THREE.MeshBasicMaterial({ visible: false }));\n92\t  pick.position.copy(mid);\n93\t  pick.userData.index = objects.length;\n94\t  root.add(pick);\n95\t\n96\t  const label = document.createElement(\"div\");\n97\t  label.className = `label ${kind(asset)}`;\n98\t  $(\"labels\").append(label);\n99\t\n100\t  const volume = Math.max(size.x * size.y * size.z, 1e-6);\n101\t  objects.push({ asset, box, pick, label, volume, center: new THREE.Vector3(...asset.center) });\n102\t}\n103\t\n104\tfunction showInfo(obj) {\n105\t  const a = obj.asset;\n106\t  const m = a.mapping;\n107\t  const rows = [\n108\t    [\"Type\", a.label],\n109\t    [\"Label grade\", a.label_grade],\n110\t    [\"Suggested\", a.label === \"object\" ? a.suggested_label : undefined],\n111\t    [\"Why\", a.label_reason],\n112\t    [\"Label confidence\", a.label_grade ? undefined : a.label_confidence?.toFixed(2)],\n113\t    [\"Mobility\", a.mobility],\n114\t    [\"Mobility reason\", a.mobility_reason],\n115\t    [\"Object\", a.object_id],\n116\t    [\"Tag\", m?.tag ?? \"not mapped\"],\n117\t    [\"Asset\", m?.asset_id],\n118\t    [\"Mapped by\", m ? `${m.method}, confidence ${m.confidence}` : undefined],\n119\t  ].filter(([, v]) => v !== undefined);\n120\t  $(\"info-body\").innerHTML =\n121\t    `<h2>${name(a)}${kind(a) === \"fault\" ? \" — fault\" : \"\"}</h2><dl>` +\n122\t    rows.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join(\"\") +\n123\t    \"</dl>\";\n124\t  selected = obj;\n125\t  $(\"move\").hidden = a.mobility !== \"movable\" || !objectLayer;\n126\t  $(\"info\").hidden = false;\n127\t}\n128\t$(\"info-close\").onclick = () => ($(\"info\").hidden = true);\n129\t$(\"move\").onclick = () => {\n130\t  if (objectLayer?.startMove(selected)) {\n131\t    $(\"info\").hidden = true;\n132\t    $(\"status\").textContent = `Drag ${name(selected.asset)} along the floor`;\n133\t  }\n134\t};\n135\t\n136\tfunction hit(ndc) {\n137\t  raycaster.setFromCamera(ndc, camera);\n138\t  const hits = raycaster.intersectObjects(objects.map((o) => o.pick));\n139\t  // A pipe's box can span the room, so the smallest box under the pointer is the likely target.\n140\t  const found = hits.map((h) => objects[h.object.userData.index]);\n141\t  return found.length ? found.reduce((a, b) => (b.volume < a.volume ? b : a)) : null;\n142\t}\n143\t\n144\t// A short tap without dragging selects an object. Drags are camera movement.\n145\tlet down = null;\n146\tcanvas.addEventListener(\"pointerdown\", (e) => (down = { x: e.clientX, y: e.clientY, t: e.timeStamp }));\n147\tcanvas.addEventListener(\"pointerup\", (e) => {\n148\t  if (!down) return;\n149\t  const moved = Math.hypot(e.clientX - down.x, e.clientY - down.y);\n150\t  const quick = e.timeStamp - down.t < 300;\n151\t  down = null;\n152\t  if (moved > 8 || !quick) return;\n153\t  const ndc = new THREE.Vector2(\n154\t    (e.clientX / window.innerWidth) * 2 - 1,\n155\t    -(e.clientY / window.innerHeight) * 2 + 1,\n156\t  );\n157\t  const obj = hit(ndc);\n158\t  if (obj) showInfo(obj);\n159\t});\n160\t\n161\t$(\"mode\").onclick = () => {\n162\t  walk = !walk;\n163\t  $(\"mode\").textContent = walk ? \"Walk\" : \"Fly\";\n164\t};\n165\t$(\"boxes\").onclick = () => {\n166\t  boxesOn = !boxesOn;\n167\t  $(\"boxes\").textContent = boxesOn ? \"Boxes on\" : \"Boxes off\";\n168\t};\n169\t$(\"reset\").onclick = () => {\n170\t  camera.position.copy(startPos);\n171\t  camera.quaternion.identity();\n172\t  phone.recenter();\n173\t};\n174\t\n175\t// Draw a label over every object in front of the camera, like detections on a camera feed.\n176\t// Occlusion is ignored for now: an object behind a wall still gets a label.\n177\tconst tmp = new THREE.Vector3();\n178\tfunction updateLabels() {\n179\t  const visible = [];\n180\t  for (const o of objects) {\n181\t    const world = root.localToWorld(tmp.copy(o.center));\n182\t    const dist = world.distanceTo(camera.position);\n183\t    const ndc = world.project(camera);\n184\t    const onScreen = ndc.z < 1 && Math.abs(ndc.x) <= 1 && Math.abs(ndc.y) <= 1;\n185\t    o.label.style.display = \"none\";\n186\t    const pinned = kind(o.asset) === \"fault\" || o === selected;\n187\t    const apart = objectLayer?.state.amount > 0;\n188\t    o.box.visible = boxesOn && !apart && (dist < BOX_RANGE || pinned);\n189\t    if (apart && !o.shape && !pinned) continue;\n190\t    // Unconfirmed objects keep their frame, but don't crowd the view with a generic tag.\n191\t    const named = o.asset.label !== \"object\" || o.asset.mapping;\n192\t    if (onScreen && dist < LABEL_RANGE && named) visible.push({ o, dist, ndc: ndc.clone() });\n193\t  }\n194\t  visible.sort((a, b) => a.dist - b.dist);\n195\t  for (const { o, dist, ndc } of visible.slice(0, MAX_LABELS)) {\n196\t    o.label.style.display = \"block\";\n197\t    o.label.style.left = `${((ndc.x + 1) / 2) * window.innerWidth}px`;\n198\t    o.label.style.top = `${((1 - ndc.y) / 2) * window.innerHeight}px`;\n199\t    const type = name(o.asset) === o.asset.label ? \"\" : `${o.asset.label} · `;\n200\t    o.label.innerHTML = `${name(o.asset)} <small>${type}${dist.toFixed(1)} m</small>`;\n201\t  }\n202\t  const looking = hit(new THREE.Vector2(0, 0));\n203\t  $(\"in-view\").textContent =\n204\t    `${visible.length} object(s) in view` + (looking ? ` · looking at ${name(looking.asset)}` : \"\");\n205\t}\n206\t\n207\tlet frames = 0;\n208\tlet lastFps = performance.now();\n209\tlet lastFrame = performance.now();\n210\tfunction animate(now) {\n211\t  const dt = Math.min((now - lastFrame) / 1000, 0.1);\n212\t  lastFrame = now;\n213\t  // In phone mode the phone's rotation steers, so mouse/touch dragging must not fight it.\n214\t  if (!phone.enabled && !objectLayer?.state.moving) controls.update(camera);\n215\t  objectLayer?.update(dt);\n216\t  phone.update(dt);\n217\t  if (walk) camera.position.y = eyeY;\n218\t  renderer.render(scene, camera);\n219\t  updateLabels();\n220\t  frames++;\n221\t  if (now - lastFps > 1000) {\n222\t    const fps = Math.round((frames * 1000) / (now - lastFps));\n223\t    $(\"stats\").textContent = `${fps} fps` + (phone.enabled ? ` · ${phone.steps} steps` : \"\");\n224\t    frames = 0;\n225\t    lastFps = now;\n226\t  }\n227\t}\n228\t\n229\tasync function load() {\n230\t  const data = await (await fetch(\"assets.json\")).json();\n231\t  data.assets.forEach(addAsset);\n232\t\n233\t  // Floor and start are in scene coordinates; convert to the upright world.\n234\t  const floor = root.localToWorld(new THREE.Vector3(0, data.floor_y ?? 0, 0)).y;\n235\t  eyeY = floor + EYE_HEIGHT;\n236\t  const start = data.start ?? [0, data.floor_y ?? 0, 0];\n237\t  startPos = root.localToWorld(new THREE.Vector3(...start));\n238\t  startPos.y = eyeY;\n239\t  camera.position.copy(startPos);\n240\t\n241\t  const splat = new SplatMesh({ url: \"scene.ply\", lod: LOD });\n242\t  root.add(splat);\n243\t  renderer.setAnimationLoop(animate);\n244\t  await splat.initialized;\n245\t  const count = splat.packedSplats?.numSplats || splat.splats?.numSplats; // 0 or missing with LOD\n246\t  $(\"status\").textContent =\n247\t    `${data.assets.length} objects · ${count ? `${count.toLocaleString()} splats · ` : \"\"}` +\n248\t    `res ${RES}, LOD ${LOD ? \"on\" : \"off\"}${LOD_SPLATS ? ` (${LOD_SPLATS})` : \"\"} · ` +\n249\t    \"drag to look, WASD to move\";\n250\t\n251\t  objectLayer = await setupObjects({\n252\t    root,\n253\t    scene,\n254\t    camera,\n255\t    canvas,\n256\t    splat,\n257\t    objects,\n258\t    floorY: data.floor_y ?? 0,\n259\t    onChange: (changes) => ($(\"status\").textContent = `${changes.length} object(s) moved`),\n260\t  });\n261\t  const views = [\"scan\", \"both\", \"objects\"];\n262\t  $(\"view-mode\").onclick = () => {\n263\t    const next = views[(views.indexOf(objectLayer.state.view) + 1) % views.length];\n264\t    objectLayer.setView(next);\n265\t    $(\"view-mode\").textContent = next[0].toUpperCase() + next.slice(1);\n266\t  };\n267\t  $(\"apart\").onclick = () => {\n268\t    objectLayer.setApart(!objectLayer.state.apart);\n269\t    $(\"apart\").textContent = objectLayer.state.apart ? \"Together\" : \"Apart\";\n270\t  };\n271\t  $(\"reset-moves\").onclick = () => objectLayer.resetMoves();\n272\t  // Starting states from the URL, for screenshots and rehearsals.\n273\t  if (params.has(\"view\")) {\n274\t    objectLayer.setView(params.get(\"view\"));\n275\t    $(\"view-mode\").textContent = params.get(\"view\");\n276\t  }\n277\t  if (params.get(\"apart\") === \"1\") {\n278\t    objectLayer.setApart(true);\n279\t    $(\"apart\").textContent = \"Together\";\n280\t  }\n281\t  window.plantViewer = { objects, objectLayer, camera }; // For browser tests and debugging.\n282\t  if (params.has(\"camera\")) {\n283\t    const [x, y, z, yaw, pitch] = params.get(\"camera\").split(\",\").map(Number);\n284\t    camera.position.set(x, y, z);\n285\t    camera.rotation.set(pitch, yaw, 0, \"YXZ\");\n286\t    walk = false;\n287\t  }\n288\t}\n289\t\n290\tload().catch((err) => {\n291\t  $(\"status\").textContent = `Failed to load: ${err.message}`;\n292\t  console.error(err);\n293\t});\n294\t"}]},"uuid":"e25979e6-2679-4fff-a1f1-20dbc97ef9f6","timestamp":"2026-11-07T03:55:12.752Z","toolUseResult":{"type":"text","file":{"filePath":"/home/viktor-trilar/Projects/Newbies/web/main.js","content":"// Plant room viewer: walk through the splat scene like a camera feed, with object boxes and labels.\n// Data: /scene.ply (Gaussian splat) and /assets.json (same format as fixtures/sample_assets.json),\n// both served by web/serve.py.\nimport * as THREE from \"three\";\nimport { SparkControls, SparkRenderer, SplatMesh } from \"@sparkjsdev/spark\";\nimport { setupObjects } from \"./objects.js\";\nimport { setupPhone } from \"./phone.js\";\n\nconst FAULT_TAG = \"P-005\"; // the pre-chosen faulty device (docs/PLAN.md)\nconst EYE_HEIGHT = 1.6; // metres above the floor in walk mode (scene units look close to metres)\nconst LABEL_RANGE = 10; // only label objects closer than this\nconst MAX_LABELS = 12;\nconst BOX_RANGE = 3; // frames show near the viewer, as the brief asks, plus the fault and the selection\n\n// Speed settings, changeable in the URL without editing code, e.g. ?res=0.5&splats=300000\n//   res     render resolution relative to the screen (default 1; 0.5 is about 4x fewer pixels)\n//   lod     1 = level of detail on: far-away areas use fewer, bigger splats (default 1)\n//   splats  how many splats LOD aims to draw per frame (default: Spark's choice for the device)\nconst params = new URLSearchParams(location.search);\nconst RES = Number(params.get(\"res\") ?? 1);\nconst LOD = params.get(\"lod\") !== \"0\";\nconst LOD_SPLATS = params.has(\"splats\") ? Number(params.get(\"splats\")) : undefined;\n\nconst $ = (id) => document.getElementById(id);\nconst canvas = $(\"view\");\n\nconst renderer = new THREE.WebGLRenderer({ canvas, antialias: false });\n// Rendering every splat at full high-DPI resolution is the main cost; 1 pixel per CSS pixel is enough.\nrenderer.setPixelRatio(RES);\nconst scene = new THREE.Scene();\nconst camera = new THREE.PerspectiveCamera(70, 1, 0.05, 200);\nscene.add(new SparkRenderer({ renderer, lodSplatCount: LOD_SPLATS }));\n\n// The scene's +y points down. Turn it upright once here, and put everything in scene\n// coordinates inside `root`, so file coordinates can be used as they are.\nconst root = new THREE.Group();\nroot.rotation.x = Math.PI;\nscene.add(root);\n\nconst controls = new SparkControls({ canvas });\nconst phone = setupPhone({\n  camera,\n  button: $(\"phone\"),\n  joystick: $(\"joystick\"),\n  onMessage: (msg) => ($(\"status\").textContent = msg),\n});\nconst raycaster = new THREE.Raycaster();\nconst objects = []; // { asset, box, pick, label, center }\nlet walk = true;\nlet eyeY = EYE_HEIGHT;\nlet startPos = new THREE.Vector3(0, EYE_HEIGHT, 0);\nlet objectLayer = null;\nlet selected = null;\nlet boxesOn = true;\n\nfunction resize() {\n  const w = window.innerWidth;\n  const h = window.innerHeight;\n  renderer.setSize(w, h, false);\n  camera.aspect = w / h;\n  camera.updateProjectionMatrix();\n}\nwindow.addEventListener(\"resize\", resize);\nresize();\n\nfunction kind(asset) {\n  if (asset.mapping?.tag === FAULT_TAG) return \"fault\";\n  return asset.mapping ? \"mapped\" : \"plain\";\n}\nconst COLORS = { fault: 0xff4d4f, mapped: 0x38bdf8, plain: 0xd1d5db };\n\nfunction name(asset) {\n  return asset.mapping?.tag ?? asset.label;\n}\n\nfunction addAsset(asset) {\n  const min = new THREE.Vector3(...asset.bbox_min);\n  const max = new THREE.Vector3(...asset.bbox_max);\n  const size = max.clone().sub(min);\n  const mid = min.clone().add(max).multiplyScalar(0.5);\n  const geom = new THREE.BoxGeometry(size.x, size.y, size.z);\n\n  const box = new THREE.LineSegments(\n    new THREE.EdgesGeometry(geom),\n    new THREE.LineBasicMaterial({ color: COLORS[kind(asset)] }),\n  );\n  box.position.copy(mid);\n  root.add(box);\n\n  // Invisible solid box, so taps and the crosshair can hit the object.\n  const pick = new THREE.Mesh(geom, new THREE.MeshBasicMaterial({ visible: false }));\n  pick.position.copy(mid);\n  pick.userData.index = objects.length;\n  root.add(pick);\n\n  const label = document.createElement(\"div\");\n  label.className = `label ${kind(asset)}`;\n  $(\"labels\").append(label);\n\n  const volume = Math.max(size.x * size.y * size.z, 1e-6);\n  objects.push({ asset, box, pick, label, volume, center: new THREE.Vector3(...asset.center) });\n}\n\nfunction showInfo(obj) {\n  const a = obj.asset;\n  const m = a.mapping;\n  const rows = [\n    [\"Type\", a.label],\n    [\"Label grade\", a.label_grade],\n    [\"Suggested\", a.label === \"object\" ? a.suggested_label : undefined],\n    [\"Why\", a.label_reason],\n    [\"Label confidence\", a.label_grade ? undefined : a.label_confidence?.toFixed(2)],\n    [\"Mobility\", a.mobility],\n    [\"Mobility reason\", a.mobility_reason],\n    [\"Object\", a.object_id],\n    [\"Tag\", m?.tag ?? \"not mapped\"],\n    [\"Asset\", m?.asset_id],\n    [\"Mapped by\", m ? `${m.method}, confidence ${m.confidence}` : undefined],\n  ].filter(([, v]) => v !== undefined);\n  $(\"info-body\").innerHTML =\n    `<h2>${name(a)}${kind(a) === \"fault\" ? \" — fault\" : \"\"}</h2><dl>` +\n    rows.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join(\"\") +\n    \"</dl>\";\n  selected = obj;\n  $(\"move\").hidden = a.mobility !== \"movable\" || !objectLayer;\n  $(\"info\").hidden = false;\n}\n$(\"info-close\").onclick = () => ($(\"info\").hidden = true);\n$(\"move\").onclick = () => {\n  if (objectLayer?.startMove(selected)) {\n    $(\"info\").hidden = true;\n    $(\"status\").textContent = `Drag ${name(selected.asset)} along the floor`;\n  }\n};\n\nfunction hit(ndc) {\n  raycaster.setFromCamera(ndc, camera);\n  const hits = raycaster.intersectObjects(objects.map((o) => o.pick));\n  // A pipe's box can span the room, so the smallest box under the pointer is the likely target.\n  const found = hits.map((h) => objects[h.object.userData.index]);\n  return found.length ? found.reduce((a, b) => (b.volume < a.volume ? b : a)) : null;\n}\n\n// A short tap without dragging selects an object. Drags are camera movement.\nlet down = null;\ncanvas.addEventListener(\"pointerdown\", (e) => (down = { x: e.clientX, y: e.clientY, t: e.timeStamp }));\ncanvas.addEventListener(\"pointerup\", (e) => {\n  if (!down) return;\n  const moved = Math.hypot(e.clientX - down.x, e.clientY - down.y);\n  const quick = e.timeStamp - down.t < 300;\n  down = null;\n  if (moved > 8 || !quick) return;\n  const ndc = new THREE.Vector2(\n    (e.clientX / window.innerWidth) * 2 - 1,\n    -(e.clientY / window.innerHeight) * 2 + 1,\n  );\n  const obj = hit(ndc);\n  if (obj) showInfo(obj);\n});\n\n$(\"mode\").onclick = () => {\n  walk = !walk;\n  $(\"mode\").textContent = walk ? \"Walk\" : \"Fly\";\n};\n$(\"boxes\").onclick = () => {\n  boxesOn = !boxesOn;\n  $(\"boxes\").textContent = boxesOn ? \"Boxes on\" : \"Boxes off\";\n};\n$(\"reset\").onclick = () => {\n  camera.position.copy(startPos);\n  camera.quaternion.identity();\n  phone.recenter();\n};\n\n// Draw a label over every object in front of the camera, like detections on a camera feed.\n// Occlusion is ignored for now: an object behind a wall still gets a label.\nconst tmp = new THREE.Vector3();\nfunction updateLabels() {\n  const visible = [];\n  for (const o of objects) {\n    const world = root.localToWorld(tmp.copy(o.center));\n    const dist = world.distanceTo(camera.position);\n    const ndc = world.project(camera);\n    const onScreen = ndc.z < 1 && Math.abs(ndc.x) <= 1 && Math.abs(ndc.y) <= 1;\n    o.label.style.display = \"none\";\n    const pinned = kind(o.asset) === \"fault\" || o === selected;\n    const apart = objectLayer?.state.amount > 0;\n    o.box.visible = boxesOn && !apart && (dist < BOX_RANGE || pinned);\n    if (apart && !o.shape && !pinned) continue;\n    // Unconfirmed objects keep their frame, but don't crowd the view with a generic tag.\n    const named = o.asset.label !== \"object\" || o.asset.mapping;\n    if (onScreen && dist < LABEL_RANGE && named) visible.push({ o, dist, ndc: ndc.clone() });\n  }\n  visible.sort((a, b) => a.dist - b.dist);\n  for (const { o, dist, ndc } of visible.slice(0, MAX_LABELS)) {\n    o.label.style.display = \"block\";\n    o.label.style.left = `${((ndc.x + 1) / 2) * window.innerWidth}px`;\n    o.label.style.top = `${((1 - ndc.y) / 2) * window.innerHeight}px`;\n    const type = name(o.asset) === o.asset.label ? \"\" : `${o.asset.label} · `;\n    o.label.innerHTML = `${name(o.asset)} <small>${type}${dist.toFixed(1)} m</small>`;\n  }\n  const looking = hit(new THREE.Vector2(0, 0));\n  $(\"in-view\").textContent =\n    `${visible.length} object(s) in view` + (looking ? ` · looking at ${name(looking.asset)}` : \"\");\n}\n\nlet frames = 0;\nlet lastFps = performance.now();\nlet lastFrame = performance.now();\nfunction animate(now) {\n  const dt = Math.min((now - lastFrame) / 1000, 0.1);\n  lastFrame = now;\n  // In phone mode the phone's rotation steers, so mouse/touch dragging must not fight it.\n  if (!phone.enabled && !objectLayer?.state.moving) controls.update(camera);\n  objectLayer?.update(dt);\n  phone.update(dt);\n  if (walk) camera.position.y = eyeY;\n  renderer.render(scene, camera);\n  updateLabels();\n  frames++;\n  if (now - lastFps > 1000) {\n    const fps = Math.round((frames * 1000) / (now - lastFps));\n    $(\"stats\").textContent = `${fps} fps` + (phone.enabled ? ` · ${phone.steps} steps` : \"\");\n    frames = 0;\n    lastFps = now;\n  }\n}\n\nasync function load() {\n  const data = await (await fetch(\"assets.json\")).json();\n  data.assets.forEach(addAsset);\n\n  // Floor and start are in scene coordinates; convert to the upright world.\n  const floor = root.localToWorld(new THREE.Vector3(0, data.floor_y ?? 0, 0)).y;\n  eyeY = floor + EYE_HEIGHT;\n  const start = data.start ?? [0, data.floor_y ?? 0, 0];\n  startPos = root.localToWorld(new THREE.Vector3(...start));\n  startPos.y = eyeY;\n  camera.position.copy(startPos);\n\n  const splat = new SplatMesh({ url: \"scene.ply\", lod: LOD });\n  root.add(splat);\n  renderer.setAnimationLoop(animate);\n  await splat.initialized;\n  const count = splat.packedSplats?.numSplats || splat.splats?.numSplats; // 0 or missing with LOD\n  $(\"status\").textContent =\n    `${data.assets.length} objects · ${count ? `${count.toLocaleString()} splats · ` : \"\"}` +\n    `res ${RES}, LOD ${LOD ? \"on\" : \"off\"}${LOD_SPLATS ? ` (${LOD_SPLATS})` : \"\"} · ` +\n    \"drag to look, WASD to move\";\n\n  objectLayer = await setupObjects({\n    root,\n    scene,\n    camera,\n    canvas,\n    splat,\n    objects,\n    floorY: data.floor_y ?? 0,\n    onChange: (changes) => ($(\"status\").textContent = `${changes.length} object(s) moved`),\n  });\n  const views = [\"scan\", \"both\", \"objects\"];\n  $(\"view-mode\").onclick = () => {\n    const next = views[(views.indexOf(objectLayer.state.view) + 1) % views.length];\n    objectLayer.setView(next);\n    $(\"view-mode\").textContent = next[0].toUpperCase() + next.slice(1);\n  };\n  $(\"apart\").onclick = () => {\n    objectLayer.setApart(!objectLayer.state.apart);\n    $(\"apart\").textContent = objectLayer.state.apart ? \"Together\" : \"Apart\";\n  };\n  $(\"reset-moves\").onclick = () => objectLayer.resetMoves();\n  // Starting states from the URL, for screenshots and rehearsals.\n  if (params.has(\"view\")) {\n    objectLayer.setView(params.get(\"view\"));\n    $(\"view-mode\").textContent = params.get(\"view\");\n  }\n  if (params.get(\"apart\") === \"1\") {\n    objectLayer.setApart(true);\n    $(\"apart\").textContent = \"Together\";\n  }\n  window.plantViewer = { objects, objectLayer, camera }; // For browser tests and debugging.\n  if (params.has(\"camera\")) {\n    const [x, y, z, yaw, pitch] = params.get(\"camera\").split(\",\").map(Number);\n    camera.position.set(x, y, z);\n    camera.rotation.set(pitch, yaw, 0, \"YXZ\");\n    walk = false;\n  }\n}\n\nload().catch((err) => {\n  $(\"status\").textContent = `Failed to load: ${err.message}`;\n  console.error(err);\n});\n","numLines":294,"startLine":1,"totalLines":294}},"sourceToolAssistantUUID":"b75d21cd-42fc-4d9c-90ff-12cb5367aa30","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"/home/viktor-trilar/Projects/Newbies","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","version":"2.1.319","gitBranch":"viktor/keep-faint-splats","slug":"vast-jumping-lobster"}
