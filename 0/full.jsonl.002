bf722e3d028/scratchpad; T=\"$S/make_test\"; D=\"$S/demo_cut\"; V=\"$S/route_fix\"; cd \"$R\"; echo \"--- make targets (dry, nothing runs)\"; for t in scene pieces highlights bim; do echo \"[$t]\"; make -n $t 2>&1 | cut -c1-150 | head -3; done; gh release view objects-v2 --json assets --jq '.assets[] | \"\\(.name) \\(.size/1e6|floor) MB\"' 2>&1 | cut -c1-60; grep -n \"SCENE_FILE ?=\\|SCENE_TAG ?=\" Makefile | cut -c1-70; grep -n \"colmap\\|reconstruct\\|video\\|ffmpeg\" Makefile scripts/select_frames.py | head -4 | cut -c1-100; grep -n \"\\\"sam\\|sam2\\|transformers\\|segment\" scenes/equipment_room.toml | head -4 | cut -c1-90; echo \"--- cart: why no turn\"; python3 - <<EOF\nimport json\na={x['object_id']:x for x in json.load(open('$S/pr2_scene/assets_mapped.json'))['assets']}['obj-0067']\nprint('box',[round(abs(h-l),2) for l,h in zip(a['bbox_min'],a['bbox_max'])])\nEOF\ncat > \"$S/mine/load.py\" <<'EOF'\nimport sys, time\nfrom playwright.sync_api import sync_playwright\nARGS=[\"--no-sandbox\",\"--ignore-gpu-blocklist\",\"--enable-gpu\",\"--use-angle=vulkan\",\"--enable-features=Vulkan\"]\nwith sync_playwright() as p:\n    b=p.chromium.launch(executable_path=\"/snap/bin/chromium\",headless=True,args=ARGS); out=[]\n    for i in range(3):\n        c=b.new_context(viewport={\"width\":1280,\"height\":800}); pg=c.new_page(); pg.set_default_timeout(120000); s=time.time(); pg.goto(sys.argv[1]+\"/?tablet=0\"); pg.wait_for_function(\"window.plantViewer!==undefined\"); out.append(round(time.time()-s,1)); c.close()\n    print(sys.argv[2],\"seconds to ready, fresh browser each time:\",out); b.close()\nEOF\nrun(){ (cd \"$1\"; nohup python3 \"$V/serve_on_port.py\" \"$1\" 8299 --scene \"$3\" --assets \"$T/assets_mapped.json\" --shapes \"$T/shapes.json\" --port 8223 --host 127.0.0.1 > /dev/null 2>&1 &); for i in $(seq 20); do curl -sf -o /dev/null http://127.0.0.1:8223/ && break; sleep 1; done; timeout 110 uv run --no-project --with playwright python -u \"$S/mine/load.py\" http://127.0.0.1:8223 \"$2\" 2>&1 | tail -1 | cut -c1-110; p=$(ss -ltnp | grep \":8223 \" | sed -n 's/.*pid=\\([0-9]*\\).*/\\1/p' | head -1); kill \"$p\" 2>/dev/null; sleep 1; }\necho \"--- load time (no backend, same scene files)\"; run \"$S/perf_main\" \"old main, full 396 MB scene\" \"$R/Equipment Room.ply\"; run \"$R\" \"now, light 93 MB cut\" \"$D/base.ply\"; run \"$R\" \"now, full 396 MB scene\" \"$R/Equipment Room.ply\"; true","description":"Check make targets, the release, and measure load time three times each","timeout":400000},"caller":{"type":"direct"}}]}}
