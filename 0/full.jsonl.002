110].replace(\"\\n\",\" \")); pg.evaluate(\"window.__press('copilot-close')\")\n    pg.evaluate(\"window.__press('open-plan')\"); pg.wait_for_function(\"window.plantViewer.plan.state.ready\"); pg.fill(\"#plan-search\", \"spare\"); pg.wait_for_timeout(400); check(\"Plan finds it by name\", \"Found Spare pump\" in pg.inner_text(\"#plan-note\"), pg.inner_text(\"#plan-note\")); pg.evaluate(\"window.__press('plan-close')\")\n    ifc = pg.evaluate(\"fetch('/api/plan/model.ifc').then(r=>r.text())\"); check(\"the IFC has the name and ID\", f\"Spare pump ({C})\" in ifc)\n    pg.reload(); pg.wait_for_function(\"window.plantViewer!==undefined\"); pg.wait_for_timeout(3000); pg.evaluate(H); check(\"the name survives a reload\", pg.evaluate(f\"window.__f('{C}')?.asset.name\") == \"Spare pump\")\n    pg.evaluate(\"window.__press('reset-moves')\"); pg.wait_for_timeout(2000); check(\"Undo removes the copy\", pg.evaluate(f\"window.__f('{C}').gone\"))\n    print(\"page errors:\", errs[:5]); print(f\"{sum(res)} of {len(res)} passed\"); b.close()\nEOF\nif fuser 8001/tcp 8124/tcp >/dev/null 2>&1; then echo BUSY; exit 0; fi\n(cd \"$R\" && SCENE_PLY=\"$R/Equipment Room.ply\" SCENE_ASSETS=\"$S/pr2_scene/assets_mapped.json\" SCENE_GRID=\"$T/nav_grid.npz\" nohup uv run --no-project --with numpy --with scipy --with fastapi --with uvicorn --with websockets --with pydantic --with openpyxl --with pandas --with pillow --with 'psycopg[binary]' uvicorn app.api.main:app --app-dir \"$W\" --port 8001 > \"$S/ui/api.log\" 2>&1 &)\nnohup python3 web/serve.py --scene \"$T/light_400k.ply\" --assets \"$S/pr2_scene/assets_mapped.json\" --shapes \"$S/pr2_scene/shapes.json\" --bim \"$S/merged_out\" --port 8124 --host 127.0.0.1 > \"$S/ui/web.log\" 2>&1 &\nfor i in $(seq 60); do curl -sf -o /dev/null http://127.0.0.1:8001/docs && curl -sf -o /dev/null http://127.0.0.1:8124/ && break; sleep 1; done\ntimeout 240 uv run --no-project --with playwright python -u \"$S/ui/name_test.py\" \"$S\" 2>&1 | grep -v \"^Installe