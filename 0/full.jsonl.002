ATH=. uv run --no-project --with numpy --with scipy --with pandas --with openpyxl --with pytest --with fastapi --with httpx --with pillow --with 'psycopg[binary]' pytest -q -p no:cacheprovider 2>&1 | tail -1 | cut -c1-80; git commit -q -m \"Merge Eduard's docs and Sasha's picking and hover\n\nPicking takes the nearest object and works alongside combined objects and copies.\nA hover change draws one frame, not a burst. The test checklist matches the new UI.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\"; git log --oneline -1 | cut -c1-70; git fetch -q origin; echo \"main moved: $(git rev-list --count HEAD..origin/main)\"; for b in origin/yasasha/bim-pick origin/eduard_main; do git merge-base --is-ancestor $b HEAD && echo \"in: $b\" || echo \"NEW COMMITS: $b\"; done; git push -q git@github.com:Sairanyx/Newbies.git viktor/merge-team 2>&1 | grep -v \"^remote:\" | tail -1 | cut -c1-80; printf '%s\\n' \"Merges \\`eduard_main\\` (architecture overview, test checklist) and \\`yasasha/bim-pick\\` (nearest-object picking, hover outlines), so the team can test together. Merged quickly at Viktor's request.\" \"\" \"**Also:** the test checklist now matches the new UI, and a hover change draws one frame.\" \"\" \"**Tested:** 261 tests with the Excel pack, lint clean. Browser: 28 of 28 combine, delete, duplicate and back checks, 13 of 13 naming checks.\" \"\" \"**Open:** one route check failed once: after undo the route was the correct 4.307 m, but the value recorded before was 4.69 m. It looks like test timing, not confirmed. Moving the mouse dropped a ThinkPad to 19 frames a second before the one-frame change, and that change isn't measured.\" \"\" \"🤖 Generated with [Claude Code](https://claude.com/claude-code)\" > \"$S/pr7.md\"; gh pr create --base main --head viktor/merge-team --title \"Merge Eduard's docs and Sasha's picking and hover\" --body-file \"$S/pr7.md\" 2>&1 | tail -1 | cut -c1-80; sleep 8; timeout 120 gh pr checks viktor/merge-team --watch --interval 