bel_reason],\n    [\"Label confidence\", a.label_grade ? undefined : a.label_confidence?.toFixed(2)],\n    [\"Mobility\", a.mobility],\n    [\"Mobility reason\", a.mobility_reason],\n    [\"Object\", a.object_id],\n    [\"Tag\", m?.tag ?? \"not mapped\"],\n    [\"Asset\", m?.asset_id],\n    [\"Mapped by\", m ? `${m.method}, confidence ${m.confidence}` : undefined],\n  ].filter(([, v]) => v !== undefined);\n  $(\"info-body\").innerHTML =\n    `<h2>${name(a)}${kind(a) === \"fault\" ? \" — fault\" : \"\"}</h2><dl>` +\n    rows.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join(\"\") +\n    \"</dl>\";\n  selected = obj;\n  highlight.select(obj);\n  bim?.selectObject(obj);\n  $(\"move-actions\").hidden = a.mobility !== \"movable\" || !objectLayer;\n  $(\"cant-move\").hidden = a.mobility === \"movable\";\n  $(\"cant-move\").textContent =\n    a.mobility === \"fixed\"\n      ? \"This is fixed, so it can't be moved.\"\n      : \"Not known to be movable, so moving is off.\";\n  $(\"route-here\").hidden = !route;\n  $(\"split-object\").hidden = !route || Boolean(m);\n  $(\"combine-object\").hidden = !route || Boolean(m);\n  $(\"ask\").hidden = false;\n  showCondition(obj);\n  $(\"info\").hidden = false;\n}\n// A tap on the scene opens a window, and the browser then sends its own click to the same spot.\n// That click would land on the new window and close it at once (or press one of its buttons), so\n// windows ignore clicks that arrive just after a tap on the scene.\nconst GHOST_CLICK_MS = 500;\nlet lastSceneTap = 0;\n\n// On a tablet there's no close button: tapping a window anywhere except its controls closes it.\nfunction closeOnTap(panel, close) {\n  panel.addEventListener(\n    \"click\",\n    (event) => {\n      if (performance.now() - lastSceneTap < GHOST_CLICK_MS) {\n        event.stopPropagation();\n        event.preventDefault();\n      }\n    },\n    true, // capture: runs before the window's own buttons see the click\n  );\n  panel.addEventListener(\"click\", (event) => {\n    if (document.body.classList.contains(\"tablet\") && !event.target.closest(PANEL_CONTROLS)) {\n      close.click();\n    }\n  });\n}\ncloseOnTap($(\"info\"), $(\"info-close\"));\ncloseOnTap($(\"copilot\"), $(\"copilot-close\"));\n$(\"info-close\").onclick = () => {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"6ee6e2ae-a73b-4528-84a4-d46a357b5908","context":{"git_state":{"cwd":"/home/viktor-trilar/Projects/Newbies/.claude/worktrees/agent-aef4b903dc16194fa","root":"/home/viktor-trilar/Projects/Newbies/.claude/worktrees/agent-aef4b903dc16194fa","branch":"viktor/viewer-and-val","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"}]}},"live_cwd":"/home/viktor-trilar/Projects/Newbies/.claude/worktrees/agent-aef4b903dc16194fa","platform":"linux"}},"sandboxed":false,"sourceToolAssistantUUID":"2ae2d53e-2f11-4121-b871-731cea624ad2","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-vscode","cwd":"/home/viktor-trilar/Projects/Newbies/.claude/worktrees/agent-aef4b903dc16194fa","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","version":"2.1.319","gitBranch":"viktor/viewer-and-val","slug":"vast-jumping-lobster"}
