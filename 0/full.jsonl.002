faceAt(item, raycaster);\n  }\n\n  function pick(raycaster) {\n    const item = candidate(raycaster);\n    select(item);\n    return item;\n  }\n\n  const shell = createHoverShell(root, [section]);\n\n  // Pass a raycaster to hover what is under it, or null to clear. Returns the hovered item.\n  function hover(raycaster) {\n    let item = raycaster && state.active ? candidate(raycaster) : null;\n    if (item && ROOM.has(item.element.ifc_class)) item = null;\n    state.hovered = item;\n    if (item && visible(item)) shell.show(item.box.geometry, item.box.position, item.box.quaternion)\n    else shell.hide();\n    return item;\n  }\n\n  // Outside BIM mode: outline an object's simple shape where the object stands now.\n  function hoverObject(object) {\n    if (state.active) return false;\n    if (object && !object.gone) addMissing();\n    const item = object && !object.gone ? items.find((c) => c.object === object) : null;\n    if (!item) {\n      shell.hide();\n      return false;\n    }\n    placeShapes(item);\n    shell.show(item.box.geometry, item.box.position, item.box.quaternion);\n    return true;\n  }\n\n  document.getElementById(\"bim-look\").hidden = looks.length < 2;\n  return {\n    items,\n    state,\n    setActive,\n    setLook,\n    update,\n    pick,\n    hover,\n    hoverObject,\n    surfaceDistance,\n// Which object is under the pointer. The nearest object wins, so nothing behind it can be picked.\n// Two exceptions keep that usable:\n// - Boxes the camera is inside are ignored, unless nothing else is under the pointer.\n// - Long, thin things (pipes, hoses, cables) have mostly empty boxes that can span the room, so the\n//   only count where their actual surface is under the pointer.\n// Shapes need two-sided materials, so a ray inside a shape still hits its far side.\n//\n// Each candidate: { mesh, volume, thin, surface }. `surface(raycaster)` gives the distance to the\n// object's real surface along the ray, or null where there is none; thin object