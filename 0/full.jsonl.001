{"parentUuid":"e8f2ca2f-90bc-4954-b248-105cdf201bb1","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgoA7y6uu4ps6jtgp27cB","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Dragging the roll cage (obj-0067) about 0.9 m onto the route pushes the route to P-005 from 4.31 m to 5.56 m, while other spots block the aisle outright. Next I'm building the cut tool, viewer support, and a make command.\n\n","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4165,"cache_read_input_tokens":531690,"output_tokens":7311,"output_tokens_details":{"thinking_tokens":491},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":4165,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":7311,"cache_read_input_tokens":531690,"cache_creation_input_tokens":4165,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4165},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":10,"thinkingDisplay":"updates","serverClassifierRequest":"716784ab-1246-4738-a541-5d793dfa10a7","apiBlockIndex":1,"requestId":"req_011CgoA7xWh92QYyRgNEddGp","requestRef":"08030d42-16dd-4075-92fa-ee5b00816faa","requestedModel":"claude-opus-5-5","promptCacheRequested":"1h","type":"assistant","uuid":"30750a5b-13c7-4413-8d83-ee71cb5ba654","timestamp":"2026-11-07T07:16:54.515Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-vscode","cwd":"/home/viktor-trilar/Projects/Newbies","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","version":"2.1.319","gitBranch":"viktor/moving-splats","slug":"vast-jumping-lobster"}
{"parentUuid":"30750a5b-13c7-4413-8d83-ee71cb5ba654","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgoA7y6uu4ps6jtgp27cB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013WkvSn9uqfwEVLnxNAjWa5","name":"Write","input":{"file_path":"/home/viktor-trilar/Projects/Newbies/app/scene/split_movable.py","content":"\"\"\"Cut movable objects out of a scene, so that dragging one in the viewer moves the real thing.\n\n    python -m app.scene.split_movable SCENE.ply ASSETS.json OUT_DIR --objects obj-0067 obj-0008\n\nWrites base.ply, without those objects, plus pieces/OBJECT.ply and pieces.json. Everything inside an\nobject's box goes with it, including faint splats that carry no label, because leaving those behind\nshows as a ghost. It uses positions only, so it works on the full scene and on lighter copies.\n\nBest for free-standing objects: anything else inside the box moves too. The scan saw the floor\nunder most objects, so what's left behind is usually a dark patch, not a hole.\n\"\"\"\n\nimport argparse\nimport json\nfrom pathlib import Path\n\nimport numpy as np\n\nfrom app.scene.load import Splats, read_splats, write_splats\n\nBOX_MARGIN = 0.03  # metres around the box, to catch splats at its edge\nFLOOR_MARGIN = 0.03  # metres above the floor to stop at, so the floor itself stays\n\n\ndef inside_box(\n    positions: np.ndarray, asset: dict, floor_height: float, up: np.ndarray\n) -> np.ndarray:\n    \"\"\"Return which splats belong to an object: in its box, and above the floor.\"\"\"\n    low = np.minimum(asset[\"bbox_min\"], asset[\"bbox_max\"]) - BOX_MARGIN\n    high = np.maximum(asset[\"bbox_min\"], asset[\"bbox_max\"]) + BOX_MARGIN\n    in_box = ((positions >= low) & (positions <= high)).all(axis=1)\n    return in_box & (positions @ up > floor_height + FLOOR_MARGIN)\n\n\ndef split_movable(\n    splats: Splats, assets: list[dict], floor_height: float, up: np.ndarray\n) -> tuple[Splats, dict[str, Splats]]:\n    \"\"\"Return the scene without these objects, and each object's splats. First box in wins.\"\"\"\n    taken = np.zeros(len(splats), dtype=bool)\n    pieces = {}\n    for asset in assets:\n        members = inside_box(splats.positions, asset, floor_height, up) & ~taken\n        taken |= members\n        pieces[asset[\"object_id\"]] = splats[members]\n    return splats[~taken], pieces\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"scene\", type=Path)\n    parser.add_argument(\"assets\", type=Path)\n    parser.add_argument(\"out\", type=Path)\n    parser.add_argument(\"--objects\", nargs=\"+\", required=True)\n    parser.add_argument(\"--up\", type=float, nargs=3, default=(0.0, -1.0, 0.0))\n    args = parser.parse_args()\n    document = json.loads(args.assets.read_text())\n    by_id = {asset[\"object_id\"]: asset for asset in document[\"assets\"]}\n    for object_id in args.objects:\n        if by_id.get(object_id, {}).get(\"mobility\") != \"movable\":\n            parser.error(f\"{object_id} isn't a movable object in {args.assets}\")\n    up = np.asarray(args.up, dtype=np.float64)\n    floor_height = float(document[\"floor_y\"]) * float(up @ np.array([0.0, 1.0, 0.0]))\n    base, pieces = split_movable(\n        read_splats(args.scene), [by_id[i] for i in args.objects], floor_height, up\n    )\n    (args.out / \"pieces\").mkdir(parents=True, exist_ok=True)\n    write_splats(base, args.out / \"base.ply\")\n    for object_id, piece in pieces.items():\n        write_splats(piece, args.out / \"pieces\" / f\"{object_id}.ply\")\n    (args.out / \"pieces.json\").write_text(json.dumps(list(pieces)))\n    sizes = {object_id: len(piece) for object_id, piece in pieces.items()}\n    print(json.dumps({\"base\": len(base), \"pieces\": sizes}))\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4165,"cache_read_input_tokens":531690,"output_tokens":7311,"output_tokens_details":{"thinking_tokens":491},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":4165,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":7311,"cache_read_input_tokens":531690,"cache_creation_input_tokens":4165,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4165},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"toolInputStreamMs":9498,"wireToolInputs":{"toolu_013WkvSn9uqfwEVLnxNAjWa5":{"file_path":"/home/viktor-trilar/Projects/Newbies/app/scene/split_movable.py","content":"\"\"\"Cut movable objects out of a scene, so that dragging one in the viewer moves the real thing.\n\n    python -m app.scene.split_movable SCENE.ply ASSETS.json OUT_DIR --objects obj-0067 obj-0008\n\nWrites base.ply, without those objects, plus pieces/OBJECT.ply and pieces.json. Everything inside an\nobject's box goes with it, including faint splats that carry no label, because leaving those behind\nshows as a ghost. It uses positions only, so it works on the full scene and on lighter copies.\n\nBest for free-standing objects: anything else inside the box moves too. The scan saw the floor\nunder most objects, so what's left behind is usually a dark patch, not a hole.\n\"\"\"\n\nimport argparse\nimport json\nfrom pathlib import Path\n\nimport numpy as np\n\nfrom app.scene.load import Splats, read_splats, write_splats\n\nBOX_MARGIN = 0.03  # metres around the box, to catch splats at its edge\nFLOOR_MARGIN = 0.03  # metres above the floor to stop at, so the floor itself stays\n\n\ndef inside_box(\n    positions: np.ndarray, asset: dict, floor_height: float, up: np.ndarray\n) -> np.ndarray:\n    \"\"\"Return which splats belong to an object: in its box, and above the floor.\"\"\"\n    low = np.minimum(asset[\"bbox_min\"], asset[\"bbox_max\"]) - BOX_MARGIN\n    high = np.maximum(asset[\"bbox_min\"], asset[\"bbox_max\"]) + BOX_MARGIN\n    in_box = ((positions >= low) & (positions <= high)).all(axis=1)\n    return in_box & (positions @ up > floor_height + FLOOR_MARGIN)\n\n\ndef split_movable(\n    splats: Splats, assets: list[dict], floor_height: float, up: np.ndarray\n) -> tuple[Splats, dict[str, Splats]]:\n    \"\"\"Return the scene without these objects, and each object's splats. First box in wins.\"\"\"\n    taken = np.zeros(len(splats), dtype=bool)\n    pieces = {}\n    for asset in assets:\n        members = inside_box(splats.positions, asset, floor_height, up) & ~taken\n        taken |= members\n        pieces[asset[\"object_id\"]] = splats[members]\n    return splats[~taken], pieces\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"scene\", type=Path)\n    parser.add_argument(\"assets\", type=Path)\n    parser.add_argument(\"out\", type=Path)\n    parser.add_argument(\"--objects\", nargs=\"+\", required=True)\n    parser.add_argument(\"--up\", type=float, nargs=3, default=(0.0, -1.0, 0.0))\n    args = parser.parse_args()\n    document = json.loads(args.assets.read_text())\n    by_id = {asset[\"object_id\"]: asset for asset in document[\"assets\"]}\n    for object_id in args.objects:\n        if by_id.get(object_id, {}).get(\"mobility\") != \"movable\":\n            parser.error(f\"{object_id} isn't a movable object in {args.assets}\")\n    up = np.asarray(args.up, dtype=np.float64)\n    floor_height = float(document[\"floor_y\"]) * float(up @ np.array([0.0, 1.0, 0.0]))\n    base, pieces = split_movable(\n        read_splats(args.scene), [by_id[i] for i in args.objects], floor_height, up\n    )\n    (args.out / \"pieces\").mkdir(parents=True, exist_ok=True)\n    write_splats(base, args.out / \"base.ply\")\n    for object_id, piece in pieces.items():\n        write_splats(piece, args.out / \"pieces\" / f\"{object_id}.ply\")\n    (args.out / \"pieces.json\").write_text(json.dumps(list(pieces)))\n    sizes = {object_id: len(piece) for object_id, piece in pieces.items()}\n    print(json.dumps({\"base\": len(base), \"pieces\": sizes}))\n\n\nif __name__ == \"__main__\":\n    main()\n"}},"serverClassifierRequest":"716784ab-1246-4738-a541-5d793dfa10a7","apiBlockIndex":2,"requestId":"req_011CgoA7xWh92QYyRgNEddGp","requestRef":"08030d42-16dd-4075-92fa-ee5b00816faa","requestedModel":"claude-opus-5-5","promptCacheRequested":"1h","type":"assistant","uuid":"809409c9-b7ed-4010-a169-f9210de74dbd","timestamp":"2026-11-07T07:17:04.015Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-vscode","cwd":"/home/viktor-trilar/Projects/Newbies","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","version":"2.1.319","gitBranch":"viktor/moving-splats","slug":"vast-jumping-lobster"}
{"parentUuid":"809409c9-b7ed-4010-a169-f9210de74dbd","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgoA7y6uu4ps6jtgp27cB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WKK6vtAxYGJeV7nxBp6mh8","name":"Write","input":{"file_path":"/home/viktor-trilar/Projects/Newbies/tests/test_split_movable.py","content":"import pytest\n\nnp = pytest.importorskip(\"numpy\")\n\nfrom app.scene.load import Splats  # noqa: E402\nfrom app.scene.split_movable import split_movable  # noqa: E402\n\nUP = np.array([0.0, -1.0, 0.0])  # The scene's +y points down, with the floor at y = 1.\n\n\ndef scene(points):\n    names = [\"x\", \"y\", \"z\", \"scale_0\", \"scale_1\", \"scale_2\", \"rot_0\", \"rot_1\", \"rot_2\", \"rot_3\"]\n    names += [\"f_dc_0\", \"f_dc_1\", \"f_dc_2\", \"opacity\"]\n    data = np.zeros(len(points), dtype=[(name, \"<f4\") for name in names])\n    data[\"x\"], data[\"y\"], data[\"z\"] = np.array(points, dtype=np.float32).T\n    return Splats(data)\n\n\ndef box(object_id, low, high):\n    return {\"object_id\": object_id, \"bbox_min\": low, \"bbox_max\": high}\n\n\ndef test_object_takes_what_is_in_its_box_but_leaves_the_floor():\n    points = [\n        [0.0, 0.5, 0.0],  # In the box.\n        [0.0, 1.0, 0.0],  # On the floor, under the box.\n        [0.0, 0.2, 0.0],  # Above the box.\n        [3.0, 0.5, 0.0],  # Elsewhere.\n    ]\n    # Height along up is -y, so the floor at y = 1 is at -1.\n    base, pieces = split_movable(\n        scene(points), [box(\"cart\", [-0.5, 0.3, -0.5], [0.5, 1.0, 0.5])], -1.0, UP\n    )\n    assert pieces[\"cart\"].positions[:, 1].tolist() == [0.5]\n    assert sorted(base.positions[:, 1].tolist()) == pytest.approx([0.2, 0.5, 1.0])\n    assert len(base) == 3\n\n\ndef test_overlapping_boxes_never_share_a_splat():\n    points = [[0.0, 0.5, 0.0], [0.4, 0.5, 0.0]]\n    base, pieces = split_movable(\n        scene(points),\n        [box(\"a\", [-0.2, 0.3, -0.2], [0.2, 0.7, 0.2]), box(\"b\", [-0.2, 0.3, -0.2], [0.6, 0.7, 0.2])],\n        -1.0,\n        UP,\n    )\n    assert len(pieces[\"a\"]) == 1 and len(pieces[\"b\"]) == 1 and len(base) == 0\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4165,"cache_read_input_tokens":531690,"output_tokens":7311,"output_tokens_details":{"thinking_tokens":491},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":4165,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":7311,"cache_read_input_tokens":531690,"cache_creation_input_tokens":4165,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4165},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"toolInputStreamMs":6855,"wireToolInputs":{"toolu_01WKK6vtAxYGJeV7nxBp6mh8":{"file_path":"/home/viktor-trilar/Projects/Newbies/tests/test_split_movable.py","content":"import pytest\n\nnp = pytest.importorskip(\"numpy\")\n\nfrom app.scene.load import Splats  # noqa: E402\nfrom app.scene.split_movable import split_movable  # noqa: E402\n\nUP = np.array([0.0, -1.0, 0.0])  # The scene's +y points down, with the floor at y = 1.\n\n\ndef scene(points):\n    names = [\"x\", \"y\", \"z\", \"scale_0\", \"scale_1\", \"scale_2\", \"rot_0\", \"rot_1\", \"rot_2\", \"rot_3\"]\n    names += [\"f_dc_0\", \"f_dc_1\", \"f_dc_2\", \"opacity\"]\n    data = np.zeros(len(points), dtype=[(name, \"<f4\") for name in names])\n    data[\"x\"], data[\"y\"], data[\"z\"] = np.array(points, dtype=np.float32).T\n    return Splats(data)\n\n\ndef box(object_id, low, high):\n    return {\"object_id\": object_id, \"bbox_min\": low, \"bbox_max\": high}\n\n\ndef test_object_takes_what_is_in_its_box_but_leaves_the_floor():\n    points = [\n        [0.0, 0.5, 0.0],  # In the box.\n        [0.0, 1.0, 0.0],  # On the floor, under the box.\n        [0.0, 0.2, 0.0],  # Above the box.\n        [3.0, 0.5, 0.0],  # Elsewhere.\n    ]\n    # Height along up is -y, so the floor at y = 1 is at -1.\n    base, pieces = split_movable(\n        scene(points), [box(\"cart\", [-0.5, 0.3, -0.5], [0.5, 1.0, 0.5])], -1.0, UP\n    )\n    assert pieces[\"cart\"].positions[:, 1].tolist() == [0.5]\n    assert sorted(base.positions[:, 1].tolist()) == pytest.approx([0.2, 0.5, 1.0])\n    assert len(base) == 3\n\n\ndef test_overlapping_boxes_never_share_a_splat():\n    points = [[0.0, 0.5, 0.0], [0.4, 0.5, 0.0]]\n    base, pieces = split_movable(\n        scene(points),\n        [box(\"a\", [-0.2, 0.3, -0.2], [0.2, 0.7, 0.2]), box(\"b\", [-0.2, 0.3, -0.2], [0.6, 0.7, 0.2])],\n        -1.0,\n        UP,\n    )\n    assert len(pieces[\"a\"]) == 1 and len(pieces[\"b\"]) == 1 and len(base) == 0\n"}},"serverClassifierRequest":"716784ab-1246-4738-a541-5d793dfa10a7","apiBlockIndex":3,"requestId":"req_011CgoA7xWh92QYyRgNEddGp","requestRef":"08030d42-16dd-4075-92fa-ee5b00816faa","requestedModel":"claude-opus-5-5","promptCacheRequested":"1h","type":"assistant","uuid":"1f93723e-5d16-4a06-bed1-83ddd120f06e","timestamp":"2026-11-07T07:17:10.874Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-vscode","cwd":"/home/viktor-trilar/Projects/Newbies","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","version":"2.1.319","gitBranch":"viktor/moving-splats","slug":"vast-jumping-lobster"}
{"parentUuid":"1f93723e-5d16-4a06-bed1-83ddd120f06e","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgoA7y6uu4ps6jtgp27cB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ARjJqwzTS93v4ARqD1KhMe","name":"Bash","input":{"command":"cd /home/viktor-trilar/Projects/Newbies; S=/tmp/claude-1000/-home-viktor-trilar-Projects-Newbies/6293938d-e68f-4310-92b7-6bf722e3d028/scratchpad; python3 - <<'EOF'\np='web/objects.js'; t=open(p).read()\nt=t.replace('''import * as THREE from \"three\";\n''','''import * as THREE from \"three\";\nimport { SplatMesh } from \"@sparkjsdev/spark\";\n''',1)\nt=t.replace('''  const roomCenter = new THREE.Vector3();\n''','''  // Objects cut out of the scan, so dragging one moves the real thing and not only its outline.\n  const pieces = [];\n  for (const id of await fetchPieces()) {\n    const object = byId.get(id);\n    if (!object) continue;\n    object.piece = new SplatMesh({ url: `pieces/${id}.ply` });\n    root.add(object.piece);\n    pieces.push(object.piece);\n  }\n\n  const roomCenter = new THREE.Vector3();\n''',1)\nt=t.replace('''    splat.visible = state.view !== \"objects\";\n''','''    splat.visible = state.view !== \"objects\";\n    for (const piece of pieces) piece.visible = splat.visible;\n''')\nt=t.replace('''    object.center.add(delta);\n    if (item) {''','''    object.center.add(delta);\n    object.piece?.position.add(delta);\n    if (item) {''')\nt=t.replace('''      object.center.copy(home);\n''','''      object.center.copy(home);\n      object.piece?.position.set(0, 0, 0);\n''')\nt=t.replace('''async function fetchShapes() {''','''async function fetchPieces() {\n  try {\n    const response = await fetch(\"pieces.json\");\n    return response.ok ? await response.json() : [];\n  } catch {\n    return [];\n  }\n}\n\nasync function fetchShapes() {''')\nopen(p,'w').write(t)\np='web/serve.py'; t=open(p).read()\nt=t.replace('''        route = path.split(\"?\", 1)[0]\n        if route in self.routes:\n            return str(self.routes[route])\n''','''        route = path.split(\"?\", 1)[0]\n        if route in self.routes:\n            return str(self.routes[route])\n        pieces = self.routes.get(\"/pieces/\")\n        if pieces and route.startswith(\"/pieces/\"):\n            return str(pieces / Path(route).name)\n''')\nt=t.replace('''    p.add_argument(\"--host\", default=\"0.0.0.0\")\n''','''    p.add_argument(\"--pieces\", type=Path, help=\"folder from app.scene.split_movable\")\n    p.add_argument(\"--host\", default=\"0.0.0.0\")\n''')\nt=t.replace('''    handler = functools.partial(Handler, routes=routes)\n''','''    if args.pieces:\n        routes[\"/pieces.json\"] = (args.pieces / \"pieces.json\").resolve()\n        routes[\"/pieces/\"] = (args.pieces / \"pieces\").resolve()\n    handler = functools.partial(Handler, routes=routes)\n''')\nopen(p,'w').write(t)\np='Makefile'; t=open(p).read()\nt=t.replace('''MODEL ?= Qwen3.5-9B\n''','''PIECES_OBJECTS ?= obj-0067 obj-0008\nPIECES_FROM ?= $(SCENE_DIR)/Equipment Room.ply\nPIECES_DIR ?= $(SCENE_DIR)/cut\nMODEL ?= Qwen3.5-9B\n''')\nt=t.replace(\"scene scene-full model gpu\",\"scene scene-full model pieces gpu\")\nt=t.replace('''gpu:     ## check the GPU works''','''pieces:  ## cut movable objects out of a scene, so dragging moves the real thing. Then: make web SCENE=$(PIECES_DIR)/base.ply PIECES=$(PIECES_DIR)\n\tuv run python -m app.scene.split_movable \"$(PIECES_FROM)\" $(SCENE_DIR)/assets_viewer.json $(PIECES_DIR) --objects $(PIECES_OBJECTS)\ngpu:     ## check the GPU works''',1)\nt=t.replace('''$(if $(SHAPES),--shapes \"$(SHAPES)\")''','''$(if $(SHAPES),--shapes \"$(SHAPES)\") $(if $(PIECES),--pieces \"$(PIECES)\")''')\nopen(p,'w').write(t)\nEOF\ngrep -c 'PIECES),--pieces' Makefile; cat > \"$S/drag_test.py\" <<'EOF'\nimport sys,json\nfrom playwright.sync_api import sync_playwright\nS=sys.argv[1]\nwith sync_playwright() as p:\n    b=p.chromium.launch(executable_path='/snap/bin/chromium',headless=True,args=['--no-sandbox','--use-angle=swiftshader','--enable-unsafe-swiftshader','--ignore-gpu-blocklist'])\n    pg=b.new_context(viewport={'width':960,'height':540}).new_page(); errs=[]\n    pg.on('console',lambda m: errs.append(m.text[:160]) if m.type=='error' else None); pg.on('pageerror',lambda e: errs.append(str(e)[:200]))\n    cam='-1.2,0.42,3.3,0.2,-0.28'\n    # Camera is in world coordinates, upright: x same, y and z flipped from scene coordinates.\n    pg.goto(f'http://127.0.0.1:8123/?lod=0&res=0.5&camera=-0.3,0.433,0.6,0.55,-0.42'); pg.wait_for_function(\"window.plantViewer!==undefined\",timeout=240000); pg.wait_for_timeout(6000)\n    print('status',pg.inner_text('#status')[:70]); pg.screenshot(path=S+'/drag_0.png')\n    print('pieces',pg.evaluate(\"window.plantViewer.objects.filter(o=>o.piece).map(o=>o.asset.object_id)\"))\n    pg.click('#go-fault'); pg.wait_for_function(\"window.plantViewer.route.state.route!==null\",timeout=30000); print('before:',pg.inner_text('#status'))\n    before=pg.evaluate(\"\"\"()=>{const R=window.plantViewer.route;return {len:R.state.route.length,path:R.state.route.path.map(p=>[+p[0].toFixed(2),+p[2].toFixed(2)])}}\"\"\"); print(before)\n    # Start from a fixed point for a repeatable route: the map centre.\n    r=pg.evaluate(\"\"\"async()=>{const v=window.plantViewer,R=v.route;v.camera.position.set(0,-1.167+1.6,0);await R.plan(R.state.target);const o=v.objects.find(x=>x.asset.object_id==='obj-0067');\n       const screen=(q)=>{const w=o.box.parent.localToWorld(q.clone());v.camera.updateMatrixWorld();w.project(v.camera);return [(w.x+1)/2*innerWidth,(1-w.y)/2*innerHeight,w.z]};return {len:R.state.route.length,home:o.center.toArray()}}\"\"\"); print('from centre',r)\n    pg.evaluate(\"\"\"()=>{const v=window.plantViewer;v.camera.position.set(-1.5,1.1,0.4);v.camera.rotation.set(-0.85,0.1,0,'YXZ');v.camera.updateMatrixWorld()}\"\"\"); pg.wait_for_timeout(3000)\n    pg.evaluate(\"\"\"()=>{const v=window.plantViewer;const o=v.objects.find(x=>x.asset.object_id==='obj-0067');window.__o=o;v.showInfo(o)}\"\"\"); pg.wait_for_timeout(800)\n    print('move hidden',pg.evaluate(\"document.getElementById('move').hidden\"));\n    pg.screenshot(path=S+'/drag_1.png')\n    pg.click('#move'); pg.wait_for_timeout(300)\n    # Project the floor at the cage and at the target, and drag between them with a real mouse.\n    q=pg.evaluate(\"\"\"()=>{const v=window.plantViewer,o=window.__o;const T=window.__T=v.objects[0].box.parent;const s=(x,z)=>{const w=T.localToWorld(new o.center.constructor(x,1.167,z));v.camera.updateMatrixWorld();w.project(v.camera);return [(w.x+1)/2*innerWidth,(1-w.y)/2*innerHeight]};const c=o.center;return {a:s(c.x,c.z),b:s(-1.46,-1.75),home:c.toArray()}}\"\"\"); print(q)\n    a,bb=q['a'],q['b']; pg.mouse.move(*a); pg.mouse.down(); pg.mouse.move((a[0]+bb[0])/2,(a[1]+bb[1])/2,steps=4); pg.mouse.move(*bb,steps=4); pg.mouse.up(); pg.wait_for_timeout(2500)\n    res=pg.evaluate(\"\"\"()=>{const v=window.plantViewer,o=window.__o,R=v.route;return {center:o.center.toArray().map(x=>+x.toFixed(2)),piece:o.piece.position.toArray().map(x=>+x.toFixed(2)),changes:v.objectLayer.state.changes,posted:R.state.posted,len:R.state.route?R.state.route.length:null,status:document.getElementById('status').textContent}}\"\"\"); print('after drag',json.dumps(res)[:420])\n    pg.wait_for_timeout(5000); pg.screenshot(path=S+'/drag_2.png')\n    pg.click('#reset-moves'); pg.wait_for_timeout(2000); print('undo',pg.evaluate(\"\"\"()=>{const v=window.plantViewer,o=window.__o;return {piece:o.piece.position.toArray(),center:o.center.toArray().map(x=>+x.toFixed(2)),len:v.route.state.route&&v.route.state.route.length}}\"\"\"),pg.inner_text('#status')[:90])\n    print('errors',len(errs),errs[:4]); b.close()\nEOF\nT=\"$S/make_test\"; uv run --no-sync --with numpy python -m app.scene.split_movable \"$T/light_400k.ply\" \"$T/assets_viewer.json\" \"$S/cut_test\" --objects obj-0067 obj-0008 2>&1 | tail -1 | cut -c1-120; uv run