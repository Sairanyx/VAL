ct.center.add(delta);\n    if (item) {\n      item.moved.add(delta);\n      placeAll();\n    }\n  }\n\n  function resetMoves() {\n    for (const object of objects) {\n      const item = items.find((candidate) => candidate.object === object);\n      const home = new THREE.Vector3(...object.asset.center);\n      const delta = home.clone().sub(object.center);\n      object.box.position.add(delta);\n      object.pick.position.add(delta);\n      object.center.copy(home);\n      if (item) {\n        item.moved.set(0, 0, 0);\n        object.pick.position.copy(item.home);\n      }\n    }\n    placeAll();\n    state.changes.length = 0;\n    onChange?.(state.changes);\n  }\nweb/route.js:43:  root.add(group);\nweb/route.js:57:      group.remove(child);\nweb/route.js:72:      group.add(piece);\nweb/route.js:78:    group.add(end);\nweb/objects.js:13:  root.add(group);\nweb/objects.js:20:    group.add(mesh);\nweb/objects.js:26:  objects.forEach((o) => roomCenter.add(o.center));\nweb/objects.js:49:      item.mesh.position.copy(item.home).add(item.moved).add(offset);\nweb/objects.js:95:    object.box.position.add(delta);\nweb/objects.js:96:    object.pick.position.add(delta);\nCounter({'fixed': 223, 'unsure': 158, 'movable': 59})\nshapes 65 movable with shape 23 of 59\n[('cart', 14), ('box', 14), ('bag', 9), ('bucket', 9), ('ladder', 7), ('chair', 3), ('tool', 3)]\n[('obj-0041', 'box', [0.63, 0.33, 0.48]), ('obj-0062', 'box', [0.42, 0.35, 0.56]), ('obj-0095', 'box', [0.51, 0.29, 0.23]), ('obj-0104', 'bucket', [0.22, 0.24, 0.28]), ('obj-0112', 'box', [0.51, 0.27, 0.41]), ('obj-0126', 'box', [0.34, 0.69, 0.25]), ('obj-0148', 'bucket', [0.25, 0.52, 0.48]), ('obj-0150', 'box', [0.36, 0.2, 0.3]), ('obj-0161', 'box', [0.19, 0.37, 0.31]), ('obj-0168', 'bucket', [0.3, 0.29, 0.25]), ('obj-0184', 'box', [0.24, 0.23, 0.34]), ('obj-0209', 'box', [0.33, 0.17, 0.28]), ('obj-0210', 'box', [0.52, 0.29, 0.31]), ('obj-0211', 'box', [0.29, 0.3, 0.34])]\n[(\"label isn't confirmed\", 70), ('no rule for