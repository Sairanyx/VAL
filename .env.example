ENV=dev

# --- LLM APIs (fill in the ones you have) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
HF_TOKEN=
# Featherless AI ($25 event credit) - open-weight models, OpenAI-compatible
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
# Google Gemini (AI Studio key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Which provider ask() uses by default: anthropic | openai | featherless | gemini
LLM_PROVIDER=anthropic

# --- Deploy ---
DOMAIN=
VPS=
# Google Cloud (Cloud Run fallback hosting)
GCP_PROJECT=
GCP_REGION=europe-north1
