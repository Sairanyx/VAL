#!/usr/bin/env bash
# Start the whole demo with one command. Ctrl+C stops it.
#
#   ./start browser    PC with a graphics card: full-quality scene, mouse layout
#   ./start laptop     Laptop with no graphics card: lighter scene, mouse layout
#   ./start tablet     Lenovo tablet: lighter scene, touch layout, prints the address to open
#
# The tablet uses HTTPS, as its mic and motion sensors need it. It shows a certificate warning once.
# Add --https to the others to do the same.
set -euo pipefail
cd "$(dirname "$0")"

usage() {
  sed -n '4,6p;8,9p' "$0" | sed 's/^# \?//'
  exit 1
}

VERSION="${1:-}"
[[ "$VERSION" == "browser" || "$VERSION" == "laptop" || "$VERSION" == "tablet" ]] || usage
HTTPS_FLAG=""
[[ "${2:-}" == "--https" || "$VERSION" == "tablet" ]] && HTTPS_FLAG="HTTPS=1"

SCENE_DIR="data/scene/equipment_room"
ASSETS="$SCENE_DIR/assets_mapped.json"
for needed in "$ASSETS" "$SCENE_DIR/nav_grid.npz" "$SCENE_DIR/cut/base.ply"; do
  if [[ ! -f "$needed" ]]; then
    echo "Missing $needed. Run this once, with internet: make scene mapping pieces highlights"
    exit 1
  fi
done

# The first free port from a number up, so another program on 8000 or 8001 doesn't stop the demo.
free_port() {
  local port=$1
  while python3 -c "import socket,sys; s=socket.socket(); sys.exit(0 if s.connect_ex(('127.0.0.1', $port)) == 0 else 1)" \
    || [[ "$port" == "${2:-}" ]]; do
    port=$((port + 1))
  done
  echo "$port"
}
API_PORT="$(free_port 8001)"
WEB_PORT="$(free_port 8000 "$API_PORT")"
export API_PORT WEB_PORT

if [[ "$VERSION" != "browser" ]]; then
  CUT="$SCENE_DIR/cut_light"
  if [[ ! -f "$CUT/base.ply" ]]; then
    echo "Cutting a lighter scene, once..."
    make pieces PIECES_FROM="$SCENE_DIR/light_full.ply" PIECES_DIR="$CUT"
  fi
else
  CUT="$SCENE_DIR/cut"
fi

if [[ ! -f data/models/whisper-small.en/model.bin ]]; then
  echo "Note: no speech model, so the mic won't work. Run this once, with internet: make voice-model"
fi

# Saves changes across restarts. The demo still runs without it.
make db || echo "No database, so changes last until the API stops."

# Stops the API and viewer together, including on Ctrl+C.
trap 'trap - EXIT TERM INT; kill 0 2>/dev/null || true' EXIT TERM INT
make api &

SCHEME="http"
[[ -n "$HTTPS_FLAG" ]] && SCHEME="https"
echo
if [[ "$VERSION" == "tablet" ]]; then
  ADDRESS="$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')"
  echo "Tablet: open $SCHEME://${ADDRESS:-THIS-MACHINE-IP}:$WEB_PORT on the same network."
  echo "Accept the certificate warning once. The mic only works on this https address."
  echo "If it can't connect, allow the port: sudo ufw allow $WEB_PORT/tcp"
else
  echo "Browser: opening $SCHEME://localhost:$WEB_PORT in a moment"
fi
echo

# Open the viewer in this machine's browser once it answers. A tablet opens it on the tablet instead.
# NO_BROWSER=1 skips this; OPEN_PATH adds to the address, such as ?tour to offer the tutorial.
open_when_ready() {
  local url="$SCHEME://localhost:$WEB_PORT/${OPEN_PATH:-}"
  for _ in $(seq 180); do
    curl -skf -o /dev/null "$SCHEME://localhost:$WEB_PORT/" && break
    sleep 1
  done
  ${BROWSER_CMD:-xdg-open} "$url" >/dev/null 2>&1 || echo "Open $url in a browser."
}
if [[ "$VERSION" != "tablet" && -z "${NO_BROWSER:-}" ]]; then
  open_when_ready &
fi

make web SCENE="$CUT/base.ply" ASSETS="$ASSETS" SHAPES="$SCENE_DIR/shapes.json" PIECES="$CUT" $HTTPS_FLAG
