:\n            return str(self.routes[route])\n''','''        route = path.split(\"?\", 1)[0]\n        if route in self.routes:\n            return str(self.routes[route])\n        pieces = self.routes.get(\"/pieces/\")\n        if pieces and route.startswith(\"/pieces/\"):\n            return str(pieces / Path(route).name)\n''')\nt=t.replace('''    p.add_argument(\"--host\", default=\"0.0.0.0\")\n''','''    p.add_argument(\"--pieces\", type=Path, help=\"folder from app.scene.split_movable\")\n    p.add_argument(\"--host\", default=\"0.0.0.0\")\n''')\nt=t.replace('''    handler = functools.partial(Handler, routes=routes)\n''','''    if args.pieces:\n        routes[\"/pieces.json\"] = (args.pieces / \"pieces.json\").resolve()\n        routes[\"/pieces/\"] = (args.pieces / \"pieces\").resolve()\n    handler = functools.partial(Handler, routes=routes)\n''')\nopen(p,'w').write(t)\np='Makefile'; t=open(p).read()\nt=t.replace('''MODEL ?= Qwen3.5-9B\n''','''PIECES_OBJECTS ?= obj-0067 obj-0008\nPIECES_FROM ?= $(SCENE_DIR)/Equipment Room.ply\nPIECES_DIR ?= $(SCENE_DIR)/cut\nMODEL ?= Qwen3.5-9B\n''')\nt=t.replace(\"scene scene-full model gpu\",\"scene scene-full model pieces gpu\")\nt=t.replace('''gpu:     ## check the GPU works''','''pieces:  ## cut movable objects out of a scene, so dragging moves the real thing. Then: make web SCENE=$(PIECES_DIR)/base.ply PIECES=$(PIECES_DIR)\n\tuv run python -m app.scene.split_movable \"$(PIECES_FROM)\" $(SCENE_DIR)/assets_viewer.json $(PIECES_DIR) --objects $(PIECES_OBJECTS)\ngpu:     ## check the GPU works''',1)\nt=t.replace('''$(if $(SHAPES),--shapes \"$(SHAPES)\")''','''$(if $(SHAPES),--shapes \"$(SHAPES)\") $(if $(PIECES),--pieces \"$(PIECES)\")''')\nopen(p,'w').write(t)\nEOF\ngrep -c 'PIECES),--pieces' Makefile; cat > \"$S/drag_test.py\" <<'EOF'\nimport sys,json\nfrom playwright.sync_api import sync_playwright\nS=sys.argv[1]\nwith sync_playwright() as p:\n    b=p.chromium.launch(executable_path='/snap/bin/chromium',headless=True,args=['--no-sandbox','--use-angle=swiftshader','--enable-unsafe-swiftshader','--ignore-gpu-blocklist'])\n    pg=b.new_context(viewport={'width':960,'height':540}).new_page(); errs=[]\n    pg.on('console',lambda m: errs.append(m.text[:160]) if m.type=='error' else None); pg.on('pageerror',lambda e: errs.append(str(e)[:200]))\n    cam='-1.2,0.42,3.3,0.2,-0.28'\n    # Camera is in world coordinates, upright: x same, y and z flipped from scene coordinates.\n    pg.goto(f'http://127.0.0.1:8123/?lod=0&res=0.5&camera=-0.3,0.433,0.6,0.55,-0.42'); pg.wait_for_function(\"window.plantViewer!==undefined\",timeout=240000); pg.wait_for_timeout(6000)\n    print('status',pg.inner_text('#status')[:70]); pg.screenshot(path=S+'/drag_0.png')\n    print('pieces',pg.evaluate(\"window.plantViewer.objects.filter(o=>o.piece).map(o=>o.asset.object_id)\"))\n    pg.click('#go-fault'); pg.wait_for_function(\"window.plantViewer.route.state.route!==null\",timeout=30000); print('before:',pg.inner_text('#status'))\n    before=pg.evaluate(\"\"\"()=>{const R=window.plantViewer.route;return {len:R.state.route.length,path:R.state.route.path.map(p=>[+p[0].toFixed(2),+p[2].toFixed(2)])}}\"\"\"); print(before)\n    # Start from a fixed point for a repeatable route: the map centre.\n    r=pg.evaluate(\"\"\"async()=>{const v=window.plantViewer,R=v.route;v.camera.position.set(0,-1.167+1.6,0);await R.plan(R.state.target);const o=v.objects.find(x=>x.asset.object_id==='obj-0067');\n       const screen=(q)=>{const w=o.box.parent.localToWorld(q.clone());v.camera.updateMatrixWorld();w.project(v.camera);return [(w.x+1)/2*innerWidth,(1-w.y)/2*innerHeight,w.z]};return {len:R.state.route.length,home:o.center.toArray()}}\"\"\"); print('from centre',r)\n    pg.evaluate(\"\"\"()=>{const v=window.plantViewer;v.camera.position.set(-1.5,1.1,0.4);v.camera.rotation.set(-0.85,0.1,0,'YXZ');v.camera.updateMatrixWorld()}\"\"\"); pg.wait_for_timeout(3000)\n    pg.evaluate(\"\"\"()=>{const v=window.plantViewer;const o=v.objects.find(x