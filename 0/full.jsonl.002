 top: 12px;\n  left: 12px;\n  padding: 8px 12px;\n  border-radius: 6px;\n  background: var(--panel);\n  pointer-events: none;\n  max-width: calc(100vw - 24px);\n}\n#status { font-weight: 600; }\n#stats, #in-view { color: var(--muted); font-size: 12px; }\n\n#crosshair {\n  position: fixed;\n  top: 50%;\n  left: 50%;\n  width: 8px;\n  height: 8px;\n  margin: -4px 0 0 -4px;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.6);\n  pointer-events: none;\n}\n\n#labels {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n}\n.label {\n  position: absolute;\n  transform: translate(-50%, -100%);\n  padding: 2px 6px;\n  border-radius: 4px;\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.3px;\n  white-space: nowrap;\n  pointer-events: none;\n  transition: opacity 0.15s;\n}\n.label.fault  { background: var(--danger); color: #fff; }\n.label.mapped { background: var(--accent); color: #000; }\n.label.plain  { background: rgba(0, 0, 0, 0.7); color: #fff; }\n\n#joystick {\n  position: fixed;\n  left: 24px;\n  bottom: 24px;\n  width: 120px;\n  height: 120px;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.08);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  touch-action: none;\n}\n#joystick div {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 48px;\n  height: 48px;\n  margin: -24px 0 0 -24px;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.6);\n}\n@media (pointer: fine) {\n  #joystick { display: none; }\n}\n\n/* Wraps upwards on narrow screens, so no button slides off the edge. */\n#buttons {\n  position: fixed;\n  left: 12px;\n  right: 12px;\n  bottom: 12px;\n  display: flex;\n  flex-wrap: wrap-reverse;\n  justify-content: flex-end;\n  gap: 8px;\n  pointer-events: none;\n}\n#buttons button {\n  pointer-events: auto;\n}\nbutton {\n  min-width: 64px;\n  min-height: 44px;\n  padding: 0 14px;\n  border: 1px solid #3a4652;\n  border-radius: 6px;\n  background: var(--panel);\n  color: var(--text);\n  font: inherit;\n}\n\n#info {\n  position: fixed;\n  top: 12px;\n  right: 12px;\n  width: min(300px, calc(100vw - 24px));\n  padding: 12px 14px;\n  border-radius: 6px;\n  background: var(--panel);\n}\n#info-close {\n  position: absolute;\n  top: 4px;\n  right: 4px;\n  min-width: 36px;\n  min-height: 36px;\n  border: 0;\n  background: none;\n  font-size: 20px;\n}\n#info h2 { margin: 0 0 6px; font-size: 16px; }\n#info dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; margin: 0; }\n#info dt { color: var(--muted); }\n#info dd { margin: 0; }\n\n#copilot {\n  position: fixed;\n  top: 12px;\n  left: 12px;\n  width: min(420px, calc(100vw - 24px));\n  max-height: calc(100vh - 90px);\n  overflow-y: auto;\n  padding: 12px 14px;\n  border-radius: 8px;\n  background: rgba(17, 22, 28, 0.94);\n  color: #e5e7eb;\n  z-index: 5;\n}\n#copilot[hidden],\n#info[hidden] {\n  display: none;\n}\n#copilot h2 {\n  margin: 0 0 8px;\n  font-size: 16px;\n}\n#copilot h3 {\n  margin: 10px 0 2px;\n  font-size: 13px;\n  color: #9ca3af;\n}\n#copilot ul {\n  margin: 4px 0 0 18px;\n  padding: 0;\n  font-size: 13px;\n  line-height: 1.45;\n}\n#copilot li {\n  margin: 2px 0;\n}\n#copilot-close {\n  position: absolute;\n  top: 6px;\n  right: 6px;\n  min-width: 36px;\n  min-height: 36px;\n  border: 0;\n  background: none;\n  color: #9ca3af;\n  font-size: 22px;\n  cursor: pointer;\n}\n#copilot-form {\n  display: flex;\n  gap: 6px;\n  margin: 8px 0;\n}\n#copilot-input {\n  flex: 1;\n  min-height: 44px;\n  padding: 0 10px;\n  border: 1px solid #3a4652;\n  border-radius: 6px;\n  background: #0f1419;\n  color: #e5e7eb;\n  font-size: 16px;\n}\n#copilot-answer p {\n  margin: 8px 0;\n  font-size: 14px;\n  line-height: 1.4;\n}\n#copilot-answer .warning,\n#info-condition {\n  color: #fbbf24;\n}\n#copilot-answer .note {\n  color: #9ca3af;\n  font-size: 12px;\n}\n#info-condition {\n  margin: 8px 0;\n  font-size: 13px;\n}\n#info-condition:empty {\n  display: none;\n}\n\n#selec