", \"assets\": [source]}))\n    client = TestClient(create_app(path, database=FakeDatabase()))\n    change = {\"op\": \"duplicate\", \"object_id\": \"pump\", \"position\": [3, 1, 0]}\n    made = client.post(\"/api/changes\", json=change).json()[\"parts\"]\n    copy = client.get(f\"/api/assets/{made[0]}\").json()\n    assert copy[\"label\"] == \"pump\" and copy[\"center\"] == [3, 1, 0]\n    assert copy[\"mapping\"] is None and copy[\"duplicated_from\"] == \"pump\"\n    assert client.get(\"/api/assets/pump\").json()[\"mapping\"][\"tag\"] == \"P-005\"\n    second = {\"op\": \"duplicate\", \"object_id\": copy[\"object_id\"], \"position\": [5, 1, 0]}\n    again = client.post(\"/api/changes\", json=second).json()[\"parts\"][0]\n    assert again != copy[\"object_id\"]\n    assert client.get(f\"/api/assets/{again}\").json()[\"duplicated_from\"] == \"pump\"\n    split = {\"op\": \"split\", \"object_id\": copy[\"object_id\"], \"details\": {}}\n    assert client.post(\"/api/changes\", json=split).status_code == 409\n    client.post(\"/api/changes/reset\")\n    assert client.get(f\"/api/assets/{copy['object_id']}\").status_code == 404\nEOF\ncat >> tests/test_copilot.py <<'EOF'\n\n\n# -------------------------------------------------------------------------\n# Val: questions with no device behind them, and objects with no record\n# -------------------------------------------------------------------------\n\n\n@pytest.mark.parametrize(\"question\", [\"hi\", \"Hello Val!\", \"thanks\", \"Who are you?\", \"help\"])\ndef test_small_talk_never_answers_about_a_device(copilot, question):\n    copilot.set_focus(\"P-005\")\n    reply = copilot.query(question)\n    assert \"P-005\" not in reply.answer and not reply.citations\n\n\ndef test_val_says_what_needs_attention_from_the_records(copilot):\n    copilot.focused_asset_tag = None\n    reply = copilot.query(\"What needs attention?\")\n    worst = min(\n        (s for a in copilot.store.list_assets() if (s := copilot.store.get_current_state(a.asset_id))\n         and s.urgency == \"high\"),\n        key=lambda s: s.health_score,\n    )\n    assert worst.tag in reply.answer and worst.asset_id in reply.citations\n\n\ndef test_val_doesnt_answer_other_topics_with_a_diagnosis(copilot):\n    reply = copilot.query(\"Which spare parts do I need?\", object_id=None)\n    assert \"spare parts\" in reply.answer and \"health\" not in reply.answer\n\n\ndef test_unrelated_question_doesnt_get_the_last_devices_diagnosis(copilot):\n    copilot.set_focus(\"P-005\")\n    assert \"health\" not in copilot.query(\"What colour is the sky?\").answer\n\n\ndef test_object_with_no_record_is_never_treated_as_the_fault(copilot):\n    copilot.sample_assets = [{\"object_id\": \"cart-1\", \"label\": \"cart\", \"confidence\": 0.5}]\n    copilot.mapping = {}\n    copilot.focused_asset_tag = None\n    reply = copilot.query(\"What's wrong with it?\", object_id=\"cart-1\")\n    assert \"isn't linked\" in reply.answer and \"P-005\" not in reply.answer\n    route = copilot.query(\"Take me there\", object_id=\"cart-1\")\n    assert [a[\"object_id\"] for a in route.actions if a[\"type\"] == \"navigate\"] == [\"cart-1\"]\nEOF\nuv run --only-group dev ruff format app tests 2>&1 | tail -1 | cut -c1-60; uv run --only-group dev ruff check app tests 2>&1 | grep -E \"^[A-Z][0-9]+ |-->|All checks\" | cut -c1-90; grep -n '\"far\"\\|def client\\|box(\"' tests/test_api.py | head -6 | cut -c1-90; R=/home/viktor-trilar/Projects/Newbies; (cd \"$R\" && timeout 150 uv run --no-project --with numpy --with scipy --with pandas --with openpyxl --with pytest --with fastapi --with httpx --with pillow --with 'psycopg[binary]' python -m pytest -q -p no:cacheprovider \"$W/tests\" --rootdir=\"$W\" --import-mode=importlib -x -q 2>&1 | tail -3 | cut -c1-150); (cd \"$W\" && PYTHONPATH=. uv run --no-project --with numpy --with scipy --with pandas --with openpyxl --with pytest --with fastapi --with httpx --with pillow --with 'psycopg[binary]' --with ifcopenshell --with e