{"parentUuid":"541e1478-e4a9-4ad6-8d2b-67cd8bbf7c2c","isSidechain":false,"promptId":"460631f3-8774-47f9-af6b-bf8f7d35ca9a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EDWZoRa8ytNHWFXgvD3mDa","type":"tool_result","content":"File created successfully at: /home/viktor-trilar/Projects/Newbies/tests/test_frame_crops.py (file state is current in your context — no need to Read it back)"}]},"uuid":"dcd777b3-bd91-4208-8d9b-0c60c12792d3","timestamp":"2026-11-07T04:10:05.056Z","toolUseResult":{"type":"create","filePath":"/home/viktor-trilar/Projects/Newbies/tests/test_frame_crops.py","content":"import pytest\n\nnp = pytest.importorskip(\"numpy\")\npytest.importorskip(\"scipy\")\npytest.importorskip(\"PIL\")\n\nfrom app.extract.frame_crops import (  # noqa: E402\n    choose_frames,\n    frame_score,\n    moved_camera,\n    seen_points,\n)\n\nCAMERA = np.array([[100.0, 0, 50], [0, 100.0, 50], [0, 0, 1]])\n\n\ndef test_points_on_the_video_surface_count_and_others_do_not():\n    depth = np.full((100, 100), 2.0)\n    points = np.array(\n        [\n            [0.0, 0.0, 2.0],  # On the surface.\n            [0.0, 0.0, 1.0],  # In front of it: the video shows nothing there, so it had moved.\n            [0.0, 0.0, 3.0],  # Behind it, so hidden.\n            [50.0, 0.0, 2.0],  # Outside the image.\n            [0.0, 0.0, -2.0],  # Behind the camera.\n        ]\n    )\n    _, seen = seen_points(points, np.eye(4), CAMERA, depth)\n    assert seen.tolist() == [True, False, False, False, False]\n\n\ndef test_large_whole_objects_score_above_small_or_cut_off_ones():\n    whole = np.array([[20.0, 20.0], [70.0, 70.0]])\n    small = np.array([[50.0, 50.0], [52.0, 52.0]])\n    cut_off = np.array([[0.0, 20.0], [50.0, 70.0]])\n    shape = (100, 100)\n    assert frame_score(whole, shape, 1.0) > frame_score(small, shape, 1.0)\n    assert frame_score(whole, shape, 1.0) > frame_score(cut_off, shape, 1.0)\n\n\ndef test_chosen_frames_are_the_best_ones_kept_apart():\n    scores = [(0.9, 10), (0.8, 11), (0.7, 30), (0.6, 50)]\n    assert choose_frames(scores, 2, 5) == [10, 30]\n\n\ndef test_moved_camera_sees_a_moved_point_where_it_saw_the_original():\n    turn = np.array([[0.0, 0, 1], [0, 1, 0], [-1, 0, 0]])\n    align = {\"scale\": 2.0, \"R\": turn.tolist(), \"t\": [1.0, 2.0, 3.0]}\n    camera = np.eye(4)\n    camera[:3, 3] = [0.5, 0.0, 4.0]\n    point = np.array([1.0, 2.0, 3.0])\n    moved = 2.0 * turn @ point + np.array([1.0, 2.0, 3.0])\n    before = camera[:3, :3] @ point + camera[:3, 3]\n    new = moved_camera(camera, align)\n    after = new[:3, :3] @ moved + new[:3, 3]\n    np.testing.assert_allclose(after, before * 2.0, atol=1e-9)  # Same direction, scaled depth.\n","structuredPatch":[],"originalFile":null,"userModified":false},"serverClassifierContext":{"request":"82098983-eb4a-4f2f-b3b4-a70e373d90dc","context":{"git_state":{"cwd":"/home/viktor-trilar/Projects/Newbies","root":"/home/viktor-trilar/Projects/Newbies","branch":"viktor/demo-fixes","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"Sairanyx/Newbies","visibility":"unknown"}]}},"live_cwd":"/home/viktor-trilar/Projects/Newbies","platform":"linux"}},"sourceToolAssistantUUID":"541e1478-e4a9-4ad6-8d2b-67cd8bbf7c2c","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-vscode","cwd":"/home/viktor-trilar/Projects/Newbies","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","version":"2.1.319","gitBranch":"viktor/demo-fixes","slug":"vast-jumping-lobster"}
