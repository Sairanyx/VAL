(\n            object_id=object_id,\n            mapping=None,\n            status=\"new, unconfirmed\",\n            duplicated_from=root,\n            copied_name=original,\n            name=f\"{original} copy {count}\",\n        )\n'''),\n('''    def _combine(self, first: dict, details: dict | None) -> str:''', '''    def _rename(self, asset: dict, name: Any) -> None:\n        \"\"\"Give an object a name to show. A name is a label, and never a link to a record.\"\"\"\n        name = name.strip() if isinstance(name, str) else \"\"\n        if not name or len(name) > MAX_NAME_LENGTH:\n            raise ChangeError(f\"A name needs 1 to {MAX_NAME_LENGTH} characters\")\n        if asset.get(\"mapping\"):\n            raise ChangeError(f\"{asset['object_id']} is named by its record\")\n        for other in self.assets.values():\n            tag = (other.get(\"mapping\") or {}).get(\"tag\")\n            if tag and tag.lower() == name.lower():\n                raise ChangeError(f\"{tag} is a record's tag, so it can't name another object\")\n        asset[\"name\"] = name\n\n    def _combine(self, first: dict, details: dict | None) -> str:'''),\n('''GONE = {\"removed\", \"split\", \"combined\"}\n''', '''GONE = {\"removed\", \"split\", \"combined\"}\nMAX_NAME_LENGTH = 40\n'''),\n])\nt = open(\"app/api/store.py\").read()\nif \"from typing import\" not in t or \"Any\" not in t.split(\"class \")[0]:\n    print(\"store needs Any import\")\npatch(\"app/api/main.py\", [('\"split\", \"combine\", \"duplicate\"]', '\"split\", \"combine\", \"duplicate\", \"rename\"]')])\npatch(\"app/api/commands.py\", [('''    \"delete_object\": {\"args\": OBJECT,''', '''    \"rename_object\": {\n        \"args\": {\"object_id\": \"str\", \"name\": \"str\"},\n        \"does\": \"Name an object with no record link\",\n    },\n    \"delete_object\": {\"args\": OBJECT,''')])\npatch(\"app/api/copilot_link.py\", [('''            \"label\": asset.get(\"label\", \"object\"),\n''', '''            \"label\":