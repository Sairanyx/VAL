joins if in the object's masks in 60% of views | 25 of 54 match masks at IoU 0.7 or better, but the score doesn't predict the look: by eye, 3 of those 25 are clean (two chairs, one box), piled objects leave smears, and the roll cage is better cut by box. Four objects shipped, the rest move as outlines | Minutes | | Roihu L40 |\n'''\nopen(p,'w').write(t)\nEOF\nK=\"$PWD/cert(13).pub\"; R=vtrilar@roihu-cpu-login1.csc.fi; B=/scratch/project_2020113/sinceai; rsync -a -e \"ssh -o BatchMode=yes -o CertificateFile='$K'\" $R:$B/runs/floor_v2/members/members.npz $R:$B/runs/floor_v2/members/members.json \"$S/obj_v2_pkg/\" 2>&1 | tail -1 | cut -c1-60; rm -f \"$S/obj_v2_pkg/members.json\"; ls -la \"$S/obj_v2_pkg/members.npz\" | cut -c25-90; T=\"$S/make_test\"; rm -rf \"$S/cut_test\"; cp \"$S/obj_v2_pkg/members.npz\" \"$T/\"; for F in light_400k light_full; do uv run --no-sync --with numpy --with scipy python -m app.scene.split_movable \"$T/$F.ply\" \"$T/assets_viewer.json\" \"$S/cut_$F\" --objects obj-0067 obj-0021 obj-0008 obj-0112 --members \"$T/members.npz\" --box obj-0067 2>&1 | tail -1 | python3 -c \"import sys,json;d=json.loads(sys.stdin.read());print('$F',d['base'],d['pieces'],[p['patched'] for p in d['patches']])\"; done; uv run --no-sync ruff format app/scene/split_movable.py 2>&1 | tail -1; make lint 2>&1 | tail -1 | cut -c1-50; uv run --no-project --with numpy --with scipy --with pytest pytest tests/test_split_movable.py -q 2>&1 | tail -1 | cut -c1-50; git add app/scene/split_movable.py Makefile docs/RESULTS.md; git commit -qm \"Ship four checked moving objects, choosing the cut method per object\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\"; tar -cf \"$S/objects_v2.tar\" -C \"$S/obj_v2_pkg\" .; gh release upload objects-v2 \"$S/objects_v2.tar\" --clobber 2>&1 | tail -1 | cut -c1-60; ls -la \"$S/objects_v2.tar\" | cut -c25-70; git log --oneline -1 | cut -c1-70","description":"Add the per-object cut choice, test on light scenes, and publish the member da