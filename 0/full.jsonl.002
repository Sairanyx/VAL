{"type":"bridge-session","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","bridgeSessionId":"cse_01W2z6u48mE7ruGEe22DNPVT","lastSequenceNum":0,"ownerAccountUuid":"eb1ff47f-cfbf-49b1-a15e-4ca693f2c22a","ownerOrganizationUuid":"af454b37-7570-4ffb-9890-36a908611f8b"}
{"parentUuid":"25f4bb88-51cc-4090-a4c5-a4f9aa3d66d9","isSidechain":false,"promptId":"06369c86-4382-4e7b-a07e-00f01f8f9bda","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019nLVNFRvLSvAVQRAqynQKd","type":"tool_result","content":"=================== web/bim.js\n// BIM mode: a simulated model of the room instead of the scan. Data: /bim.json from app/bim.\n// Elements are drawn in scene coordinates inside `root`, like the scan, so moves and routes still\n// line up. Solid elements have a fitted shape; see-through ones only have a bounding box.\nimport * as THREE from \"three\";\n\nconst CLASS_COLORS = {\n  IfcWall: 0xc7cdd6,\n  IfcSlab: 0x6b7280,\n  IfcPump: 0xf59e0b,\n  IfcTank: 0x22c55e,\n  IfcValve: 0xa855f7,\n  IfcPipeSegment: 0x3b82f6,\n  IfcPipeFitting: 0x93c5fd,\n  IfcCableSegment: 0xeab308,\n  IfcElectricDistributionBoard: 0x14b8a6,\n  IfcLightFixture: 0xfde68a,\n  IfcSensor: 0xec4899,\n  IfcFlowInstrument: 0xec4899,\n  IfcFurniture: 0xb45309,\n  IfcBuildingElementProxy: 0x9ca3af,\n};\nconst FAULT_COLOR = 0xff2d2d;\nconst SELECTED_GLOW = 0x0891b2;\nconst ROOM = new Set([\"IfcWall\", \"IfcSlab\"]);\n\nexport async function setupBim({ root, renderer, objects, faultTag, floorY, onSelectObject }) {\n  const response = await fetch(\"bim.json\").catch(() => null);\n  if (!response?.ok) return null;\n  const model = await response.json();\n\n  renderer.localClippingEnabled = true;\n  const section = new THREE.Plane(new THREE.Vector3(0, -1, 0), 1e6);\n  const group = new THREE.Group();\n  group.visible = false;\n  root.add(group);\n\n  const byId = new Map(objects.map((o) => [o.asset.object_id, o]));\n  const items = model.elements.map((element) => {\n    const object = element.object_id ? byId.get(element.object_id) : null;\n    const fault = element.psets.Valmet_Mapping?.Tag === faultTag;\n    const mesh = makeMesh(element, fault, section);\n    group.add(mesh);\n    return {\n      element,\n      object,\n      mesh,\n      home: mesh.position.clone(),\n      volume: volume(element.geometry),\n      solid: !mesh.material.transparent,\n    };\n  });\n\n  const state = { active: false, selected: null, isolated: false, hidden: new Set(), cut: null };\n  const panel = document.getElementById(\"bim-panel\");\n  const props = document.getElementById(\"bim-props\");\n  buildFilters();\n  wireControls();\n\n  function buildFilters() {\n    const counts = new Map();\n    for (const { element } of items) counts.set(element.ifc_class, (counts.get(element.ifc_class) ?? 0) + 1);\n    const list = document.getElementById(\"bim-classes\");\n    list.replaceChildren();\n    for (const [cls, count] of [...counts].sort((a, b) => b[1] - a[1])) {\n      const label = document.createElement(\"label\");\n      const box = document.createElement(\"input\");\n      box.type = \"checkbox\";\n      box.checked = true;\n      box.onchange = () => {\n        if (box.checked) state.hidden.delete(cls);\n        else state.hidden.add(cls);\n      };\n      const swatch = document.createElement(\"span\");\n      swatch.className = \"swatch\";\n      swatch.style.background = `#${(CLASS_COLORS[cls] ?? 0x9ca3af).toString(16).padStart(6, \"0\")}`;\n      label.append(box, swatch, `${cls.replace(/^Ifc/, \"\")} (${count})`);\n      list.append(label);\n    }\n  }\n\n  function wireControls() {\n    document.getElementById(\"bim-isolate\").onclick = () => {\n      state.isolated = !state.isolated && Boolean(state.selected);\n      document.getElementById(\"bim-isolate\").textContent = state.isolated ? \"Show all\" : \"Isolate\";\n    };\n    const slider = document.getElementById(\"bim-section\");\n    const text = document.getElementById(\"bim-section-value\");\n    const max = Number(slider.max);\n    slider.oninput = () => {\n      const height = Number(slider.value);\n      state.cut = height >= max ? null : height;\n      text.textContent = state.cut === null ? \"off\" : `${height.toFixed(1)} m`;\n    };\n  }\n\n  function setActive(on) {\n    state.active = on;\n    group.visible = on;\n    panel.hidden = !on;\n  }\n\n  // Selecting from the scan side (panel, route, copilot) keeps the BIM selection in step.\n  function selectObject(object) {\n    const item = object ? items.find((candidate) => candidate.object === object) : null;\n    select(item, false);\n  }\n\n  function select(item, notify = true) {\n    if (state.selected) state.selected.mesh.material.emissive.setHex(0x000000);\n    state.selected = item;\n    if (!item) {\n      props.replaceChildren();\n      return;\n    }\n    item.mesh.material.emissive.setHex(SELECTED_GLOW);\n    showProperties(item.element);\n    if (notify) onSelectObject(item.object ?? null);\n  }\n\n  function showProperties(element) {\n    const rows = [\n      [\"IFC class\", element.ifc_class],\n      [\"Predefined type\", element.predefined_type],\n      [\"GlobalId\", element.guid],\n    ];\n    const html = [`<h3>${escapeHtml(element.name)}</h3>`, table(rows)];\n    for (const [name, values] of Object.entries(element.psets)) {\n      const shown = Object.entries(values).filter(([, v]) => v !== null && v !== undefined);\n      html.push(`<h4>${escapeHtml(name)}</h4>`, table(shown));\n    }\n    props.innerHTML = html.join(\"\");\n  }\n\n  function visible(item) {\n    if (state.hidden.has(item.element.ifc_class)) return false;\n    if (item.object?.gone) return false;\n    if (state.isolated && state.selected) {\n      return item === state.selected || ROOM.has(item.element.ifc_class);\n    }\n    return true;\n  }\n\n  const offset = new THREE.Vector3();\n  const floorWorld = new THREE.Vector3();\n  function update() {\n    if (!state.active) return;\n    for (const item of items) {\n      item.mesh.visible = visible(item);\n      if (item.object) {\n        offset.set(...item.object.asset.center);\n        item.mesh.position.copy(item.home).add(item.object.center).sub(offset);\n      }\n    }\n    // The section keeps what is below a height above the floor, like a plan cut.\n    if (state.cut === null) section.constant = 1e6;\n    else {\n      root.localToWorld(floorWorld.set(0, floorY, 0));\n      section.constant = floorWorld.y + state.cut;\n    }\n  }\n\n  // Equipment is preferred over walls and floor. See-through bounding boxes can overlap, so the\n  // smallest one under the pointer wins, but nothing behind the first solid shape is picked.\n  function pick(raycaster) {\n    const meshes = items.filter((item) => item.mesh.visible).map((item) => item.mesh);\n    const hits = raycaster\n      .intersectObjects(meshes, false)\n      .filter((hit) => state.cut === null || section.distanceToPoint(hit.point) >= 0)\n      .map((hit) => hit.object.userData.item);\n    const equipment = [];\n    for (const item of hits) {\n      if (ROOM.has(item.element.ifc_class)) continue;\n      equipment.push(item);\n      if (item.solid) break;\n    }\n    const pool = equipment.length ? equipment : hits.slice(0, 1);\n    const item = pool.length ? pool.reduce((a, b) => (b.volume < a.volume ? b : a)) : null;\n    select(item);\n    return item;\n  }\n\n  for (const item of items) item.mesh.userData.item = item;\n  return {\n    state,\n    setActive,\n    update,\n    pick,\n    selectObject,\n    elementCount: items.length,\n  };\n}\n\nfunction makeMesh(element, fault, section) {\n  const g = element.geometry;\n  const fitted = element.psets.Valmet_Geometry?.Source?.startsWith(\"fitted\");\n  const room = ROOM.has(element.ifc_class);\n  const material = new THREE.MeshStandardMaterial({\n    color: fault ? FAULT_COLOR : (CLASS_COLORS[element.ifc_class] ?? 0x9ca3af),\n    roughness: 0.8,\n    metalness: 0.05,\n    side: THREE.DoubleSide,\n    clippingPlanes: [section],\n    // Walls and boxes that are only bounding boxes stay see-through, so they don't pass as real.\n    transparent: element.ifc_class === \"IfcWall\" || (!fitted && !room),\n    opacity: element.ifc_class === \"IfcWall\" ? 0.18 : fitted || room ? 1 : 0.35,\n    depthWrite: fitted || element.ifc_class === \"IfcSlab\",\n  });\n  let geometry;\n  const mesh = new THREE.Mesh(undefined, material);\n  if (g.type === \"cylinder\") {\n    geometry = new THREE.CylinderGeometry(g.radius, g.radius, g.height, 32);\n    const axis = new THREE.Vector3(...g.axis).normalize();\n    mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), axis);\n  } else {\n    geometry = new THREE.BoxGeometry(...g.size);\n    const [first, second, third] = g.axes.map((row) => new THREE.Vector3(...row));\n    if (new THREE.Vector3().crossVectors(first, second).dot(third) < 0) third.negate();\n    mesh.quaternion.setFromRotationMatrix(new THREE.Matrix4().makeBasis(first, second, third));\n  }\n  mesh.geometry = geometry;\n  mesh.position.set(...g.center);\n  const edges = new THREE.LineSegments(\n    new THREE.EdgesGeometry(geometry),\n    new THREE.LineBasicMaterial({ color: 0x111827, transparent: true, opacity: 0.5, clippingPlanes: [section] }),\n  );\n  edges.raycast = () => {};\n  mesh.add(edges);\n  return mesh;\n}\n\nfunction volume(g) {\n  if (g.type === \"cylinder\") return Math.PI * g.radius ** 2 * g.height;\n  return g.size[0] * g.size[1] * g.size[2];\n}\n\nfunction table(rows) {\n  const body = rows\n    .map(([k, v]) => `<dt>${escapeHtml(k)}</dt><dd>${escapeHtml(format(v))}</dd>`)\n    .join(\"\");\n  return `<dl>${body}</dl>`;\n}\n\nfunction format(value) {\n  if (typeof value === \"boolean\") return value ? \"yes\" : \"no\";\n  if (typeof value === \"number\") return Number.isInteger(value) ? String(value) : value.toFixed(3);\n  return String(value);\n}\n\nfunction escapeHtml(text) {\n  return String(text).replace(/[&<>\"']/g, (c) => `&#${c.charCodeAt(0)};`);\n}\n=================== diff of shared files\ndiff --git a/Makefile b/Makefile\nindex c131a84..43ccf48 100644\n--- a/Makefile\n+++ b/Makefile\n@@ -12,10 +12,12 @@ PIECES_FROM ?= $(SCENE_DIR)/Equipment Room.ply\n PIECES_DIR ?= $(SCENE_DIR)/cut\n HIGHLIGHTS_DIR ?= $(SCENE_DIR)/highlights\n HIGHLIGHTS ?= $(if $(filter $(SCENE_DIR)/%,$(SCENE)),$(if $(wildcard $(HIGHLIGHTS_DIR)/highlights.json),$(HIGHLIGHTS_DIR)))\n+BIM_DIR ?= $(SCENE_DIR)/bim\n+BIM ?= $(if $(filter $(SCENE_DIR)/%,$(SCENE)),$(if $(wildcard $(BIM_DIR)/bim.json),$(BIM_DIR)))\n MODEL ?= Qwen3.5-9B\n MODEL_DIR ?= data/models/$(MODEL)\n \n-.PHONY: setup entire views scene scene-full model pieces highlights pipeline gpu train tb web fmt lint test check up api floor mapping db nav-check\n+.PHONY: setup entire views scene scene-full model pieces highlights bim pipeline gpu train tb web fmt lint test check up api floor mapping db nav-check\n \n setup:   ## install everything\n \tuv sync\n@@ -47,6 +49,8 @@ pieces:  ## cut movable objects out of a scene, so dragging moves the real thing\n \tuv run python -m app.scene.split_movable \"$(PIECES_FROM)\" $(SCENE_DIR)/assets_viewer.json $(PIECES_DIR) --objects $(PIECES_OBJECTS) --members $(SCENE_DIR)/members.npz -\n highlights: ## export segmented object surfaces for cyan selection highlighting\n \tuv run python -m app.scene.highlights \"$(SCENE_DIR)/Equipment Room.ply\" $(SCENE_DIR)/assets_final.json $(SCENE_DIR)/splat_labels.npy $(HIGHLIGHTS_DIR) $(if $(wildcard $\n+bim:     ## simulated BIM model of the room for the viewer's BIM mode, plus model.ifc (IFC4)\n+\tuv run python -m app.bim \"$(SCENE_DIR)/Equipment Room.ply\" $(SCENE_DIR)/assets_mapped.json $(SCENE_DIR)/shapes.json $(BIM_DIR)\n pipeline: ## run a scene through everything: make pipeline CONFIG=scenes/equipment_room.toml, DRY=1 to preview\n \tuv run python scripts/pipeline.py $(or $(CONFIG),scenes/equipment_room.toml) $(if $(DRY),--dry-run)\n gpu:     ## check the GPU works\n@@ -69,7 +73,7 @@ tb:      ## training graphs at http://localhost:6006\n \tuv run tensorboard --logdir runs\n SCENE ?= data/scene/sample/scene.ply\n web:     ## web viewer on port 8000, SCENE= picks the splat, HTTPS=1 for phone sensors\n-\tuv run python web/serve.py --scene \"$(SCENE)\" $(if $(HTTPS),--https) $(if $(ASSETS),--assets \"$(ASSETS)\") $(if $(SHAPES),--shapes \"$(SHAPES)\") $(if $(PIECES),--pieces \"\n+\tuv run python web/serve.py --scene \"$(SCENE)\" $(if $(HTTPS),--https) $(if $(ASSETS),--assets \"$(ASSETS)\") $(if $(SHAPES),--shapes \"$(SHAPES)\") $(if $(PIECES),--pieces \"\n fmt:     ## tidy code style and auto-fix lint\n \tuv run --only-group dev ruff format .\n \tuv run --only-group dev ruff check --fix .\ndiff --git a/docs/RESULTS.md b/docs/RESULTS.md\nindex 3333fd3..d20e8b9 100644\n--- a/docs/RESULTS.md\n+++ b/docs/RESULTS.md\n@@ -16,6 +16,7 @@ numbers feed the scene comparison, slides, and technical note, so only record wh\n ## Runs\n | Date | Owner | Step | Scene or input | Settings | Result | Time | Peak memory | Machine |\n |---|---|---|---|---|---|---|---|---|\n+| 2026-11-07 | yasasha | Simulated BIM and IFC export (`app/bim`) | `Equipment Room.ply`, objects-v2, 65 fitted shapes | Walls: outermost band with 15% of peak density a\n | 2026-11-08 | yasasha | Selection surface highlights | Original `Equipment Room.ply`, objects-v2 labels | Cyan per-object splats, no higher-order SH | 440 highlights ex\n | 2026-11-06 | Viktor | Validate PLY | `Equipment Room.ply` | | 1,676,481 of 1,676,481 records valid | | | ThinkPad |\n | 2026-11-06 | Viktor | Clean scene | `Equipment Room.ply` | Opacity above 0.05, floater removal | 1,178,554 splats kept, floor y about 1.18 | About 4 s | 0.8 GB RAM | T\ndiff --git a/docs/USAGE.md b/docs/USAGE.md\nindex 3abb79c..6ac1c6b 100644\n--- a/docs/USAGE.md\n+++ b/docs/USAGE.md\n@@ -13,6 +13,7 @@ make scene      # objects, floor map, and light scenes\n make mapping    # links Excel records to objects, writes assets_mapped.json\n make pieces     # cuts movable objects out of the scene\n make highlights # exports cyan segmented surfaces for object selection\n+make bim        # simulated BIM model for BIM mode, plus model.ifc\n make db         # optional, needs Docker: keeps changes after a restart\n make model      # optional, about 20 GB: the copilot's language model\n ```\n@@ -44,6 +45,20 @@ original scene. Generated highlights are loaded automatically for scenes under `\n For a different scene, pass its own `HIGHLIGHTS=path/to/highlights`, or disable loading with\n `HIGHLIGHTS=`.\n \n+## BIM mode\n+Run `make bim`, then restart your viewer and press **BIM**. The scan is replaced by a simulated\n+model: estimated walls and floor, plus one IFC element per detected object, coloured by class.\n+- **Tap an element** to see its IFC class, GlobalId and properties. Equipment also opens the normal\n+  panel, so **Ask copilot**, **Route here** and **Move on floor** still work, and moves show in BIM.\n+- **Class boxes** hide or show element types. **Isolate** keeps only the selection, walls and floor.\n+- **Section** cuts everything above a height, like a floor plan. **Download IFC** saves `model.ifc`\n+  (IFC4), which opens in BIM tools such as Bonsai.\n+\n+It is a simulation, not a survey. Solid elements have a fitted shape; see-through ones only have\n+a bounding box, so pipes often look too big. Walls are the scan's outermost dense bands, and doors\n+or openings aren't modelled. Tags made by rule or by eye show as `P-005?` and\n+`IdentityConfirmed: no`. Operator-added objects aren't in the model until `make bim` runs again.\n+\n ## Move an object\n 1. Tap the object. The smallest box under your finger is selected.\n 2. Press **Move on floor**. Only movable objects have this button.\n@@ -110,6 +125,7 @@ model worded it or it's a fixed template. Unsafe requests are refused.\n | **Range** | How far away frames and labels show |\n | **Boxes on** | Shows or hides frames |\n | **Scan / Both / Objects** | The real scan, fitted shapes over it, or shapes only |\n+| **BIM** | Simulated BIM model of the room, with IFC properties. Needs `make bim` |\n | **Apart** | Pulls objects apart to show them separately |\n | **Phone** | Turn the device to look, and walk to move. Needs `make web HTTPS=1` |\n \ndiff --git a/handoffs/yasasha.md b/handoffs/yasasha.md\nindex 2cf5d23..7adb4bf 100644\n--- a/handoffs/yasasha.md\n+++ b/handoffs/yasasha.md\n@@ -1,6 +1,6 @@\n-# yasasha: yasasha/object-highlight\n-**Goal:** Highlight selected scanned surfaces, not bounding boxes.\n-**Done:** Added app/scene/highlights.py, web/highlight.js, serving routes, selection wiring, Makefile target, tests and usage docs. Exported 440 local highlights; cut mo\n-**Verified:** make check: 197 passed. Chromium checked real PLY loading, movement, undo, visibility, deletion, rapid selection and missing segmentation. Actual viewer se\n-**Next:** Restart viewer after make highlights; review segmentation on the full room.\n-**Blockers:** Fragmented objects remain separate; highlights cannot recover missing surfaces or confirm equipment identity.\n+# yasasha: yasasha/bim\n+**Goal:** BIM mode: a simulated, interactive BIM model of the room, plus an IFC export.\n+**Done:** app/bim/ (room walls from scan density, IFC4 writer with no new dependency, bim.json), web/bim.js (BIM button, class filters, IFC properties, isolate, section \n+**Verified:** make check; tests/test_bim.py with IfcOpenShell: 0 schema issues on real model.ifc, 445 elements, geometry placed correctly. Chromium: enter/exit, tap P-00\n+**Next:** Thin pipe shapes instead of bounding boxes; doors/openings; rebuild after operator edits.\n+**Blockers:** none. Earlier: surface highlights merged in #19.\ndiff --git a/web/highlight.js b/web/highlight.js\nindex 07dab22..048b29e 100644\n--- a/web/highlight.js\n+++ b/web/highlight.js\n@@ -60,7 +60,8 @@ export function setupHighlight({ root, objectLayer, onMessage }) {\n \n   function update() {\n     if (!overlay || !selected) return;\n-    overlay.visible = objectLayer()?.state.view !== \"objects\" && !selected.gone;\n+    const view = objectLayer()?.state.view;\n+    overlay.visible = view !== \"objects\" && view !== \"bim\" && !selected.gone;\n     overlay.position.copy(selected.center).sub(home);\n   }\n \ndiff --git a/web/index.html b/web/index.html\nindex 1fed1b4..12ec556 100644\n--- a/web/index.html\n+++ b/web/index.html\n@@ -42,6 +42,7 @@\n     <button id=\"range\">Range 3 m</button>\n     <button id=\"reset\">Start</button>\n     <button id=\"view-mode\">Scan</button>\n+    <button id=\"bim\" hidden>BIM</button>\n     <button id=\"apart\">Apart</button>\n     <button id=\"reset-moves\">Undo changes</button>\n   </div>\n@@ -58,6 +59,18 @@\n     <p id=\"cant-move\" hidden></p>\n   </div>\n \n+  <div id=\"bim-panel\" hidden>\n+    <h2>BIM model <small>simulated from the scan</small></h2>\n+    <p class=\"bim-note\">Solid: fitted shape. See-through: bounding box only. Walls are estimates.</p>\n+    <div id=\"bim-classes\"></div>\n+    <label class=\"bim-section\">Section <input id=\"bim-section\" type=\"range\" min=\"0.3\" max=\"2.6\" step=\"0.1\" value=\"2.6\"> <span id=\"bim-section-value\">off</span></label>\n+    <div class=\"bim-actions\">\n+      <button id=\"bim-isolate\">Isolate</button>\n+      <a id=\"bim-download\" href=\"model.ifc\" download=\"model.ifc\">Download IFC</a>\n+    </div>\n+    <div id=\"bim-props\"></div>\n+  </div>\n+\n   <div id=\"select-frame\" hidden></div>\n \n   <div id=\"add-panel\" hidden>\ndiff --git a/web/main.js b/web/main.js\nindex 3e3107d..6209333 100644\n--- a/web/main.js\n+++ b/web/main.js\n@@ -4,6 +4,7 @@\n import * as THREE from \"three\";\n import { SparkControls, SparkRenderer, SplatMesh } from \"@sparkjsdev/spark\";\n import { setupAddObject } from \"./addobject.js\";\n+import { setupBim } from \"./bim.js\";\n import { setupCopilot } from \"./copilot.js\";\n import { setupHighlight } from \"./highlight.js\";\n import { setupObjects } from \"./objects.js\";\n@@ -55,6 +56,7 @@ let walk = true;\n let eyeY = EYE_HEIGHT;\n let startPos = new THREE.Vector3(0, EYE_HEIGHT, 0);\n let objectLayer = null;\n+let bim = null;\n let route = null;\n let selected = null;\n let boxesOn = true;\n@@ -174,6 +176,7 @@ function showInfo(obj) {\n     \"</dl>\";\n   selected = obj;\n   highlight.select(obj);\n+  bim?.selectObject(obj);\n   $(\"move\").hidden = a.mobility !== \"movable\" || !objectLayer;\n   $(\"cant-move\").hidden = a.mobility === \"movable\";\n   $(\"cant-move\").textContent =\n@@ -369,6 +372,11 @@ canvas.addEventListener(\"pointerup\", (e) => {\n     (e.clientX / window.innerWidth) * 2 - 1,\n     -(e.clientY / window.innerHeight) * 2 + 1,\n   );\n+  if (bim?.state.active && !adder.state.active) {\n+    raycaster.setFromCamera(ndc, camera);\n+    if (!bim.pick(raycaster)) $(\"info\").hidden = true;\n+    return;\n+  }\n   const obj = hit(ndc);\n   if (obj && adder.state.combining && !adder.state.other) adder.combineWith(obj);\n   else if (obj) showInfo(obj);\n@@ -417,7 +425,7 @@ function updateLabels() {\n   }\n   nearby.sort((a, b) => a.rank - b.rank || a.dist - b.dist);\n   const inView = nearby.filter((item) => item.onScreen);\n-  if (boxesOn && !apart) {\n+  if (boxesOn && !apart && !bim?.state.active) {\n     for (const { o } of inView.slice(0, MAX_BOXES)) {\n       if (!highlight.hasSurface(o)) o.box.visible = true;\n     }\n@@ -456,6 +464,7 @@ function animate(now) {\n   if (!phone.enabled && !busy) controls.update(camera);\n   objectLayer?.update(dt);\n   highlight.update();\n+  bim?.update();\n   if (following) route.update(dt);\n   else phone.update(dt);\n   route?.animate(dt);\n@@ -610,6 +619,32 @@ async function load() {\n     $(\"apart\").textContent = objectLayer.state.apart ? \"Together\" : \"Apart\";\n   };\n   $(\"reset-moves\").onclick = () => objectLayer.resetMoves();\n+  bim = await setupBim({\n+    root,\n+    renderer,\n+    objects,\n+    faultTag,\n+    floorY: data.floor_y ?? 0,\n+    // Walls and the floor have no scan object, so only the BIM panel describes them.\n+    onSelectObject: (object) => (object ? showInfo(object) : ($(\"info\").hidden = true)),\n+  }).catch((err) => {\n+    console.error(\"BIM model failed to load\", err);\n+    return null;\n+  });\n+  let viewBeforeBim = \"scan\";\n+  $(\"bim\").hidden = !bim;\n+  $(\"bim\").onclick = () => {\n+    const on = !bim.state.active;\n+    if (on) viewBeforeBim = objectLayer.state.view;\n+    objectLayer.setView(on ? \"bim\" : viewBeforeBim);\n+    bim.setActive(on);\n+    $(\"bim\").textContent = on ? \"Exit BIM\" : \"BIM\";\n+    $(\"view-mode\").disabled = on;\n+    $(\"apart\").disabled = on;\n+    $(\"status\").textContent = on\n+      ? `BIM model: ${bim.elementCount} elements, simulated from the scan`\n+      : \"Back to the scan\";\n+  };\n   // Starting states from the URL, for screenshots and rehearsals.\n   if (params.has(\"view\")) {\n     objectLayer.setView(params.get(\"view\"));\n@@ -620,7 +655,7 @@ async function load() {\n     $(\"apart\").textContent = \"Together\";\n   }\n   await syncWithBackend();\n-  window.plantViewer = { objects, objectLayer, camera, route, copilot, showInfo, adder }; // For browser tests and debugging.\n+  window.plantViewer = { objects, objectLayer, camera, route, copilot, showInfo, adder, bim }; // For browser tests and debugging.\n   if (params.has(\"camera\")) {\n     const [x, y, z, yaw, pitch] = params.get(\"camera\").split(\",\").map(Number);\n     camera.position.set(x, y, z);\ndiff --git a/web/objects.js b/web/objects.js\nindex 5b69494..6ab673e 100644\n--- a/web/objects.js\n+++ b/web/objects.js\n@@ -57,15 +57,16 @@ export async function setupObjects({\n   const floorPlane = new THREE.Plane();\n \n   function applyView() {\n-    splat.visible = state.view !== \"objects\";\n+    const clean = state.view === \"objects\" || state.view === \"bim\";\n+    splat.visible = !clean;\n     for (const piece of pieces) piece.visible = splat.visible;\n-    group.visible = state.view !== \"scan\";\n-    lights.visible = group.visible;\n+    group.visible = state.view === \"both\" || state.view === \"objects\";\n+    lights.visible = state.view !== \"scan\";\n     for (const item of items) {\n       item.mesh.material.transparent = state.view === \"both\";\n       item.mesh.material.opacity = state.view === \"both\" ? 0.75 : 1;\n     }\n-    scene.background = state.view === \"objects\" ? new THREE.Color(0x20242b) : null;\n+    scene.background = clean ? new THREE.Color(0x20242b) : null;\n   }\n \n   function placeAll() {\ndiff --git a/web/serve.py b/web/serve.py\nindex b0d7df0..1005cc7 100644\n--- a/web/serve.py\n+++ b/web/serve.py\n@@ -104,6 +104,7 @@ def main() -> None:\n     p.add_argument(\"--shapes\", type=Path, help=\"fitted shapes for the objects view\")\n     p.add_argument(\"--pieces\", type=Path, help=\"folder from app.scene.split_movable\")\n     p.add_argument(\"--highlights\", type=Path, help=\"segmented coloured splats from make highlights\")\n+    p.add_argument(\"--bim\", type=Path, help=\"folder from app.bim: bim.json and model.ifc\")\n     p.add_argument(\"--host\", default=\"0.0.0.0\")\n     p.add_argument(\"--port\", type=int, default=8000)\n     p.add_argument(\"--https\", action=\"store_true\", help=\"serve HTTPS, needed for phone sensors\")\n@@ -126,6 +127,11 @@ def main() -> None:\n             p.error(f\"not found: {args.highlights / 'highlights.json'}; run make highlights\")\n         routes[\"/highlights.json\"] = (args.highlights / \"highlights.json\").resolve()\n         routes[\"/highlights/\"] = args.highlights.resolve()\n+    if args.bim:\n+        for name in (\"bim.json\", \"model.ifc\"):\n+            if not (args.bim / name).is_file():\n+                p.error(f\"not found: {args.bim / name}; run make bim\")\n+            routes[f\"/{name}\"] = (args.bim / name).resolve()\n     handler = functools.partial(Handler, routes=routes)\n     with http.server.ThreadingHTTPServer((args.host, args.port), handler) as srv:\n         scheme = \"https\" if args.https else \"http\"\ndiff --git a/web/style.css b/web/style.css\nindex 8cb0a46..74aec28 100644\n--- a/web/style.css\n+++ b/web/style.css\n@@ -295,3 +295,32 @@ button {\n   color: #38bdf8;\n   font-size: 13px;\n }\n+\n+/* Anchored above the buttons, so the status box at the top stays readable when it grows. */\n+#bim-panel {\n+  position: fixed;\n+  bottom: 68px;\n+  left: 12px;\n+  width: min(380px, calc(100vw - 24px));\n+  max-height: calc(100vh - 210px);\n+  overflow-y: auto;\n+  padding: 10px 12px;\n+  border-radius: 6px;\n+  background: var(--panel);\n+}\n+#bim-panel h2 { margin: 0 0 4px; font-size: 16px; }\n+#bim-panel h2 small, .bim-note { color: var(--muted); font-size: 12px; font-weight: normal; }\n+.bim-note { margin: 0 0 8px; }\n+#bim-classes { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 8px; font-size: 12px; }\n+#bim-classes label { overflow-wrap: anywhere; }\n+#bim-classes label { display: flex; align-items: center; gap: 4px; }\n+.swatch { display: inline-block; width: 10px; height: 10px; border-radius: 2px; }\n+.bim-section { display: flex; align-items: center; gap: 6px; margin: 8px 0; font-size: 13px; }\n+.bim-section input { flex: 1; }\n+.bim-actions { display: flex; align-items: center; gap: 10px; }\n+#bim-download { color: inherit; }\n+#bim-props h3 { margin: 10px 0 4px; font-size: 14px; }\n+#bim-props h4 { margin: 8px 0 2px; font-size: 12px; color: var(--muted); }\n+#bim-props dl { display: grid; grid-template-columns: auto 1fr; gap: 1px 8px; margin: 0; font-size: 12px; }\n+#bim-props dt { color: var(--muted); }\n+#bim-props dd { margin: 0; overflow-wrap: anywhere; }","is_error":false}]},"uuid":"3d5e9864-60cd-4800-862e-0f027c7b0653","timestamp":"2026-11-07T12:12:43.609Z","toolUseResult":{"stdout":"=================== web/bim.js\n// BIM mode: a simulated model of the room instead of the scan. Data: /bim.json from app/bim.\n// Elements are drawn in scene coordinates inside `root`, like the scan, so moves and routes still\n// line up. Solid elements have a fitted shape; see-through ones only have a bounding box.\nimport * as THREE from \"three\";\n\nconst CLASS_COLORS = {\n  IfcWall: 0xc7cdd6,\n  IfcSlab: 0x6b7280,\n  IfcPump: 0xf59e0b,\n  IfcTank: 0x22c55e,\n  IfcValve: 0xa855f7,\n  IfcPipeSegment: 0x3b82f6,\n  IfcPipeFitting: 0x93c5fd,\n  IfcCableSegment: 0xeab308,\n  IfcElectricDistributionBoard: 0x14b8a6,\n  IfcLightFixture: 0xfde68a,\n  IfcSensor: 0xec4899,\n  IfcFlowInstrument: 0xec4899,\n  IfcFurniture: 0xb45309,\n  IfcBuildingElementProxy: 0x9ca3af,\n};\nconst FAULT_COLOR = 0xff2d2d;\nconst SELECTED_GLOW = 0x0891b2;\nconst ROOM = new Set([\"IfcWall\", \"IfcSlab\"]);\n\nexport async function setupBim({ root, renderer, objects, faultTag, floorY, onSelectObject }) {\n  const response = await fetch(\"bim.json\").catch(() => null);\n  if (!response?.ok) return null;\n  const model = await response.json();\n\n  renderer.localClippingEnabled = true;\n  const section = new THREE.Plane(new THREE.Vector3(0, -1, 0), 1e6);\n  const group = new THREE.Group();\n  group.visible = false;\n  root.add(group);\n\n  const byId = new Map(objects.map((o) => [o.asset.object_id, o]));\n  const items = model.elements.map((element) => {\n    const object = element.object_id ? byId.get(element.object_id) : null;\n    const fault = element.psets.Valmet_Mapping?.Tag === faultTag;\n    const mesh = makeMesh(element, fault, section);\n    group.add(mesh);\n    return {\n      element,\n      object,\n      mesh,\n      home: mesh.position.clone(),\n      volume: volume(element.geometry),\n      solid: !mesh.material.transparent,\n    };\n  });\n\n  const state = { active: false, selected: null, isolated: false, hidden: new Set(), cut: null };\n  const panel = document.getElementById(\"bim-panel\");\n  const props = document.getElementById(\"bim-props\");\n  buildFilters();\n  wireControls();\n\n  function buildFilters() {\n    const counts = new Map();\n    for (const { element } of items) counts.set(element.ifc_class, (counts.get(element.ifc_class) ?? 0) + 1);\n    const list = document.getElementById(\"bim-classes\");\n    list.replaceChildren();\n    for (const [cls, count] of [...counts].sort((a, b) => b[1] - a[1])) {\n      const label = document.createElement(\"label\");\n      const box = document.createElement(\"input\");\n      box.type = \"checkbox\";\n      box.checked = true;\n      box.onchange = () => {\n        if (box.checked) state.hidden.delete(cls);\n        else state.hidden.add(cls);\n      };\n      const swatch = document.createElement(\"span\");\n      swatch.className = \"swatch\";\n      swatch.style.background = `#${(CLASS_COLORS[cls] ?? 0x9ca3af).toString(16).padStart(6, \"0\")}`;\n      label.append(box, swatch, `${cls.replace(/^Ifc/, \"\")} (${count})`);\n      list.append(label);\n    }\n  }\n\n  function wireControls() {\n    document.getElementById(\"bim-isolate\").onclick = () => {\n      state.isolated = !state.isolated && Boolean(state.selected);\n      document.getElementById(\"bim-isolate\").textContent = state.isolated ? \"Show all\" : \"Isolate\";\n    };\n    const slider = document.getElementById(\"bim-section\");\n    const text = document.getElementById(\"bim-section-value\");\n    const max = Number(slider.max);\n    slider.oninput = () => {\n      const height = Number(slider.value);\n      state.cut = height >= max ? null : height;\n      text.textContent = state.cut === null ? \"off\" : `${height.toFixed(1)} m`;\n    };\n  }\n\n  function setActive(on) {\n    state.active = on;\n    group.visible = on;\n    panel.hidden = !on;\n  }\n\n  // Selecting from the scan side (panel, route, copilot) keeps the BIM selection in step.\n  function selectObject(object) {\n    const item = object ? items.find((candidate) => candidate.object === object) : null;\n    select(item, false);\n  }\n\n  function select(item, notify = true) {\n    if (state.selected) state.selected.mesh.material.emissive.setHex(0x000000);\n    state.selected = item;\n    if (!item) {\n      props.replaceChildren();\n      return;\n    }\n    item.mesh.material.emissive.setHex(SELECTED_GLOW);\n    showProperties(item.element);\n    if (notify) onSelectObject(item.object ?? null);\n  }\n\n  function showProperties(element) {\n    const rows = [\n      [\"IFC class\", element.ifc_class],\n      [\"Predefined type\", element.predefined_type],\n      [\"GlobalId\", element.guid],\n    ];\n    const html = [`<h3>${escapeHtml(element.name)}</h3>`, table(rows)];\n    for (const [name, values] of Object.entries(element.psets)) {\n      const shown = Object.entries(values).filter(([, v]) => v !== null && v !== undefined);\n      html.push(`<h4>${escapeHtml(name)}</h4>`, table(shown));\n    }\n    props.innerHTML = html.join(\"\");\n  }\n\n  function visible(item) {\n    if (state.hidden.has(item.element.ifc_class)) return false;\n    if (item.object?.gone) return false;\n    if (state.isolated && state.selected) {\n      return item === state.selected || ROOM.has(item.element.ifc_class);\n    }\n    return true;\n  }\n\n  const offset = new THREE.Vector3();\n  const floorWorld = new THREE.Vector3();\n  function update() {\n    if (!state.active) return;\n    for (const item of items) {\n      item.mesh.visible = visible(item);\n      if (item.object) {\n        offset.set(...item.object.asset.center);\n        item.mesh.position.copy(item.home).add(item.object.center).sub(offset);\n      }\n    }\n    // The section keeps what is below a height above the floor, like a plan cut.\n    if (state.cut === null) section.constant = 1e6;\n    else {\n      root.localToWorld(floorWorld.set(0, floorY, 0));\n      section.constant = floorWorld.y + state.cut;\n    }\n  }\n\n  // Equipment is preferred over walls and floor. See-through bounding boxes can overlap, so the\n  // smallest one under the pointer wins, but nothing behind the first solid shape is picked.\n  function pick(raycaster) {\n    const meshes = items.filter((item) => item.mesh.visible).map((item) => item.mesh);\n    const hits = raycaster\n      .intersectObjects(meshes, false)\n      .filter((hit) => state.cut === null || section.distanceToPoint(hit.point) >= 0)\n      .map((hit) => hit.object.userData.item);\n    const equipment = [];\n    for (const item of hits) {\n      if (ROOM.has(item.element.ifc_class)) continue;\n      equipment.push(item);\n      if (item.solid) break;\n    }\n    const pool = equipment.length ? equipment : hits.slice(0, 1);\n    const item = pool.length ? pool.reduce((a, b) => (b.volume < a.volume ? b : a)) : null;\n    select(item);\n    return item;\n  }\n\n  for (const item of items) item.mesh.userData.item = item;\n  return {\n    state,\n    setActive,\n    update,\n    pick,\n    selectObject,\n    elementCount: items.length,\n  };\n}\n\nfunction makeMesh(element, fault, section) {\n  const g = element.geometry;\n  const fitted = element.psets.Valmet_Geometry?.Source?.startsWith(\"fitted\");\n  const room = ROOM.has(element.ifc_class);\n  const material = new THREE.MeshStandardMaterial({\n    color: fault ? FAULT_COLOR : (CLASS_COLORS[element.ifc_class] ?? 0x9ca3af),\n    roughness: 0.8,\n    metalness: 0.05,\n    side: THREE.DoubleSide,\n    clippingPlanes: [section],\n    // Walls and boxes that are only bounding boxes stay see-through, so they don't pass as real.\n    transparent: element.ifc_class === \"IfcWall\" || (!fitted && !room),\n    opacity: element.ifc_class === \"IfcWall\" ? 0.18 : fitted || room ? 1 : 0.35,\n    depthWrite: fitted || element.ifc_class === \"IfcSlab\",\n  });\n  let geometry;\n  const mesh = new THREE.Mesh(undefined, material);\n  if (g.type === \"cylinder\") {\n    geometry = new THREE.CylinderGeometry(g.radius, g.radius, g.height, 32);\n    const axis = new THREE.Vector3(...g.axis).normalize();\n    mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), axis);\n  } else {\n    geometry = new THREE.BoxGeometry(...g.size);\n    const [first, second, third] = g.axes.map((row) => new THREE.Vector3(...row));\n    if (new THREE.Vector3().crossVectors(first, second).dot(third) < 0) third.negate();\n    mesh.quaternion.setFromRotationMatrix(new THREE.Matrix4().makeBasis(first, second, third));\n  }\n  mesh.geometry = geometry;\n  mesh.position.set(...g.center);\n  const edges = new THREE.LineSegments(\n    new THREE.EdgesGeometry(geometry),\n    new THREE.LineBasicMaterial({ color: 0x111827, transparent: true, opacity: 0.5, clippingPlanes: [section] }),\n  );\n  edges.raycast = () => {};\n  mesh.add(edges);\n  return mesh;\n}\n\nfunction volume(g) {\n  if (g.type === \"cylinder\") return Math.PI * g.radius ** 2 * g.height;\n  return g.size[0] * g.size[1] * g.size[2];\n}\n\nfunction table(rows) {\n  const body = rows\n    .map(([k, v]) => `<dt>${escapeHtml(k)}</dt><dd>${escapeHtml(format(v))}</dd>`)\n    .join(\"\");\n  return `<dl>${body}</dl>`;\n}\n\nfunction format(value) {\n  if (typeof value === \"boolean\") return value ? \"yes\" : \"no\";\n  if (typeof value === \"number\") return Number.isInteger(value) ? String(value) : value.toFixed(3);\n  return String(value);\n}\n\nfunction escapeHtml(text) {\n  return String(text).replace(/[&<>\"']/g, (c) => `&#${c.charCodeAt(0)};`);\n}\n=================== diff of shared files\ndiff --git a/Makefile b/Makefile\nindex c131a84..43ccf48 100644\n--- a/Makefile\n+++ b/Makefile\n@@ -12,10 +12,12 @@ PIECES_FROM ?= $(SCENE_DIR)/Equipment Room.ply\n PIECES_DIR ?= $(SCENE_DIR)/cut\n HIGHLIGHTS_DIR ?= $(SCENE_DIR)/highlights\n HIGHLIGHTS ?= $(if $(filter $(SCENE_DIR)/%,$(SCENE)),$(if $(wildcard $(HIGHLIGHTS_DIR)/highlights.json),$(HIGHLIGHTS_DIR)))\n+BIM_DIR ?= $(SCENE_DIR)/bim\n+BIM ?= $(if $(filter $(SCENE_DIR)/%,$(SCENE)),$(if $(wildcard $(BIM_DIR)/bim.json),$(BIM_DIR)))\n MODEL ?= Qwen3.5-9B\n MODEL_DIR ?= data/models/$(MODEL)\n \n-.PHONY: setup entire views scene scene-full model pieces highlights pipeline gpu train tb web fmt lint test check up api floor mapping db nav-check\n+.PHONY: setup entire views scene scene-full model pieces highlights bim pipeline gpu train tb web fmt lint test check up api floor mapping db nav-check\n \n setup:   ## install everything\n \tuv sync\n@@ -47,6 +49,8 @@ pieces:  ## cut movable objects out of a scene, so dragging moves the real thing\n \tuv run python -m app.scene.split_movable \"$(PIECES_FROM)\" $(SCENE_DIR)/assets_viewer.json $(PIECES_DIR) --objects $(PIECES_OBJECTS) --members $(SCENE_DIR)/members.npz -\n highlights: ## export segmented object surfaces for cyan selection highlighting\n \tuv run python -m app.scene.highlights \"$(SCENE_DIR)/Equipment Room.ply\" $(SCENE_DIR)/assets_final.json $(SCENE_DIR)/splat_labels.npy $(HIGHLIGHTS_DIR) $(if $(wildcard $\n+bim:     ## simulated BIM model of the room for the viewer's BIM mode, plus model.ifc (IFC4)\n+\tuv run python -m app.bim \"$(SCENE_DIR)/Equipment Room.ply\" $(SCENE_DIR)/assets_mapped.json $(SCENE_DIR)/shapes.json $(BIM_DIR)\n pipeline: ## run a scene through everything: make pipeline CONFIG=scenes/equipment_room.toml, DRY=1 to preview\n \tuv run python scripts/pipeline.py $(or $(CONFIG),scenes/equipment_room.toml) $(if $(DRY),--dry-run)\n gpu:     ## check the GPU works\n@@ -69,7 +73,7 @@ tb:      ## training graphs at http://localhost:6006\n \tuv run tensorboard --logdir runs\n SCENE ?= data/scene/sample/scene.ply\n web:     ## web viewer on port 8000, SCENE= picks the splat, HTTPS=1 for phone sensors\n-\tuv run python web/serve.py --scene \"$(SCENE)\" $(if $(HTTPS),--https) $(if $(ASSETS),--assets \"$(ASSETS)\") $(if $(SHAPES),--shapes \"$(SHAPES)\") $(if $(PIECES),--pieces \"\n+\tuv run python web/serve.py --scene \"$(SCENE)\" $(if $(HTTPS),--https) $(if $(ASSETS),--assets \"$(ASSETS)\") $(if $(SHAPES),--shapes \"$(SHAPES)\") $(if $(PIECES),--pieces \"\n fmt:     ## tidy code style and auto-fix lint\n \tuv run --only-group dev ruff format .\n \tuv run --only-group dev ruff check --fix .\ndiff --git a/docs/RESULTS.md b/docs/RESULTS.md\nindex 3333fd3..d20e8b9 100644\n--- a/docs/RESULTS.md\n+++ b/docs/RESULTS.md\n@@ -16,6 +16,7 @@ numbers feed the scene comparison, slides, and technical note, so only record wh\n ## Runs\n | Date | Owner | Step | Scene or input | Settings | Result | Time | Peak memory | Machine |\n |---|---|---|---|---|---|---|---|---|\n+| 2026-11-07 | yasasha | Simulated BIM and IFC export (`app/bim`) | `Equipment Room.ply`, objects-v2, 65 fitted shapes | Walls: outermost band with 15% of peak density a\n | 2026-11-08 | yasasha | Selection surface highlights | Original `Equipment Room.ply`, objects-v2 labels | Cyan per-object splats, no higher-order SH | 440 highlights ex\n | 2026-11-06 | Viktor | Validate PLY | `Equipment Room.ply` | | 1,676,481 of 1,676,481 records valid | | | ThinkPad |\n | 2026-11-06 | Viktor | Clean scene | `Equipment Room.ply` | Opacity above 0.05, floater removal | 1,178,554 splats kept, floor y about 1.18 | About 4 s | 0.8 GB RAM | T\ndiff --git a/docs/USAGE.md b/docs/USAGE.md\nindex 3abb79c..6ac1c6b 100644\n--- a/docs/USAGE.md\n+++ b/docs/USAGE.md\n@@ -13,6 +13,7 @@ make scene      # objects, floor map, and light scenes\n make mapping    # links Excel records to objects, writes assets_mapped.json\n make pieces     # cuts movable objects out of the scene\n make highlights # exports cyan segmented surfaces for object selection\n+make bim        # simulated BIM model for BIM mode, plus model.ifc\n make db         # optional, needs Docker: keeps changes after a restart\n make model      # optional, about 20 GB: the copilot's language model\n ```\n@@ -44,6 +45,20 @@ original scene. Generated highlights are loaded automatically for scenes under `\n For a different scene, pass its own `HIGHLIGHTS=path/to/highlights`, or disable loading with\n `HIGHLIGHTS=`.\n \n+## BIM mode\n+Run `make bim`, then restart your viewer and press **BIM**. The scan is replaced by a simulated\n+model: estimated walls and floor, plus one IFC element per detected object, coloured by class.\n+- **Tap an element** to see its IFC class, GlobalId and properties. Equipment also opens the normal\n+  panel, so **Ask copilot**, **Route here** and **Move on floor** still work, and moves show in BIM.\n+- **Class boxes** hide or show element types. **Isolate** keeps only the selection, walls and floor.\n+- **Section** cuts everything above a height, like a floor plan. **Download IFC** saves `model.ifc`\n+  (IFC4), which opens in BIM tools such as Bonsai.\n+\n+It is a simulation, not a survey. Solid elements have a fitted shape; see-through ones only have\n+a bounding box, so pipes often look too big. Walls are the scan's outermost dense bands, and doors\n+or openings aren't modelled. Tags made by rule or by eye show as `P-005?` and\n+`IdentityConfirmed: no`. Operator-added objects aren't in the model until `make bim` runs again.\n+\n ## Move an object\n 1. Tap the object. The smallest box under your finger is selected.\n 2. Press **Move on floor**. Only movable objects have this button.\n@@ -110,6 +125,7 @@ model worded it or it's a fixed template. Unsafe requests are refused.\n | **Range** | How far away frames and labels show |\n | **Boxes on** | Shows or hides frames |\n | **Scan / Both / Objects** | The real scan, fitted shapes over it, or shapes only |\n+| **BIM** | Simulated BIM model of the room, with IFC properties. Needs `make bim` |\n | **Apart** | Pulls objects apart to show them separately |\n | **Phone** | Turn the device to look, and walk to move. Needs `make web HTTPS=1` |\n \ndiff --git a/handoffs/yasasha.md b/handoffs/yasasha.md\nindex 2cf5d23..7adb4bf 100644\n--- a/handoffs/yasasha.md\n+++ b/handoffs/yasasha.md\n@@ -1,6 +1,6 @@\n-# yasasha: yasasha/object-highlight\n-**Goal:** Highlight selected scanned surfaces, not bounding boxes.\n-**Done:** Added app/scene/highlights.py, web/highlight.js, serving routes, selection wiring, Makefile target, tests and usage docs. Exported 440 local highlights; cut mo\n-**Verified:** make check: 197 passed. Chromium checked real PLY loading, movement, undo, visibility, deletion, rapid selection and missing segmentation. Actual viewer se\n-**Next:** Restart viewer after make highlights; review segmentation on the full room.\n-**Blockers:** Fragmented objects remain separate; highlights cannot recover missing surfaces or confirm equipment identity.\n+# yasasha: yasasha/bim\n+**Goal:** BIM mode: a simulated, interactive BIM model of the room, plus an IFC export.\n+**Done:** app/bim/ (room walls from scan density, IFC4 writer with no new dependency, bim.json), web/bim.js (BIM button, class filters, IFC properties, isolate, section \n+**Verified:** make check; tests/test_bim.py with IfcOpenShell: 0 schema issues on real model.ifc, 445 elements, geometry placed correctly. Chromium: enter/exit, tap P-00\n+**Next:** Thin pipe shapes instead of bounding boxes; doors/openings; rebuild after operator edits.\n+**Blockers:** none. Earlier: surface highlights merged in #19.\ndiff --git a/web/highlight.js b/web/highlight.js\nindex 07dab22..048b29e 100644\n--- a/web/highlight.js\n+++ b/web/highlight.js\n@@ -60,7 +60,8 @@ export function setupHighlight({ root, objectLayer, onMessage }) {\n \n   function update() {\n     if (!overlay || !selected) return;\n-    overlay.visible = objectLayer()?.state.view !== \"objects\" && !selected.gone;\n+    const view = objectLayer()?.state.view;\n+    overlay.visible = view !== \"objects\" && view !== \"bim\" && !selected.gone;\n     overlay.position.copy(selected.center).sub(home);\n   }\n \ndiff --git a/web/index.html b/web/index.html\nindex 1fed1b4..12ec556 100644\n--- a/web/index.html\n+++ b/web/index.html\n@@ -42,6 +42,7 @@\n     <button id=\"range\">Range 3 m</button>\n     <button id=\"reset\">Start</button>\n     <button id=\"view-mode\">Scan</button>\n+    <button id=\"bim\" hidden>BIM</button>\n     <button id=\"apart\">Apart</button>\n     <button id=\"reset-moves\">Undo changes</button>\n   </div>\n@@ -58,6 +59,18 @@\n     <p id=\"cant-move\" hidden></p>\n   </div>\n \n+  <div id=\"bim-panel\" hidden>\n+    <h2>BIM model <small>simulated from the scan</small></h2>\n+    <p class=\"bim-note\">Solid: fitted shape. See-through: bounding box only. Walls are estimates.</p>\n+    <div id=\"bim-classes\"></div>\n+    <label class=\"bim-section\">Section <input id=\"bim-section\" type=\"range\" min=\"0.3\" max=\"2.6\" step=\"0.1\" value=\"2.6\"> <span id=\"bim-section-value\">off</span></label>\n+    <div class=\"bim-actions\">\n+      <button id=\"bim-isolate\">Isolate</button>\n+      <a id=\"bim-download\" href=\"model.ifc\" download=\"model.ifc\">Download IFC</a>\n+    </div>\n+    <div id=\"bim-props\"></div>\n+  </div>\n+\n   <div id=\"select-frame\" hidden></div>\n \n   <div id=\"add-panel\" hidden>\ndiff --git a/web/main.js b/web/main.js\nindex 3e3107d..6209333 100644\n--- a/web/main.js\n+++ b/web/main.js\n@@ -4,6 +4,7 @@\n import * as THREE from \"three\";\n import { SparkControls, SparkRenderer, SplatMesh } from \"@sparkjsdev/spark\";\n import { setupAddObject } from \"./addobject.js\";\n+import { setupBim } from \"./bim.js\";\n import { setupCopilot } from \"./copilot.js\";\n import { setupHighlight } from \"./highlight.js\";\n import { setupObjects } from \"./objects.js\";\n@@ -55,6 +56,7 @@ let walk = true;\n let eyeY = EYE_HEIGHT;\n let startPos = new THREE.Vector3(0, EYE_HEIGHT, 0);\n let objectLayer = null;\n+let bim = null;\n let route = null;\n let selected = null;\n let boxesOn = true;\n@@ -174,6 +176,7 @@ function showInfo(obj) {\n     \"</dl>\";\n   selected = obj;\n   highlight.select(obj);\n+  bim?.selectObject(obj);\n   $(\"move\").hidden = a.mobility !== \"movable\" || !objectLayer;\n   $(\"cant-move\").hidden = a.mobility === \"movable\";\n   $(\"cant-move\").textContent =\n@@ -369,6 +372,11 @@ canvas.addEventListener(\"pointerup\", (e) => {\n     (e.clientX / window.innerWidth) * 2 - 1,\n     -(e.clientY / window.innerHeight) * 2 + 1,\n   );\n+  if (bim?.state.active && !adder.state.active) {\n+    raycaster.setFromCamera(ndc, camera);\n+    if (!bim.pick(raycaster)) $(\"info\").hidden = true;\n+    return;\n+  }\n   const obj = hit(ndc);\n   if (obj && adder.state.combining && !adder.state.other) adder.combineWith(obj);\n  