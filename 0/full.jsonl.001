4); pg.mouse.move(950,5,steps=2); pg.mouse.move(*q['b'],steps=2); pg.mouse.up(); pg.wait_for_timeout(2000)\n        print('after drag:',pg.evaluate(\"\"\"()=>({moving:!!window.plantViewer.objectLayer.state.moving,center:window.__o.center.toArray().map(x=>+x.toFixed(2)),piece:window.__o.piece.position.toArray().map(x=>+x.toFixed(2))})\"\"\"),pg.inner_text('#status')[:70])\n        # Release outside the canvas: end over the buttons along the bottom.\n        pg.evaluate(\"\"\"()=>{const v=window.plantViewer;v.showInfo(window.__o)}\"\"\"); pg.wait_for_timeout(200); pg.click('#move'); pg.mouse.move(400,300); pg.mouse.down(); pg.mouse.move(420,320,steps=2); pg.mouse.move(600,505,steps=3); pg.mouse.up(); pg.wait_for_timeout(1500)\n        print('released over a button: still stuck in move mode?',pg.evaluate(\"!!window.plantViewer.objectLayer.state.moving\"),'changes',pg.evaluate(\"window.plantViewer.objectLayer.state.changes.length\"))\n        c=pg.evaluate(\"window.__o.center.toArray().map(x=>+x.toFixed(2))\")\n        load(); print('after reload:',pg.inner_text('#status')[:70],pg.evaluate(\"\"\"()=>{const o=window.plantViewer.objects.find(x=>x.asset.object_id==='obj-0067');return {center:o.center.toArray().map(x=>+x.toFixed(2)),piece:o.piece.position.toArray().map(x=>+x.toFixed(2))}}\"\"\"),'expected',c)\n        print('fixed object:',pg.evaluate(\"\"\"()=>{const v=window.plantViewer;const o=v.objects.find(x=>x.asset.mobility==='fixed');v.showInfo(o);return {move:document.getElementById('move').hidden,text:document.getElementById('cant-move').textContent}}\"\"\"))\n        pg.click('#info-close'); pg.click('#reset-moves'); pg.wait_for_timeout(2500); print('undo:',pg.evaluate(\"\"\"()=>{const o=window.plantViewer.objects.find(x=>x.asset.object_id==='obj-0067');return {piece:o.piece.position.toArray()}}\"\"\")); load(); print('reload after undo:',pg.inner_text('#status')[:60],pg.evaluate(\"window.plantViewer.objects.find(x=>x.asset.object_id==='obj-0067').piece.position.