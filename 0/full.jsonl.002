I can't do that\"), a[:60]); check(\"Voice starts off\", pg.inner_text(\"#copilot-speak\")==\"Voice off\"); pg.screenshot(path=O+\"val.png\")\n    print(\"page errors:\",errs[:5]); print(f\"{sum(res)} of {len(res)} passed\"); b.close()\nEOF\nif ss -ltn | grep -qE \":8001 |:8124 \"; then echo BUSY; exit 0; fi; (cd \"$R\" && SCENE_PLY=\"$R/Equipment Room.ply\" SCENE_ASSETS=\"$S/pr2_scene/assets_mapped.json\" SCENE_GRID=\"$T/nav_grid.npz\" nohup uv run --no-project --with numpy --with scipy --with fastapi --with uvicorn --with websockets --with pydantic --with openpyxl --with pandas --with pillow --with 'psycopg[binary]' uvicorn app.api.main:app --app-dir \"$W\" --port 8001 > \"$S/ui/api.log\" 2>&1 &)\nnohup python3 web/serve.py --scene \"$D/base.ply\" --assets \"$S/pr2_scene/assets_mapped.json\" --shapes \"$S/pr2_scene/shapes.json\" --pieces \"$D\" --bim \"$S/merged_out\" --highlights \"$S/hl\" --port 8124 --host 127.0.0.1 > \"$S/ui/web.log\" 2>&1 &\nfor i in $(seq 40); do curl -sf -o /dev/null http://127.0.0.1:8001/docs && curl -sf -o /dev/null http://127.0.0.1:8124/ && { echo \"up ${i}s\"; break; }; sleep 1; done; timeout 170 uv run --no-project --with playwright python -u \"$S/mine/polish.py\" \"$S\" 2>&1 | grep -v \"^Installed\\|^  [A-Z]\\|^    [^ ]\" | cut -c1-205 | tail -24; timeout 330 uv run --no-project --with playwright python -u \"$S/ui/fix_test.py\" \"$S\" > \"$S/ui/fix.log\" 2>&1; echo \"combine exit $?\"; grep -E \"^FAIL|passed$|page errors|Traceback\" \"$S/ui/fix.log\" | cut -c1-170; grep \"fix_test.py\\\", line\" \"$S/ui/fix.log\" | tail -1 | cut -c60-130; tail -1 \"$S/ui/fix.log\" | cut -c1-110; for pid in $(ss -ltnp | grep -E \":8001 |:8124 \" | sed -n 's/.*pid=\\([0-9]*\\).*/\\1/p' | sort -u); do kill \"$pid\" 2>/dev/null; done; true","description":"Browser-test colours, refusals, delete, BIM clicks, isolate and combine","timeout":590000}},"serverClassifierRequest":"730d87db-8548-4578-9556-4106932c5ea2","apiBlockIndex":2,"requestId":"req_011Cgp1MsC4