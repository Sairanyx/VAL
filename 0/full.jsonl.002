ata_quality_issues\") or []\n    summary = {key: value for key, value in status.items() if key != \"data_quali\n    facts = [Fact(asset_id, describe(summary))]\n    facts += [Fact(issue[\"issue_id\"], describe(issue)) for issue in quality]\n    metrics = get_telemetry_summary(tag, store, limit=20).get(\"metrics\", {})\n    facts += [Fact(asset_id, text) for text in metric_observations(metrics)]\n    for event in get_events_for_asset(tag, store, limit=MAX_ITEMS):\n        facts.append(Fact(event[\"event_id\"], describe(event)))\n39:from app.copilot.llm import load_writer\n166:    engine = engine or load_engine()\n167:    writer = load_writer() if engine else None\n307:            answer = ask(engine, store.visible(), request.question, request.object_id,\n404:        if writer is not None and request.image:\n409:            **suggest_config(writer, crop, tags),\n430:        if writer is not None and request.image:\n433:            \"part\": {**part, **suggest_config(writer, crop, linked_tags())},\n441:        crop = crop_selection(request.image, request.rectangle) if writer is not None \n442:        return suggest_config(writer, crop, linked_tags())\n100:class CopilotRequest(BaseModel):\n101-    question: str\n102-    object_id: str | None = None\n103-\n104-\n52:make api &\ndef check_reply(reply: dict[str, Any] | None, facts: list[Fact]) -> str | None:\n    \"\"\"Return why a reply can't be shown, or None if it passes every check.\"\"\"\n    if reply is None:\n        return \"not valid JSON\"\n    answer = reply.get(\"answer\")\n    if not isinstance(answer, str) or not answer.strip():\n        return \"no answer\"\n    hypotheses = reply.get(\"hypotheses\") or []\n    citations = clean_citations(reply.get(\"citations\") or [])","is_error":false}]},"uuid":"9d117765-6e1a-4c68-8989-fc3a43b962fc","timestamp":"2026-11-07T15:35:40.571Z","toolUseResult":{"stdout":"def check_reply(reply: dict[str, Any] | None, facts: list[Fact]) -> str | None:\n    \"\"\"Return why a reply 