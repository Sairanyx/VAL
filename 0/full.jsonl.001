import { setupRoute } from \"./route.js\";\n@@ -58,6 +59,11 @@ let route = null;\n let selected = null;\n let boxesOn = true;\n let range = Number(params.get(\"range\") ?? 3);\n+const highlight = setupHighlight({\n+  root,\n+  objectLayer: () => objectLayer,\n+  onMessage: (message) => ($(\"status\").textContent = message),\n+});\n \n function resize() {\n   const w = window.innerWidth;\n@@ -152,6 +158,7 @@ function showInfo(obj) {\n     rows.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join(\"\") +\n     \"</dl>\";\n   selected = obj;\n+  highlight.select(obj);\n   $(\"move\").hidden = a.mobility !== \"movable\" || !objectLayer;\n   $(\"cant-move\").hidden = a.mobility === \"movable\";\n   $(\"cant-move\").textContent =\n@@ -173,6 +180,7 @@ async function routeTo(obj) {\n   $(\"clear-route\").hidden = !found;\n   $(\"follow\").textContent = \"Walk route\";\n   selected = obj;\n+  highlight.select(obj);\n }\n $(\"route-here\").onclick = () => selected && routeTo(selected);\n const copilot = setupCopilot({\n@@ -214,6 +222,7 @@ const adder = setupAddObject({\n     const added = objects.at(-1);\n     added.addedByOperator = true;\n     selected = added;\n+    highlight.select(added);\n     const added_text = `Added ${asset.object_id}: ${asset.label}, not confirmed`;\n     $(\"status\").textContent = added_text;\n     if (route?.state.target) {\n@@ -334,8 +343,12 @@ function updateLabels() {\n   nearby.sort((a, b) => a.rank - b.rank || a.dist - b.dist);\n   const inView = nearby.filter((item) => item.onScreen);\n   if (boxesOn && !apart) {\n-    for (const { o } of inView.slice(0, MAX_BOXES)) o.box.visible = true;\n-    for (const { o, pinned } of nearby) if (pinned) o.box.visible = true;\n+    for (const { o } of inView.slice(0, MAX_BOXES)) {\n+      if (!highlight.hasSurface(o)) o.box.visible = true;\n+    }\n+    for (const { o, pinned } of nearby) {\n+      if (pinned && !highlight.hasSurface(o)) o.box.visible = true;\n+    }\n   }\n   for (const item of inView) {\n     // Unconfirmed objects keep their frame, but don't crowd the view with a generic tag.\n@@ -365,8 +378,18 @@ function animate(now) {\n   const busy = objectLayer?.state.moving || adder.state.active || following;\n   if (!phone.enabled && !busy) controls.update(camera);\n   objectLayer?.update(dt);\n+  highlight.update();\n   if (following) route.update(dt);\n   else phone.update(dt);\n+  route?.animate(dt);\n+  if (!following && !adder.state.active) {\n+    const moving = objectLayer?.state.moving;\n+    route?.updateLive(\n+      moving?.dragging\n+        ? { object_id: moving.object.asset.object_id, position: moving.object.center.toArray() }\n+        : null,\n+    );\n+  }\n   $(\"follow\").textContent = following ? \"Stop\" : \"Walk route\";\n   if (walk) camera.position.y = eyeY;\n   renderer.render(scene, camera);\n--- a/web/route.js\n+++ b/web/route.js\n-const LINE_RADIUS = 0.035;\n+const LINE_RADIUS = 0.02; // faint guide line under the arrows\n+// Chevron arrows along the route, flowing towards the target.\n+const ARROW_SPACING = 0.45; // metres between arrows\n+const ARROW_SPEED = 0.7; // metres per second the arrows flow\n+const ARROW_GROW = 0.3; // arrows grow in and shrink out over this distance at the ends\n+const END_GAP = 0.3; // no arrows this close to the end ring\n+const MAX_ARROWS = 400;\n+\n+// A flat \">\" lying on the floor, pointing along +z, about 22 x 26 cm.\n+function chevronGeometry() {\n+  const shape = new THREE.Shape();\n+  const outline = [\n+    [0, 0.11],\n+    [0.13, -0.02],\n+    [0.13, -0.1],\n+    [0, 0.03],\n+    [-0.13, -0.1],\n+    [-0.13, -0.02],\n+  ];\n+  shape.moveTo(...outline[0]);\n+  for (const point of outline.slice(1)) shape.lineTo(...point);\n+  shape.closePath();\n+  const geometry = new THREE.ShapeGeometry(shape);\n+  geometry.rotateX(Math.PI / 2); // tip from +y to +z, so it lies flat on the floor\n+  return geometry;\n+}\n+const LIVE_STEP = 0.1; // metres moved before the route is re-planned or trimmed\n+const LIVE_WAIT = 50; // milliseconds between live re-plans, so requests don't pile up\n+    side: THREE.DoubleSide,\n+  const lineMaterial = material.clone();\n+  lineMaterial.opacity = 0.3;\n+  const arrows = new THREE.InstancedMesh(chevronGeometry(), material, MAX_ARROWS);\n+  arrows.count = 0;\n+  arrows.frustumCulled = false; // instances move every frame, so the bounds would be stale\n+  arrows.renderOrder = 11;\n+  root.add(arrows);\n+  const dummy = new THREE.Object3D();\n+  let track = null; // { points, lengths (cumulative), total } of the drawn route\n+  let ring = null;\n+  let phase = 0;\n+  let clock = 0;\n+  // Live re-planning: one request at a time, always for the newest position. `plan` and `clear`\n+  // bump `version`, so an older reply that arrives afterwards is dropped.\n+  const live = { busy: false, version: 0, lastAt: 0, lastFrom: null, lastDrag: null };\n+    track = null;\n+    ring = null;\n+    arrows.count = 0;\n+    const lengths = [0];\n+      lengths.push(lengths[i] + delta.length());\n-        material,\n+        lineMaterial,\n-    const end = new THREE.Mesh(new THREE.RingGeometry(0.16, 0.24, 32), material);\n-    end.material.side = THREE.DoubleSide;\n-    end.position.copy(points.at(-1));\n-    end.rotation.x = Math.PI / 2;\n-    group.add(end);\n+    ring = new THREE.Mesh(new THREE.RingGeometry(0.16, 0.24, 32), material);\n+    ring.position.copy(points.at(-1));\n+    ring.rotation.x = Math.PI / 2;\n+    group.add(ring);\n+    track = { points, lengths, total: lengths.at(-1) };\n+  }\n+\n+  // Place the arrows for this frame: evenly spaced, flowing towards the end, growing in and out.\n+  // They're spaced by distance to the end, not from the start, so live re-plans and the trimming\n+  // while walking (which both redraw the route from a new start) don't make them jump.\n+  function animate(dt) {\n+    if (!track) return;\n+    clock += dt;\n+    phase = (phase + ARROW_SPEED * dt) % ARROW_SPACING;\n+    if (ring) ring.scale.setScalar(1 + 0.15 * Math.sin(clock * 4));\n+    const stop = track.total - END_GAP;\n+    const nearest = END_GAP + ARROW_SPACING - phase; // distance to the end of the closest arrow\n+    const n = Math.min(Math.floor((track.total - nearest) / ARROW_SPACING), MAX_ARROWS - 1);\n+    let segment = 0;\n+    let count = 0;\n+    // From the farthest arrow to the nearest, so the distance from the start only grows.\n+    for (let k = n; k >= 0; k--) {\n+      const d = track.total - (nearest + k * ARROW_SPACING);\n+      if (d < 0) continue;\n+      while (segment < track.lengths.length - 2 && track.lengths[segment + 1] < d) segment++;\n+      const a = track.points[segment];\n+      const b = track.points[segment + 1];\n+      const span = track.lengths[segment + 1] - track.lengths[segment];\n+      dummy.position.lerpVectors(a, b, span > 0 ? (d - track.lengths[segment]) / span : 0);\n+      dummy.rotation.set(0, Math.atan2(b.x - a.x, b.z - a.z), 0);\n+      const grow = Math.min(1, d / ARROW_GROW, (stop - d) / ARROW_GROW);\n+      dummy.scale.setScalar(Math.max(grow, 0.01));\n+      dummy.updateMatrix();\n+      arrows.setMatrixAt(count++, dummy.matrix);\n+    }\n+    arrows.count = count;\n+    arrows.instanceMatrix.needsUpdate = true;\n-  // Plan from where the viewer stands. Re-plans keep that start, so looking around from elsewhere\n-  // can't change the route. A refusal clears the line and shows the reason.\n+  // Plan from where the viewer stands. A refusal clears the line and shows the reason.\n+    live.version += 1;\n+    live.lastFrom = start.clone();\n+    live.lastDrag = null;\n+  // Called every frame when the route isn't being walked. Keeps the route up to date while the viewer\n+  // moves, or while an object is dragged (`drag`: object_id and position, not saved yet).\n+  function updateLive(drag = null) {\n+    if (!state.target || state.walking || live.busy) return;\n+    if (performance.now() - live.lastAt < LIVE_WAIT) return;\n+    const here = root.worldToLocal(camera.position.clone());\n+    here.y = state.start.y;\n+    const walked = !live.lastFrom || here.distanceTo(live.lastFrom) >= LIVE_STEP;\n+    const dragged =\n+      drag &&\n+      (!live.lastDrag ||\n+        new THREE.Vector3(...drag.position).distanceTo(new THREE.Vector3(...live.lastDrag)) >=\n+          LIVE_STEP);\n+    if (!walked && !dragged) return;\n+    if (walked) {\n+      state.start = here;\n+      live.lastFrom = here.clone();\n+    }\n+    if (dragged) live.lastDrag = drag.position;\n+    sendLive(drag);\n+  }\n+\n+  async function sendLive(drag) {\n+    const { version } = live;\n+    live.busy = true;\n+    live.lastAt = performance.now();\n+    const target = state.target;\n+    try {\nimport * as THREE from \"three\";\nimport { SplatMesh } from \"@sparkjsdev/spark\";\n\n// Separate segmented splats, not a volume mask: neighbouring surfaces inside the box stay normal.\nexport function setupHighlight({ root, objectLayer, onMessage }) {\n  let selected = null;\n  let overlay = null;\n  let request = 0;\n  const home = new THREE.Vector3();\n  let manifests;\n\n  function disposeOverlay() {\n    if (!overlay) return;\n    root.remove(overlay);\n    overlay.dispose();\n    overlay = null;\n  }\n\n  async function select(object) {\n    const token = ++request;\n    selected = object;\n    disposeOverlay();\n    if (!object) return;\n    try {\n      manifests ??= fetch(\"highlights.json\").then(async (response) => {\n        if (response.status === 404) return null;\n        if (!response.ok) throw new Error(`Highlight manifest: HTTP ${response.status}`);\n        return response.json();\n      });\n      const manifest = await manifests;\n      if (token !== request || !object) return;\n      if (!manifest?.[object.asset.object_id]) {\n        onMessage(\"No segmented highlight for this object. Run make highlights; new objects need seg\n        return;\n      }\n      const candidate = new SplatMesh({\n        url: `highlights/${encodeURIComponent(object.asset.object_id)}.ply`,\n        lod: false,\n      });\n      try {\n        await candidate.initialized;\n      } catch (error) {\n        candidate.dispose();\n        throw error;\n      }\n      if (token !== request) {\n        candidate.dispose();\n        return;\n      }\n      overlay = candidate;\n      home.set(...object.asset.center);\n      root.add(overlay);\n      update();\n    } catch (error) {\n      manifests = undefined;\n      console.error(\"Object highlight failed\", error);\n      if (token === request) onMessage(`Object highlight failed: ${error.message}`);\n    }\n  }\n\n  function update() {\n    if (!overlay || !selected) return;\n    overlay.visible = objectLayer()?.state.view !== \"objects\" && !selected.gone;\n    overlay.position.copy(selected.center).sub(home);\n  }\n\n  return { select, update, hasSurface: (object) => selected === object && Boolean(overlay?.visible) \n}\n Makefile      |  8 ++++++--\n docs/USAGE.md | 16 ++++++++++++++++\n 2 files changed, 22 insertions(+), 2 deletions(-)\n--- a/Makefile\n+++ b/Makefile\n+HIGHLIGHTS_DIR ?= $(SCENE_DIR)/highlights\n+HIGHLIGHTS ?= $(if $(filter $(SCENE_DIR)/%,$(SCENE)),$(if $(wildcard $(HIGHLIGHTS_DIR)/highlights.json),$(HIGHLIGHTS_DIR)))\n-.PHONY: setup entire views scene scene-full model pieces pipeline gpu train tb web fmt lint test check up api floor mapping db nav-check\n+.PHONY: setup entire views scene scene-full model pieces highlights pipeline gpu train tb web fmt lint test check up api floor mapping db n\n+highlights: ## export segmented object surfaces for cyan selection highlighting\n+\tuv run python -m app.scene.highlights \"$(SCENE_DIR)/Equipment Room.ply\" $(SCENE_DIR)/assets_final.json $(SCENE_DIR)/splat_labels.npy $(HIG\n-\tuv run python web/serve.py --scene \"$(SCENE)\" $(if $(HTTPS),--https) $(if $(ASSETS),--assets \"$(ASSETS)\") $(if $(SHAPES),--shapes \"$(SHAPE\n+\tuv run python web/serve.py --scene \"$(SCENE)\" $(if $(HTTPS),--https) $(if $(ASSETS),--assets \"$(ASSETS)\") $(if $(SHAPES),--shapes \"$(SHAPE\n--- a/app/api/main.py\n+++ b/app/api/main.py\n+class PreviewMove(BaseModel):\n+    object_id: str\n+    position: Position\n+\n+\n+    preview: PreviewMove | None = None\n-def footprints(store: SceneStore, target_id: str) -> list[tuple[list[float], list[float]]]:\n-    \"\"\"Return boxes that block routes on top of the map: movable and newly added objects.\"\"\"\n-    return [\n-        (asset[\"bbox_min\"], asset[\"bbox_max\"])\n-        for asset in store.visible()\n-        if asset[\"object_id\"] != target_id\n-        and (asset[\"mobility\"] == \"movable\" or asset[\"status\"] == UNCONFIRMED_NEW)\n-    ]\n+def shifted_box(asset: dict, position: list[float]) -> tuple[list[float], list[float]]:\n+    \"\"\"Return an object's box as if its center were at `position`.\"\"\"\n+    shift = [p - c for p, c in zip(position, asset[\"center\"], strict=True)]\n+    low = [v + d for v, d in zip(asset[\"bbox_min\"], shift, strict=True)]\n+    high = [v + d for v, d in zip(asset[\"bbox_max\"], shift, strict=True)]\n+    return low, high\n+\n+\n+def footprints(\n+    store: SceneStore, target_id: str, preview: \"PreviewMove | None\" = None\n+) -> list[tuple[list[float], list[float]]]:\n+    \"\"\"Return boxes that block routes on top of the map: movable and newly added objects.\n+\n+    `preview` shows where an object is being dragged to, before the move is saved.","is_error":false}]},"uuid":"37bc64e3-9d4c-48ef-83f5-f004caae17a1","timestamp":"2026-11-07T11:11:38.337Z","toolUseResult":{"stdout":"1ad07b7 yasasha 65 minutes ago Highlight whole cut pieces for movable objects\na18421c yasasha 82 minutes ago Highlight selected objects with segmented cyan splats\n0f528af Eduard Rednic 64 minutes ago Update the live route every 0.1 m, up to every 50 ms\nd23743f Eduard Rednic 70 minutes ago Update the route live while moving and while dragging objects\nf0fe660 Benjamin Sundell 83 minutes ago Viewer: flowing chevron arrows