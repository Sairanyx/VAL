t ones only.\"\"\"\n    if len(labels) != int(kept.sum()):\n        raise ValueError(f\"{len(labels)} labels, but cleaning keeps {int(kept.sum())} splats\")\n    result = np.full(len(kept), -1, dtype=labels.dtype)\n    result[kept] = labels\n    return result\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"original\", type=Path)\n    parser.add_argument(\"labels\", type=Path)\n    parser.add_argument(\"out\", type=Path)\n    parser.add_argument(\"--min-opacity\", type=float, required=True)\n    args = parser.parse_args()\n    kept = clean_mask(read_splats(args.original), min_opacity=args.min_opacity)\n    result = remap(np.load(args.labels), kept)\n    np.save(args.out, result)\n    print(f\"Wrote {args.out}: {len(result)} labels, {int((result >= 0).sum())} on objects\")\n\n\nif __name__ == \"__main__\":\n    main()\nEOF\ncat >> tests/test_scene_load.py <<'EOF'\n\n\ndef test_labels_from_a_cleaned_scene_map_back_to_the_original_order():\n    import importlib.util\n    from pathlib import Path\n\n    spec = importlib.util.spec_from_file_location(\n        \"remap_labels\", Path(__file__).parent.parent / \"scripts\" / \"remap_labels.py\"\n    )\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    kept = np.array([True, False, True, False])\n    assert module.remap(np.array([7, 8]), kept).tolist() == [7, -1, 8, -1]\n    with pytest.raises(ValueError):\n        module.remap(np.array([7]), kept)\nEOF\ncat > \"$S/floor_valmet.sh\" <<'EOF'\ncd /scratch/project_2020113/sinceai/code; R=/scratch/project_2020113/sinceai; P=/scratch/project_2020113/inspection/venv-l40/bin/python; O=$R/data/scene/equipment_room/original.ply; V=$R/data/scene/valmet_full; F=$R/runs/floor_v3; mkdir -p $F; export PYTHONPATH=. OPENBLAS_NUM_THREADS=4\n$P scripts/remap_labels.py $O $R/runs/lift_v1/splat_labels.npy $F/splat_labels.npy --min-opacity 0.05 2>&1 | tail -1\n$P -m app.nav.grid $O --out $F/grid_nowalk.npz --preview $F/nowalk.png --labels $F/splat_labels.npy --assets $R/runs/lift_v1/assets_final.json --views $V/render $V/render_detail 2>&1 | tr -d '\\n ' | cut -c1-430; echo\n$P -m app.nav.grid $O --out $F/grid_walk.npz --preview $F/walk.png --labels $F/splat_labels.npy --assets $R/runs/lift_v1/assets_final.json --views $V/render $V/render_detail --walked $R/data/scene/splat_v2/walked.npy 2>&1 | tr -d '\\n ' | cut -c1-430; echo\n$P - <<PY\nimport json,numpy as np\nfrom app.nav.grid import load_grid\nPY\nEOF\nsed -i '/^\\$P - <<PY/,/^PY/d' \"$S/floor_valmet.sh\"; K=\"$PWD/cert(13).pub\"; R=vtrilar@roihu-cpu-login1.csc.fi; B=/scratch/project_2020113/sinceai; O=(-o BatchMode=yes -o ConnectTimeout=20 -o \"CertificateFile=$K\"); rsync -a -e \"ssh -o BatchMode=yes -o CertificateFile='$K'\" app/nav/grid.py $R:$B/code/app/nav/; ssh \"${O[@]}\" $R \"mkdir -p $B/code/scripts\"; rsync -a -e \"ssh -o BatchMode=yes -o CertificateFile='$K'\" scripts/remap_labels.py $R:$B/code/scripts/; scp -q \"${O[@]}\" \"$S/floor_valmet.sh\" $R:$B/scripts/; ssh \"${O[@]}\" $R \"ls $B/data/scene/valmet_full/render/depth | wc -l; ls $B/data/scene/valmet_full/render_detail/depth | wc -l; srun -A project_2020113 -p interactive -c 8 --mem=40G -t 00:25:00 bash $B/scripts/floor_valmet.sh </dev/null 2>&1 | grep -v srun | cut -c1-440\"; mkdir -p \"$S/floor_v3\"; rsync -a -e \"ssh -o BatchMode=yes -o CertificateFile='$K'\" --include='*.png' --include='*.npz' --include='splat_labels.npy' --exclude='*' $R:$B/runs/floor_v3/ \"$S/floor_v3/\" 2>&1 | tail -1 | cut -c1-70; uv run --no-sync --with numpy --with pytest pytest tests/test_scene_load.py -q 2>&1 | tail -1 | cut -c1-80","description":"Fix the label crash, remap labels and build Valmet's floor map both ways","timeout":590000}},"serverClassifierRequest":"8fb6f966-c3de-4a77-84ff-e2152ee68477","apiBlockIndex":2,"requestId":"req_011CgnuCPWxdk8VUtjkFQPkE","requestRef":"9aa2ce49-bd15-4bdf-9940-760766fc297c","requestedModel":"claude-opus-5-5","promp