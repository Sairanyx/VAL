0,'height':540}).new_page(); errs=[]\n    pg.on('pageerror',lambda e: errs.append(str(e)[:200]))\n    pg.goto('http://127.0.0.1:8123/?lod=0&res=0.2&camera=-1.6,0.6,3.4,0,-0.7'); pg.wait_for_function(\"window.plantViewer!==undefined\",timeout=240000); pg.wait_for_timeout(2000)\n    pg.evaluate(\"\"\"async()=>{const v=window.plantViewer,R=v.route,keep=v.camera.position.clone();v.camera.position.set(0,-1.167+1.6,0);const o=v.objects.find(x=>x.asset.mapping&&x.asset.mapping.tag==='P-005');await R.plan({asset:o.asset,center:o.center,name:'P-005'});v.camera.position.copy(keep);window.__o=v.objects.find(x=>x.asset.object_id==='obj-0067')}\"\"\")\n    sc=\"\"\"(x,z)=>{const v=window.plantViewer,o=window.__o,T=o.box.parent;const w=T.localToWorld(new o.center.constructor(x,1.167,z));v.camera.updateMatrixWorld();w.project(v.camera);return [(w.x+1)/2*innerWidth,(1-w.y)/2*innerHeight]}\"\"\"\n    pos=lambda x,z: pg.evaluate(f\"({sc})({x},{z})\")\n    state=lambda: pg.evaluate(\"\"\"()=>{const v=window.plantViewer,o=window.__o;return {center:o.center.toArray().map(x=>+x.toFixed(2)),piece:o.piece.position.toArray().map(x=>+x.toFixed(2)),color:o.box.material.color.getHex().toString(16),warn:!!o.warning,red:v.objects.filter(x=>x.warning).map(x=>x.asset.object_id).slice(0,5),changes:v.objectLayer.state.changes.length,moving:!!v.objectLayer.state.moving,len:v.route.state.route&&v.route.state.route.length}}\"\"\")\n    print('start',state())\n    # 1: onto another movable object, holding the button to see red.\n    t=pg.evaluate(\"\"\"()=>{const v=window.plantViewer,o=window.__o;const ch=v.objects.find(x=>x.asset.object_id==='obj-0047');return ch.center.toArray()}\"\"\"); print('target obj-0047',[round(x,2) for x in t])\n    pg.evaluate(\"()=>window.plantViewer.showInfo(window.__o)\"); pg.wait_for_timeout(200); pg.click('#move')\n    a=pos(-1.859,-0.919); c=pos(t[0],t[2]); pg.mouse.move(*a); pg.mouse.down(); pg.mouse.move(*c,steps=5); pg.wait_for_timeout(2500)\n    print('held over it'