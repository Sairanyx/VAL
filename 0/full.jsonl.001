/scene/movable_members.py:124:    parser.add_argument(\"--up\", type=float, nargs=3, defa\napp/scene/load.py:188:    parser.add_argument(\"--up\", type=float, nargs=3, default=(0.0, -\napp/scene/cluster.py:112:    parser.add_argument(\"--up\", type=float, nargs=3, default=(0.0\napp/extract/lift.py:145:        masks_of_group.setdefault(group, []).append(mask)\napp/extract/lift.py:275:    parser.add_argument(\"--up\", type=float, nargs=3, default=(0.0,\napp/scene/split_movable.py:201:    parser.add_argument(\"--up\", type=float, nargs=3, defaul\napp/scene/render.py:67:    parser.add_argument(\"--up\", type=float, nargs=3, default=(0.0, \n2:VIEWS_FILE ?= equipment_room_views_v1.tar\n4:FLOOR_SCENE ?= $(SCENE_DIR)/Equipment Room.ply\n7:SCENE_DIR ?= data/scene/equipment_room\n10:PIECES_FROM ?= $(SCENE_DIR)/Equipment Room.ply\n26:\tuv run scripts/views_archive.py unpack $(or $(ARCHIVE),data/scene/$(VIEWS_FILE)) data/\n34:\t@echo \"Next: put 'Equipment Room.ply' in $(SCENE_DIR) and the Excel pack in data/, the\n35:\t@echo \"Viewer on a PC: make web SCENE=\\\"$(SCENE_DIR)/Equipment Room.ply\\\" ASSETS=$(SCE\n53:floor:   ## rebuild the floor map (make scene includes one), needs \"Equipment Room.ply\"\n2:set -euo pipefail\n26:# SAM3 text prompts (same list reused for every image; encoded once then cached).\n27:TEXT_PROMPTS=(\n28:  wall floor ceiling door pump valve motor pipe tank cabinet gauge ladder box cart bucket chair barrel appliance\n36:  --text-prompts \"${TEXT_PROMPTS[@]}\"","is_error":false}]}}
