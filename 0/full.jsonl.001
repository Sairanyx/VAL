{"parentUuid":"4071bac6-6209-49b2-9eee-51d7caccac45","isSidechain":false,"promptId":"460631f3-8774-47f9-af6b-bf8f7d35ca9a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TR6isYrcunVj9LSCsueEtt","type":"tool_result","content":"15\tfrom PIL import Image\n16\t\n17\tfrom app.extract.label_vlm import LABELS, VisionLabeler, focus_crop, mask_box\n18\t\n19\tPROMPT = f\"\"\"These images show one object in an industrial equipment room, from {{count}} different\n20\tviews. The object is shown in full color, and everything around it is dimmed, for context.\n21\t\n22\tChoose the label that best fits it, from: {\", \".join(LABELS)}.\n23\t\n24\tHow to tell similar things apart:\n25\t- pipe: a long straight or curved tube. Often insulated and white, with no moving parts.\n26\t- pipe fitting: a short piece that joins pipes, such as an elbow, tee, or flange.\n27\t- pump: a compact metal casing inline between two pipe flanges, usually with a motor attached.\n28\t- motor: a ribbed or finned housing, usually with a cable box and fan cover.\n29\t- valve: a body on a pipe, with a handwheel, lever, or small actuator on top.\n30\t- tank: a large closed cylinder or vessel.\n31\t- electrical cabinet: a flat metal box on a wall.\n32\t- control panel: a box with visible buttons or dials.\n33\t- other: a clear single object not in this list. Name it in \"reason\".\n34\t- unknown: if you can't tell, if it looks like several things, or if it's only a fragment.\n35\t\n36\tLook at shape first. Only name equipment if you can see its typical parts.\n37\t\n38\tReply with JSON only:\n39\t{{{{\"label\": \"...\", \"confidence\": 0.0, \"reason\": \"evidence, under 12 words\", \"visible_text\": \"\"}}}}\n40\t\"visible_text\" is text you can actually read on the object, exactly as written, or \"\" if none.\"\"\"\n41\t\n42\t\n43\tdef object_crops(\n44\t    asset: dict, masks_dir: Path, views: int, margin: float = 0.35\n45\t) -> list[Image.Image]:\n46\t    \"\"\"Return focused crops of an object from its largest masks, at most one per view.\"\"\"\n47\t    crops = []\n48\t    used = set()\n49\t    for source in asset[\"source_masks\"]:\n50\t        if len(crops) >= views:\n51\t            break\n52\t        if source[\"view\"] in used:\n53\t            continue\n54\t        used.add(source[\"view\"])\n55\t        image = np.array(Image.open(masks_dir / \"images\" / f\"{source['view']}.jpg\"))\n56\t        ids = np.array(Image.open(masks_dir / \"object_mask\" / f\"{source['view']}.png\"))\n57\t        mask = ids == source[\"mask_id\"]\n58\t        if mask.any():\n59\t            crops.append(focus_crop(image, mask, mask_box(mask, margin=margin)))\n60\t    return crops\n61\t\n62\t\n63\tdef main() -> None:\n64\t    parser = argparse.ArgumentParser(description=__doc__)\n65\t    parser.add_argument(\"assets\", type=Path)\n66\t    parser.add_argument(\"masks_dir\", type=Path)\n67\t    parser.add_argument(\"out\", type=Path)\n68\t    parser.add_argument(\"--model\", required=True)\n69\t    parser.add_argument(\"--views\", type=int, default=3)\n70\t    parser.add_argument(\"--only-ids\", type=Path, help=\"JSON list of object IDs to label\")\n71\t    args = parser.parse_args()\n72\t\n73\t    assets = json.loads(args.assets.read_text())[\"assets\"]\n74\t    if args.only_ids:\n75\t        wanted = set(json.loads(args.only_ids.read_text()))\n76\t        assets = [asset for asset in assets if asset[\"object_id\"] in wanted]\n77\t\n78\t    start = time.perf_counter()\n79\t    labeler = VisionLabeler(args.model)\n80\t    load_seconds = time.perf_counter() - start\n81\t\n82\t    start = time.perf_counter()\n83\t    counts: dict[str, int] = {}\n84\t    args.out.parent.mkdir(parents=True, exist_ok=True)\n85\t    with args.out.open(\"w\") as file:\n86\t        for asset in assets:\n87\t            crops = object_crops(asset, args.masks_dir, args.views)\n88\t            if not crops:\n89\t                continue\n90\t            prompt = PROMPT.format(count=len(crops))\n91\t            answer, reply = labeler.label(crops, prompt)\n92\t            counts[answer[\"label\"]] = counts.get(answer[\"label\"], 0) + 1\n93\t            record = {\n94\t                \"object_id\": asset[\"object_id\"],\n95\t                \"sam_label\": asset[\"label\"],\n96\t                **answer,\n97\t                \"views_used\": len(crops),\n98\t                \"raw\": reply[:300],\n99\t            }\n100\t            file.write(json.dumps(record) + \"\\n\")\n101\t            file.flush()\n102\t    summary = {\n103\t        \"model\": args.model,\n104\t        \"views\": args.views,\n105\t        \"objects\": len(assets),\n106\t        \"load_seconds\": round(load_seconds, 1),\n107\t        \"seconds_per_object\": round((time.perf_counter() - start) / max(len(assets), 1), 2),\n108\t        \"peak_gpu_gb\": round(labeler.torch.cuda.max_memory_allocated() / 1e9, 1),\n109\t        \"labels\": dict(sorted(counts.items(), key=lambda pair: -pair[1])),\n110\t    }\n111\t    print(json.dumps(summary, indent=2))\n112\t\n113\t\n114\tif __name__ == \"__main__\":"}]},"uuid":"9c4bbab3-46a3-4fee-b17e-2631b8e60615","timestamp":"2026-11-07T04:09:09.983Z","toolUseResult":{"type":"text","file":{"filePath":"/home/viktor-trilar/Projects/Newbies/app/extract/label_objects.py","content":"from PIL import Image\n\nfrom app.extract.label_vlm import LABELS, VisionLabeler, focus_crop, mask_box\n\nPROMPT = f\"\"\"These images show one object in an industrial equipment room, from {{count}} different\nviews. The object is shown in full color, and everything around it is dimmed, for context.\n\nChoose the label that best fits it, from: {\", \".join(LABELS)}.\n\nHow to tell similar things apart:\n- pipe: a long straight or curved tube. Often insulated and white, with no moving parts.\n- pipe fitting: a short piece that joins pipes, such as an elbow, tee, or flange.\n- pump: a compact metal casing inline between two pipe flanges, usually with a motor attached.\n- motor: a ribbed or finned housing, usually with a cable box and fan cover.\n- valve: a body on a pipe, with a handwheel, lever, or small actuator on top.\n- tank: a large closed cylinder or vessel.\n- electrical cabinet: a flat metal box on a wall.\n- control panel: a box with visible buttons or dials.\n- other: a clear single object not in this list. Name it in \"reason\".\n- unknown: if you can't tell, if it looks like several things, or if it's only a fragment.\n\nLook at shape first. Only name equipment if you can see its typical parts.\n\nReply with JSON only:\n{{{{\"label\": \"...\", \"confidence\": 0.0, \"reason\": \"evidence, under 12 words\", \"visible_text\": \"\"}}}}\n\"visible_text\" is text you can actually read on the object, exactly as written, or \"\" if none.\"\"\"\n\n\ndef object_crops(\n    asset: dict, masks_dir: Path, views: int, margin: float = 0.35\n) -> list[Image.Image]:\n    \"\"\"Return focused crops of an object from its largest masks, at most one per view.\"\"\"\n    crops = []\n    used = set()\n    for source in asset[\"source_masks\"]:\n        if len(crops) >= views:\n            break\n        if source[\"view\"] in used:\n            continue\n        used.add(source[\"view\"])\n        image = np.array(Image.open(masks_dir / \"images\" / f\"{source['view']}.jpg\"))\n        ids = np.array(Image.open(masks_dir / \"object_mask\" / f\"{source['view']}.png\"))\n        mask = ids == source[\"mask_id\"]\n        if mask.any():\n            crops.append(focus_crop(image, mask, mask_box(mask, margin=margin)))\n    return crops\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"assets\", type=Path)\n    parser.add_argument(\"masks_dir\", type=Path)\n    parser.add_argument(\"out\", type=Path)\n    parser.add_argument(\"--model\", required=True)\n    parser.add_argument(\"--views\", type=int, default=3)\n    parser.add_argument(\"--only-ids\", type=Path, help=\"JSON list of object IDs to label\")\n    args = parser.parse_args()\n\n    assets = json.loads(args.assets.read_text())[\"assets\"]\n    if args.only_ids:\n        wanted = set(json.loads(args.only_ids.read_text()))\n        assets = [asset for asset in assets if asset[\"object_id\"] in wanted]\n\n    start = time.perf_counter()\n    labeler = VisionLabeler(args.model)\n    load_seconds = time.perf_counter() - start\n\n    start = time.perf_counter()\n    counts: dict[str, int] = {}\n    args.out.parent.mkdir(parents=True, exist_ok=True)\n    with args.out.open(\"w\") as file:\n        for asset in assets:\n            crops = object_crops(asset, args.masks_dir, args.views)\n            if not crops:\n                continue\n            prompt = PROMPT.format(count=len(crops))\n            answer, reply = labeler.label(crops, prompt)\n            counts[answer[\"label\"]] = counts.get(answer[\"label\"], 0) + 1\n            record = {\n                \"object_id\": asset[\"object_id\"],\n                \"sam_label\": asset[\"label\"],\n                **answer,\n                \"views_used\": len(crops),\n                \"raw\": reply[:300],\n            }\n            file.write(json.dumps(record) + \"\\n\")\n            file.flush()\n    summary = {\n        \"model\": args.model,\n        \"views\": args.views,\n        \"objects\": len(assets),\n        \"load_seconds\": round(load_seconds, 1),\n        \"seconds_per_object\": round((time.perf_counter() - start) / max(len(assets), 1), 2),\n        \"peak_gpu_gb\": round(labeler.torch.cuda.max_memory_allocated() / 1e9, 1),\n        \"labels\": dict(sorted(counts.items(), key=lambda pair: -pair[1])),\n    }\n    print(json.dumps(summary, indent=2))\n\n\nif __name__ == \"__main__\":","numLines":100,"startLine":15,"totalLines":116}},"sourceToolAssistantUUID":"4071bac6-6209-49b2-9eee-51d7caccac45","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"/home/viktor-trilar/Projects/Newbies","sessionId":"6293938d-e68f-4310-92b7-6bf722e3d028","version":"2.1.319","gitBranch":"viktor/demo-fixes","slug":"vast-jumping-lobster"}
