sys.path.insert(0,'/scratch/project_2020113/sinceai/code')\nfrom app.scene.load import read_splats\nfrom app.scene.render import to_tensors,render_view\nfrom app.scene.cameras import world_to_camera,intrinsics\nR='/scratch/project_2020113/sinceai/'; walked=np.load(R+'data/scene/splat_v2/walked.npy'); up=np.array([0,-1.,0]); W,H=640,360; K=intrinsics(W,H,75)\nscenes=[a.split('=') for a in sys.argv[2:]]\npicks=[int(x*len(walked)) for x in(.05,.3,.55,.8)]; shots=[]\nfor i in picks:\n    p=walked[i]; fw=walked[min(i+15,len(walked)-1)]-p; fw[1]=0; fw/=np.linalg.norm(fw)\n    shots+=[(p,fw,'on path'),(p,fw+np.array([0,.6,0]),'on path, down'),(p+up*.0+np.array([fw[2],0,-fw[0]])*.6,fw,'0.6 m off path')]\nsh=Image.new('RGB',(W*len(scenes),H*len(shots)))\nfor c,(n,path) in enumerate(scenes):\n    sc=to_tensors(read_splats(path),'cuda')\n    for r,(p,fw,t) in enumerate(shots):\n        img=render_view(sc,world_to_camera(p,fw/np.linalg.norm(fw),up),K,W,H)[0]; im=Image.fromarray((img*255).astype('u1')); ImageDraw.Draw(im).text((6,6),f'{n}: {t}',fill=(255,255,0)); sh.paste(im,(c*W,r*H))\nsh.save(sys.argv[1],quality=88); print('saved',sys.argv[1])\nEOF\ncat > \"$S/retrain.sbatch\" <<'EOF'\n#!/bin/bash\n#SBATCH --job-name=sinceai_v2b\n#SBATCH --account=project_2020113\n#SBATCH --partition=vizinteractive\n#SBATCH --nodes=1 --ntasks=1 --cpus-per-task=16 --mem=120G\n#SBATCH --gres=gpu:l40:1\n#SBATCH --time=02:00:00\n#SBATCH --output=/scratch/project_2020113/sinceai/logs/v2b-%j.out\nset -uo pipefail\nROOT=/scratch/project_2020113/sinceai; ENVS=/scratch/project_2020113/inspection; G=$ENVS/venv-3dgs/bin/python\nexport CUDA_HOME=$ENVS/cuda-home TORCH_CUDA_ARCH_LIST=8.9 PATH=$ENVS/cuda-home/bin:$ENVS/venv-3dgs/bin:$PATH OPENBLAS_NUM_THREADS=4\ncd $ROOT/code\n$ENVS/venv-l40/bin/python $ROOT/scripts/floor_seeds.py\n$G $ROOT/scripts/same_views.py $ROOT/runs/floor_v2/compare_valmet.jpg valmet=$ROOT/data/scene/equipment_room/clean.ply own=$ROOT/data/scene/splat_v2/clean.ply\nPYTHONPATH=$ROOT/co