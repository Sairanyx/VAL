ct')}\"\n        return CopilotResponse(\n            answer=f\"I've marked {label} and drawn the route to it.\",\n'''),\n])\npatch(\"app/bim/model.py\", [\n('''    title = f\"{tag}?\" if unsure else tag or label\n''', '''    title = f\"{tag}?\" if unsure else tag or asset.get(\"name\") or label\n'''),\n('''            \"Status\": asset.get(\"status\"),\n''', '''            \"Status\": asset.get(\"status\"),\n            \"OperatorName\": asset.get(\"name\"),\n            \"CopiedFrom\": asset.get(\"duplicated_from\"),\n'''),\n])\npatch(\"web/index.html\", [('''    <div id=\"info-head\"></div>\n''', '''    <div id=\"info-head\"></div>\n    <form id=\"rename-form\" hidden>\n      <input id=\"rename-input\" maxlength=\"40\" placeholder=\"Name\" autocomplete=\"off\">\n      <button type=\"submit\" class=\"primary\">Save</button>\n    </form>\n'''),\n('''      <button id=\"duplicate-object\">Duplicate</button>\n''', '''      <button id=\"rename-object\" hidden>Name it</button>\n      <button id=\"duplicate-object\">Duplicate</button>\n''')])\npatch(\"web/style.css\", [('''#delete-confirm { margin: 6px 0; }''', '''#rename-form {\n  display: flex;\n  gap: 6px;\n  margin-bottom: 8px;\n}\n#rename-form[hidden] { display: none; }\n#rename-input {\n  flex: 1;\n  min-width: 0;\n  min-height: 44px;\n  padding: 0 10px;\n  border: 1px solid #3a4652;\n  border-radius: 6px;\n  background: #0f1419;\n  color: #e5e7eb;\n  font-size: 16px;\n}\n#delete-confirm { margin: 6px 0; }''')])\npatch(\"web/main.js\", [\n('''function name(asset) {\n  const link = asset.mapping;\n  if (!link) return asset.label;\n''', '''function name(asset) {\n  const link = asset.mapping;\n  if (!link) return asset.name || asset.label;\n'''),\n('''  $(\"info-head\").innerHTML = `<h2>${name(a)}</h2><p class=\"sub\">${a.label} · ${urgent}${link}</p>`;\n''', '''  const origin = a.copied_name ? `copy of ${a.copied_name} · own ID ${a.object_id}` : link;\n  $(\"info-head\").replaceChildren();\n  const title = document.