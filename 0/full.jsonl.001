n  root.add(restPreview);\n  fillSelect(ui.label, LABELS);\n  fillSelect(ui.mobility, MOBILITY);\n  fillSelect(ui.restLabel, LABELS);\n  fillSelect(ui.restMobility, MOBILITY);\n''')\nt=t.replace('''const PREVIEW_COLOR = 0xf59e0b;\n''','''const PREVIEW_COLOR = 0xf59e0b;\nconst REST_COLOR = 0x38bdf8;\n''')\nt=t.replace('''  function drawProposal() {\n    const min = new THREE.Vector3(...state.proposal.bbox_min);\n    const max = new THREE.Vector3(...state.proposal.bbox_max);\n    const size = max.clone().sub(min);\n    preview.geometry.dispose();\n    preview.geometry = new THREE.EdgesGeometry(new THREE.BoxGeometry(size.x, size.y, size.z));\n    preview.position.copy(min).add(max).multiplyScalar(0.5);\n    preview.visible = true;\n    ui.config.textContent = JSON.stringify(config(), null, 1);\n  }\n''','''  function drawBox(lines, box) {\n    const min = new THREE.Vector3(...box.bbox_min);\n    const max = new THREE.Vector3(...box.bbox_max);\n    const size = max.clone().sub(min);\n    lines.geometry.dispose();\n    lines.geometry = new THREE.EdgesGeometry(new THREE.BoxGeometry(size.x, size.y, size.z));\n    lines.position.copy(min).add(max).multiplyScalar(0.5);\n    lines.visible = true;\n  }\n\n  function restConfig() {\n    const rest = state.rest;\n    return {\n      bbox_min: rest.bbox_min,\n      bbox_max: rest.bbox_max,\n      label: ui.restLabel.value,\n      label_confidence: rest.label_confidence,\n      label_source: ui.restLabel.value === rest.label ? rest.label_source : \"operator\",\n      mobility: ui.restMobility.value,\n      mobility_reason:\n        ui.restMobility.value === rest.mobility ? rest.mobility_reason : \"set by operator\",\n      reason: rest.reason,\n      visible_text: rest.visible_text,\n      possible_tag: rest.possible_tag,\n    };\n  }\n\n  function drawProposal() {\n    drawBox(preview, state.proposal);\n    if (state.rest) drawBox(restPreview, state.rest);\n    const shown = state.rest ? { selected: config(), rest: restConfig() } : config();\n    ui.config.textContent = JSON.stringify(shown, null, 1);\n  }\n''')\nt=t.replace('''    state.active = false;\n    state.proposal = null;\n    preview.visible = false;\n''','''    state.active = false;\n    state.proposal = null;\n    state.parent = null;\n    state.rest = null;\n    preview.visible = false;\n    restPreview.visible = false;\n    ui.restRow.hidden = true;\n    ui.title.textContent = \"Add object\";\n''')\nt=t.replace('''  // Rays from the camera through the selection's corners, in scene coordinates.''','''  function setRest(rest) {\n    state.rest = rest;\n    if (!LABELS.includes(rest.label)) {\n      LABELS.push(rest.label);\n      fillSelect(ui.restLabel, LABELS);\n    }\n    ui.restLabel.value = rest.label;\n    ui.restMobility.value = rest.mobility;\n    ui.restRow.hidden = false;\n    ui.title.textContent = \"Split object\";\n  }\n\n  // The rest of a split has no selection of its own, so take its place on screen from its box.\n  function screenRectangle(box) {\n    let left = 1;\n    let top = 1;\n    let right = 0;\n    let bottom = 0;\n    for (const x of [box.bbox_min[0], box.bbox_max[0]]) {\n      for (const y of [box.bbox_min[1], box.bbox_max[1]]) {\n        for (const z of [box.bbox_min[2], box.bbox_max[2]]) {\n          const point = root.localToWorld(new THREE.Vector3(x, y, z)).project(camera);\n          left = Math.min(left, (point.x + 1) / 2);\n          right = Math.max(right, (point.x + 1) / 2);\n          top = Math.min(top, (1 - point.y) / 2);\n          bottom = Math.max(bottom, (1 - point.y) / 2);\n        }\n      }\n    }\n    return [Math.max(left, 0), Math.max(top, 0), Math.min(right, 1), Math.min(bottom, 1)];\n  }\n\n  async function suggestRest(image) {\n    const [left, top, right, bottom] = screenRectangle(state.rest);\n    if (right <= left || bottom <= top) return;\n    try {\n      const response = await fetch(\"/api/objects/suggest\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ image, rectangle: [left, top, right, bottom] }),\n      });\n      if (!response.ok || !state.rest) return;\n      const suggestion = await response.json();\n      Object.assign(state.rest, suggestion);\n      setRest(state.rest);\n      drawProposal();\n    } catch {\n      // The operator can still choose: a suggestion is only ever a help.\n    }\n  }\n\n  // Rays from the camera through the selection's corners, in scene coordinates.''')\nt=t.replace('''      const response = await fetch(\"/api/objects/propose\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(body),\n      });\n      const reply = await response.json();\n      if (!response.ok) throw new Error(reply.detail ?? `Backend error ${response.status}`);\n      showProposal(reply);\n      onMessage(\"Check the orange box and the settings, then save\");\n    } catch (error) {\n      onMessage(`Couldn't add an object: ${error.message}`);\n    }\n''','''      const splitting = state.parent;\n      const address = splitting\n        ? `/api/objects/${encodeURIComponent(splitting.asset.object_id)}/split/propose`\n        : \"/api/objects/propose\";\n      const response = await fetch(address, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(body),\n      });\n      const reply = await response.json();\n      if (!response.ok) throw new Error(reply.detail ?? `Backend error ${response.status}`);\n      if (splitting) {\n        setRest(reply.rest);\n        showProposal({ ...reply.part, already_known: [] });\n        onMessage(\"Orange is what you selected, and blue is the rest. Check both, then save\");\n        suggestRest(image);\n      } else {\n        showProposal(reply);\n        onMessage(\"Check the orange box and the settings, then save\");\n      }\n    } catch (error) {\n      onMessage(`${state.parent ? \"Couldn't split it\" : \"Couldn't add an object\"}: ${error.message}`);\n    }\n''')\nt=t.replace('''  ui.label.onchange = drawProposal;\n  ui.mobility.onchange = drawProposal;\n''','''  ui.label.onchange = drawProposal;\n  ui.mobility.onchange = drawProposal;\n  ui.restLabel.onchange = drawProposal;\n  ui.restMobility.onchange = drawProposal;\n''')\nt=t.replace('''  ui.save.onclick = async () => {\n    const details = config();\n''','''  async function saveSplit() {\n    const parent = state.parent;\n    try {\n      const response = await fetch(\"/api/changes\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          op: \"split\",\n          object_id: parent.asset.object_id,\n          details: { parts: [config(), restConfig()] },\n        }),\n      });\n      const change = await response.json();\n      if (!response.ok) throw new Error(change.detail ?? `Backend error ${response.status}`);\n      const parts = await Promise.all(\n        change.parts.map(async (id) => (await fetch(`/api/assets/${encodeURIComponent(id)}`)).json()),\n      );\n      finish();\n      await onSplit(parent, parts);\n    } catch (error) {\n      onMessage(`Couldn't split it: ${error.message}`);\n    }\n  }\n\n  ui.save.onclick = async () => {\n    if (state.parent) {\n      await saveSplit();\n      return;\n    }\n    const details = config();\n''')\nt=t.replace('''    cancel: finish,\n''','''    // Split an object: the next selection picks out one part of it.\n    startSplit(parent) {\n      state.parent = parent;\n      state.active = true;\n      canvas.style.cursor = \"crosshair\";\n      onMessage(`Drag a box around one part of ${parent.asset.object_id}`);\n    },\n    cancel: finish,\n''')\nopen(p,'w').write(t)\n\np='web/index.html'; t=open(p).read()\nt=t.replace('''    <h2>Add object</h2>\n''','''    <h2 id=\"add-title\">Add object</h2>\n''')\nt=t.replace('''    <label>Can it move? <select id=\"add-mobility\"></select></label>\n''','''    <label>Can it move? <select id=\"add-mobility\"></select></label>\n    <div id=\"add-rest\" hidden>\n      <h3>The rest</h3>\n      <label>Type <select id=\"add-rest-label\"></select></label>\n      <label>Can it move? <select id=\"add-rest-mobility\"></select></label>\n    </div>\n''')\nt=t.replace('''    <button id=\"route-here\" hidden>Route here</button>\n''','''    <button id=\"route-here\" hidden>Route here</button>\n    <button id=\"split-object\" hidden>Split into two</button>\n''')\nopen(p,'w').write(t)\np='web/style.css'; t=open(p).read().rstrip('\\n')+'''\n\n#add-rest[hidden] {\n  display: none;\n}\n#add-rest h3 {\n  margin: 10px 0 0;\n  color: #38bdf8;\n  font-size: 13px;\n}\n'''\nopen(p,'w').write(t)\n\np='web/main.js'; t=open(p).read()\n# Solid faces that hide what's behind each frame.\nt=t.replace('''  const box = new THREE.LineSegments(\n    new THREE.EdgesGeometry(geom),\n    new THREE.LineBasicMaterial({ color: COLORS[kind(asset)] }),\n  );\n  box.position.copy(mid);\n  root.add(box);\n''','''  // Frames are drawn after the scan, so splats can't dim them. The invisible faces come first, and\n  // hide lines behind them: a frame's own back edges, and any frame further away.\n  const box = new THREE.LineSegments(\n    new THREE.EdgesGeometry(geom),\n    new THREE.LineBasicMaterial({ color: COLORS[kind(asset)], transparent: true }),\n  );\n  box.renderOrder = FRAME_ORDER + 1;\n  box.position.copy(mid);\n  const faces = new THREE.Mesh(geom, FRAME_FACES);\n  faces.renderOrder = FRAME_ORDER;\n  box.add(faces);\n  root.add(box);\n''')\nt=t.replace('''function resize() {''','''const FRAME_ORDER = 5;\nconst FRAME_FACES = new THREE.MeshBasicMaterial({\n  colorWrite: false,\n  transparent: true, // Drawn with the scan's pass, after it, so it can't punch holes in the scan.\n  polygonOffset: true, // Slightly behind a frame's own lines, so that they still show.\n  polygonOffsetFactor: 1,\n  polygonOffsetUnits: 1,\n});\n\nfunction resize() {''',1)\nt=t.replace('''  $(\"route-here\").hidden = !route;\n''','''  $(\"route-here\").hidden = !route;\n  $(\"split-object\").hidden = !route || Boolean(m);\n''')\nt=t.replace('''  onMessage: (message) => ($(\"status\").textContent = message),\n  onSaved: async (asset) => {''','''  onMessage: (message) => ($(\"status\").textContent = message),\n  onSplit: async (parent, parts) => {\n    hideObject(parent);\n    parent.splitAway = true;\n    for (const part of parts) {\n      addAsset(part);\n      objects.at(-1).addedByOperator = true;\n    }\n    selected = objects.at(-2);\n    const names = parts.map((part) => `${part.object_id} (${part.label})`).join(\" and \");\n    $(\"status\").textContent = `Split into ${names}, not confirmed`;\n    if (route?.state.target) await route.plan(route.state.target, route.state.start);\n  },\n  onSaved: async (asset) => {''')\nt=t.replace('''    frame: $(\"select-frame\"),\n''','''    frame: $(\"select-frame\"),\n    title: $(\"add-title\"),\n    restRow: $(\"add-rest\"),\n    restLabel: $(\"add-rest-label\"),\n    restMobility: $(\"add-rest-mobility\"),\n''')\nt=t.replace('''$(\"add-object\").onclick = () => adder.start();\n''','''$(\"add-object\").onclick = () => adder.start();\n$(\"split-object\").onclick = () => {\n  if (!selected) return;\n  $(\"info\").hidden = true;\n  adder.startSplit(selected);\n};\n\nfunction hideObject(object) {\n  object.gone = true;\n  object.box.visible = false;\n  object.pick.layers.disable(0);\n  object.label.style.display = \"none\";\n}\n''')\nt=t.replace('''  for (const object of objects) {\n    if (!object.addedByOperator) continue;\n    object.addedByOperator = false;\n    object.gone = true;\n    object.box.visible = false;\n    object.pick.layers.disable(0);\n    object.label.style.display = \"none\";\n  }\n''','''  for (const object of objects) {\n    if (object.addedByOperator) {\n      object.addedByOperator = false;\n      hideObject(object);\n    } else if (object.splitAway) {\n      // The backend's reset brings back whatever was split.\n      object.splitAway = false;\n      object.gone = false;\n      object.pick.layers.enable(0);\n    }\n  }\n''')\nt=t.replace('''  let changed = 0;\n  for (const asset of current) {''','''  let changed = 0;\n  const present = new Set(current.map((asset) => asset.object_id));\n  for (const object of objects) {\n    if (!present.has(object.asset.object_id)) {\n      hideObject(object);\n      object.splitAway = true;\n      changed += 1;\n    }\n  }\n  for (const asset of current) {''')\nopen(p,'w').write(t)\np='docs/USAGE.md'; t=open(p).read()\nt=t.replace('''## Ask the copilot\n''','''## Split an object that's really two things\n1. Tap the object, and press **Split into two**. Objects linked to a record can't be split.\n2. Drag a box around one part. Orange is what you selected, and blue is the rest.\n3. Check the type and whether each can move, then press **Save**. Both are marked \"new, unconfirmed\".\n\nThe parts move as outlines, not as the real scan. **Undo changes** brings the original back.\n\n## Ask the copilot\n''')\nt=t.replace('''Four objects move as the real scan: `obj-0067`, `obj-0021`, `obj-0008`, and `obj-0112`.''','''Three objects move as the real scan: `obj-0067`, `obj-0021`, and `obj-0112`.''')\nt=t.replace(\"Not one of the four objects, or no `PIECES=`\",\"Not one of the three objects, or no `PIECES=`\")\nopen(p,'w').write(t)\np='docs/PLAN.md'; t=open(p).read()\nt=t.replace(\"**Say this accurately:** four objects move as real splats\",\"**Say this accurately:** three objects move as real splats\")\nopen(p,'w').write(t)\nEOF\ngrep -n \"hideObject\\|function addAsset\" web/main.js | head -5 | cut -c1-60; sed -i 's/PIECES_OBJECTS ?= obj-0067 obj-0021 obj-0008 obj-0112/PIECES_OBJECTS ?= obj-0067 obj-0021 obj-0112/' Makefile; make lint 2>&1 | tail -1 | cut -c1-50; uv run --no-project --with numpy --with scipy --with pandas --with openpyxl --with pytest --with fastapi --